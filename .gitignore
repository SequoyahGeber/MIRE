# Godot 4+ specific ignores
.godot/*
!.godot/extension_list.cfg
/android/

# Editor-generated asset import sidecars; source assets and runtime GLTF loading are authoritative.
*.import

# Godot exports
export/

# Rendered steampipe build scripts (task 8.4) — steam_upload.sh regenerates these from
# tools/steam/templates/*.vdf.template + tools/steam/steam_build_config.sh on every run, so a
# committed one would just be a stale render nobody would notice going out of date.
tools/steam/generated/

# macOS
.DS_Store

# Agent session state (local, per-machine)
.agent/session
.agent/sessions.json

# Orchestration working state (D-036). Orders are regenerable with `agent order`, logs and locks are
# machine-local, and lanes.json holds this machine's auth paths and quota ledger.
.agent/orders/
.agent/locks/
.agent/logs/
.agent/lanes.json

# GodotSteam GDExtension — ~95 MB of per-platform binaries, reinstallable in one
# command. The pinned commit and the reinstall recipe are D-022 in docs/DECISIONS.md.
/addons/godotsteam/
tools/blender/__pycache__/
*.blend1

# Art audit contact sheets — one rendered PNG per asset, regenerated by the audit tool. Rendered PNGs
# are never byte-identical between runs (F-042), so committing them would put a fresh ~35 MB diff into
# permanent history every time the audit is re-run. The structured reports beside them are small and
# genuinely diffable, so those ARE committed.
# Depth-agnostic on purpose (F-143): the audit tool also writes per-audit subdirectories such as
# `assets/audit/a009/sheets/`, and a fixed one-level path silently missed them — 6.4 MB sat
# untracked-but-stageable. `**/` matches zero or more directories, so both shapes are covered.
assets/audit/**/sheets/
