[gd_resource type="Resource" script_class="PowerupDef" format=3]

[ext_resource type="Script" path="res://systems/powerups/powerup_def.gd" id="1_powerupdef"]

[resource]
script = ExtResource("1_powerupdef")
id = &"scab_feast"
display_name = "Scab Feast"
description = "Something in you feeds on what you put down, and closes you up while it eats. The same mercy Cauter Seal offers, routed through the rot instead of the fire — which matters only if you have already picked a side."
tags = Array[StringName]([&"Blood", &"Fungal"])
max_stacks = 5
modifiers = Dictionary[StringName, Vector2]({
&"on_kill_heal_hp": Vector2(1, 0)
})
