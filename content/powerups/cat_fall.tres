[gd_resource type="Resource" script_class="PowerupDef" format=3]

[ext_resource type="Script" path="res://systems/powerups/powerup_def.gd" id="1_powerupdef"]

[resource]
script = ExtResource("1_powerupdef")
id = &"cat_fall"
display_name = "Cat Fall"
description = "You still hit the ground. You just stop paying full price for it, and the routes that open up when a drop is only a drop are worth more than the health."
tags = Array[StringName]([&"Kinetic"])
max_stacks = 5
modifiers = Dictionary[StringName, Vector2]({
&"fall_damage_taken": Vector2(0, -0.15)
})
