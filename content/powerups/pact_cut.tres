[resource]
script = ExtResource("1_powerupdef")
id = &"pact_cut"
display_name = "Pact Cut"
description = "One shallow cut, kept open. You hit considerably harder and you have considerably less to lose — stack it deep and you are betting the whole run that the fight ends early."
