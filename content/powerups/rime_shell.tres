[gd_resource type="Resource" script_class="PowerupDef" format=3]

[ext_resource type="Script" path="res://systems/powerups/powerup_def.gd" id="1_powerupdef"]

[resource]
script = ExtResource("1_powerupdef")
id = &"rime_shell"
display_name = "Rime Shell"
description = "A thin hard skin of frost that reforms faster than anything out here can strip it. Sealed Veins does the same work through the blood; this is the patient version, and it does not cost you anything to keep."
tags = Array[StringName]([&"Cold"])
max_stacks = 5
modifiers = Dictionary[StringName, Vector2]({
&"damage_taken": Vector2(0, -0.05)
})
