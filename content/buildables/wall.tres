[ext_resource type="Script" path="res://systems/building/buildable_def.gd" id="1_buildabledef"]

[resource]
script = ExtResource("1_buildabledef")
id = &"wall_wood"
display_name = "Wooden Wall"
description = "Two metres of plank between you and whatever is out there. Snaps to the metre grid so a run of them actually lines up."
size = Vector3(2, 3, 0.25)
snap_step = 1.0
