[gd_resource type="Resource" script_class="UnlockDef" format=3]

[ext_resource type="Script" path="res://systems/unlocks/unlock_def.gd" id="1_deep_pocket"]

[resource]
script = ExtResource("1_deep_pocket")
id = &"unlock_deep_pocket"
category = &"powerup"
display_name = "Deep Pockets"
description = "Worked example for task 6.9's framework — DESIGN.md §4.6. Spends Salvage to mark the existing `deep_pocket` PowerupDef (content/powerups/deep_pocket.tres) as purchased. content/loot/bog.tres's own deep_pocket line now checks UnlockService.is_content_unlocked() before it can be rolled (F-173/D-111): a Bog Chest never drops it until the host who opened it has bought this unlock."
cost = 100
gates_id = &"deep_pocket"
