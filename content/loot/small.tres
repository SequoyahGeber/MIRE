[gd_resource type="Resource" script_class="LootTableDef" format=3]

[ext_resource type="Script" path="res://systems/loot/loot_table_def.gd" id="1_loottable"]
[ext_resource type="Script" path="res://systems/loot/loot_entry.gd" id="2_lootentry"]

[sub_resource type="Resource" id="Resource_log"]
script = ExtResource("2_lootentry")
item_id = &"log"
min_amount = 1
max_amount = 3
weight = 3.0

[sub_resource type="Resource" id="Resource_stone"]
script = ExtResource("2_lootentry")
item_id = &"stone"
min_amount = 1
max_amount = 2
weight = 3.0

[sub_resource type="Resource" id="Resource_iron"]
script = ExtResource("2_lootentry")
item_id = &"iron_ore"
min_amount = 1
max_amount = 1
weight = 1.0

[resource]
script = ExtResource("1_loottable")
id = &"small"
coin_min = 5
coin_max = 15
roll_count = 2
entries = Array[ExtResource("2_lootentry")]([SubResource("Resource_log"), SubResource("Resource_stone"), SubResource("Resource_iron")])
