[gd_resource type="Resource" script_class="RuleDef" format=3]

[ext_resource type="Script" path="res://systems/rules/rule_def.gd" id="1_mire_spread_multiplier"]

[resource]
script = ExtResource("1_mire_spread_multiplier")
id = &"mire_spread_multiplier"
display_name = "Mire spread multiplier"
type = 2
default_value = 1.0
min_value = 0.0
max_value = 20.0
description = "Scales how fast the Mire advances, on top of the per-Cycle escalation and the per-Wellspring-cap reduction. 1.0 is the authored rate: a front that moves 1.66 m/min, which crosses the island around Cycle 12 (about three hours). F-599 added this because that curve is correct for a full run and imperceptible in a two-hour session — raise it to make the Mire a real antagonist inside a playtest without retuning anything else. 0 freezes the Mire without disabling the grid, which is what you want while testing anything that is not the Mire."
