[gd_resource type="Resource" script_class="RuleDef" format=3]

[ext_resource type="Script" path="res://systems/rules/rule_def.gd" id="1_mire_spread_multiplier"]

[resource]
script = ExtResource("1_mire_spread_multiplier")
id = &"mire_spread_multiplier"
display_name = "Mire spread multiplier"
type = 2
default_value = 2.0
min_value = 0.0
max_value = 20.0
description = "Scales how fast the Mire advances, on top of the per-Cycle escalation and the per-Wellspring-cap reduction. 2.0 is twice the authored rate. 1.0 is the authored one: a front that moves 1.66 m/min, which crosses the island around Cycle 12 (about three hours). F-599 added this because that curve is correct for a full run and imperceptible in a two-hour session — Measured with tools/blight_timeline_check.gd, the Mire reaches the island origin at 65 min at 1.0x and 34 min at 2.0x, and F-602 measures a real shore spawn as 296-383 m further out again — so at 1.0x a two-hour co-op session ends before the Mire ever threatens camp, which is why it read as doing nothing. 2.0 is deliberately conservative: it halves the wait without touching the shape of the curve, and every figure is an upper bound because the per-Cycle +15% escalation compounds on top. Raise it for a shorter session, drop it back to 1.0 for a full-length run. 0 freezes the Mire without disabling the grid, which is what you want while testing anything that is not the Mire."
