[gd_resource type="Resource" script_class="RuleDef" format=3]

[ext_resource type="Script" path="res://systems/rules/rule_def.gd" id="1_ambient_enemy_population"]

[resource]
script = ExtResource("1_ambient_enemy_population")
id = &"ambient_enemy_population"
display_name = "Ambient enemy population"
type = 1
default_value = 18.0
min_value = 0.0
max_value = 64.0
description = "How many enemies the daytime field keeps alive across the whole island. F-599 raised the default from 4 to 18: 4 bodies over 1.09 km2 is one enemy per 273,000 m2, which is why a run felt empty. 0 still empties the world without disabling the spawner, which is what you want while testing anything that is not combat."
