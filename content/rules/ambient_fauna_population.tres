[gd_resource type="Resource" script_class="RuleDef" format=3]

[ext_resource type="Script" path="res://systems/rules/rule_def.gd" id="1_ambient_fauna_population"]

[resource]
script = ExtResource("1_ambient_fauna_population")
id = &"ambient_fauna_population"
display_name = "Ambient fauna population"
type = 1
default_value = 24.0
min_value = 0.0
max_value = 200.0
description = "How many animals the world keeps alive, counted as individuals rather than as herds. 0 empties the island of fauna without disabling the service, which is what you want while testing anything that is not hunting. Mirrors ambient_enemy_population deliberately — same shape, same tuning story."
