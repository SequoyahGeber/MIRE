[gd_resource type="Resource" script_class="CycleModifierDef" format=3]

[ext_resource type="Script" path="res://systems/cycle/cycle_modifier_def.gd" id="1_drought"]

[resource]
script = ExtResource("1_drought")
id = &"drought"
display_name = "Drought"
description = "Resource nodes yield half until the next Wellspring cap. DESIGN.md §5.1's own example: the safe routine of chopping and mining stops paying, so a run that has been coasting on ambient harvesting has to go finish a Wellspring instead. F-245: Harvestable checks CycleModifierService.has_modifier(&\"drought\") against its own yield_amount, and CycleModifierService clears the effect off EventBus.wellspring_capped — the same event Salvage already subscribes to (ARCHITECTURE.md §2.2's Wellspring row)."
min_cycle = 3
base_weight = 1.0
weight_growth_per_cycle = 0.0
tags = Array[StringName]([&"scarcity"])
incompatible_tags = Array[StringName]([])
incompatible_with = Array[StringName]([])
