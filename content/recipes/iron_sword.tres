[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://systems/crafting/recipe_ingredient.gd" id="1_ing"]
[ext_resource type="Resource" path="res://content/items/log.tres" id="2_log"]
[ext_resource type="Resource" path="res://content/items/iron_ingot.tres" id="3_ingot"]
[ext_resource type="Resource" path="res://content/items/iron_sword.tres" id="4_out"]
[ext_resource type="Script" path="res://systems/crafting/recipe_def.gd" id="5_recipe"]

[sub_resource type="Resource" id="Resource_log"]
script = ExtResource("1_ing")
item = ExtResource("2_log")
count = 1

[sub_resource type="Resource" id="Resource_ingot"]
script = ExtResource("1_ing")
item = ExtResource("3_ingot")
count = 4

[resource]
script = ExtResource("5_recipe")
id = &"iron_sword"
display_name = "Iron Sword"
station = &"anvil"
inputs = Array[ExtResource("1_ing")]([SubResource("Resource_log"), SubResource("Resource_ingot")])
output_item = ExtResource("4_out")
