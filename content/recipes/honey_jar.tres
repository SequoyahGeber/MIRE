[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://systems/crafting/recipe_ingredient.gd" id="1_ing"]
[ext_resource type="Resource" path="res://content/items/honey.tres" id="2_honey"]
[ext_resource type="Resource" path="res://content/items/clay.tres" id="3_clay"]
[ext_resource type="Resource" path="res://content/items/honey_jar.tres" id="4_out"]
[ext_resource type="Script" path="res://systems/crafting/recipe_def.gd" id="5_recipe"]

[sub_resource type="Resource" id="Resource_honey"]
script = ExtResource("1_ing")
item = ExtResource("2_honey")
count = 2

[sub_resource type="Resource" id="Resource_clay"]
script = ExtResource("1_ing")
item = ExtResource("3_clay")
count = 1

[resource]
script = ExtResource("5_recipe")
id = &"honey_jar"
display_name = "Honey Jar"
station = &"campfire"
inputs = Array[ExtResource("1_ing")]([SubResource("Resource_honey"), SubResource("Resource_clay")])
output_item = ExtResource("4_out")
output_count = 1
craft_time_sec = 10.0
