[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://systems/crafting/recipe_ingredient.gd" id="1_ing"]
[ext_resource type="Resource" path="res://content/items/branch.tres" id="2_branch"]
[ext_resource type="Resource" path="res://content/items/fibre_bundle.tres" id="3_fibre"]
[ext_resource type="Resource" path="res://content/items/wooden_axe.tres" id="4_out"]
[ext_resource type="Script" path="res://systems/crafting/recipe_def.gd" id="5_recipe"]

[sub_resource type="Resource" id="Resource_branch"]
script = ExtResource("1_ing")
item = ExtResource("2_branch")
count = 4

[sub_resource type="Resource" id="Resource_fibre"]
script = ExtResource("1_ing")
item = ExtResource("3_fibre")
count = 2

[resource]
script = ExtResource("5_recipe")
id = &"wooden_axe"
display_name = "Wooden Axe"
inputs = Array[ExtResource("1_ing")]([SubResource("Resource_branch"), SubResource("Resource_fibre")])
output_item = ExtResource("4_out")
