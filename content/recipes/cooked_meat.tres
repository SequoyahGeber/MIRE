[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://systems/crafting/recipe_ingredient.gd" id="1_ing"]
[ext_resource type="Resource" path="res://content/items/raw_meat.tres" id="2_raw_meat"]
[ext_resource type="Resource" path="res://content/items/cooked_meat.tres" id="3_out"]
[ext_resource type="Script" path="res://systems/crafting/recipe_def.gd" id="4_recipe"]

[sub_resource type="Resource" id="Resource_raw_meat"]
script = ExtResource("1_ing")
item = ExtResource("2_raw_meat")
count = 1

[resource]
script = ExtResource("4_recipe")
id = &"cooked_meat"
display_name = "Cooked Meat"
station = &"campfire"
inputs = Array[ExtResource("1_ing")]([SubResource("Resource_raw_meat")])
