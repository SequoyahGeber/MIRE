[ext_resource type="Resource" path="res://content/items/fibre_bundle.tres" id="2_fibre"]
[ext_resource type="Resource" path="res://content/items/sling.tres" id="3_out"]
[ext_resource type="Script" path="res://systems/crafting/recipe_def.gd" id="4_recipe"]

[sub_resource type="Resource" id="Resource_fibre"]
