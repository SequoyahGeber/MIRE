; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MIRE"
run/main_scene="res://levels/playtest_hollow.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DebugOverlay="*res://autoload/debug_overlay.gd"
DebugConsole="*res://autoload/debug_console.gd"
Registry="*res://autoload/registry.gd"
NetTransport="*res://autoload/net_transport.gd"
NetSession="*res://core/net/net_session.gd"
DevLaunch="*res://core/dev/dev_launch.gd"
SteamLobby="*res://autoload/steam_lobby.gd"
PlayerNet="*res://autoload/player_net.gd"
NetDebugPanel="*res://ui/debug/net_debug_panel.gd"
NetInterp="*res://autoload/net_interp.gd"
HarvestWorld="*res://autoload/harvest_world.gd"
InventoryService="*res://autoload/inventory_service.gd"
InventoryUI="*res://ui/inventory/inventory_ui.gd"
CraftingService="*res://autoload/crafting_service.gd"
CraftingUI="*res://ui/crafting/crafting_ui.gd"
CombatService="*res://autoload/combat_service.gd"
EnemyWorld="*res://autoload/enemy_world.gd"
DevLoadout="*res://core/dev/dev_loadout.gd"
PlayerHealth="*res://systems/health/player_health.gd"
DayNight="*res://systems/environment/day_night.gd"
VitalsHud="*res://ui/hud/vitals_hud.gd"

