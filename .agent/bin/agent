#!/usr/bin/env python3
"""
agent — multi-agent coordination for MIRE.

Shared state so Claude Code, Codex, and the human can hand work off cleanly.
State lives in .agent/state.json; humans and agents read .agent/BOARD.md.

Deliberately small and dependency-free. If it annoys you, edit it.
"""

import binascii
import contextlib
import fcntl
import glob
import hashlib
import io
import json
import os
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
AGENT_DIR = os.path.join(ROOT, ".agent")
STATE = os.path.join(AGENT_DIR, "state.json")
BOARD = os.path.join(AGENT_DIR, "BOARD.md")
JOURNAL = os.path.join(AGENT_DIR, "JOURNAL.md")
SESSION = os.path.join(AGENT_DIR, "session")
SESSIONS = os.path.join(AGENT_DIR, "sessions.json")
ROADMAP = os.path.join(ROOT, "docs", "ROADMAP.md")
# Orchestration (D-036): the director prepares orders here, lanes execute them, locks keep three
# concurrent lanes from colliding on the two things they genuinely share.
ORDERS = os.path.join(AGENT_DIR, "orders")
LOCKS = os.path.join(AGENT_DIR, "locks")
SILENT_HANG_SECONDS = 45        # silence this long AFTER a script error is F-104, not slowness
LANE_BIN = os.path.join(AGENT_DIR, "bin", "lane")

EX_LANE_BUSY = 75               # lane run's "already running" — see .agent/bin/lane
BUSY_WAIT_LIMIT = 2 * 3600      # a lane run is capped at an hour; wait past that and it is wedged
MAX_BUSY_WAITS = 3              # per task, so a wedged lane cannot spin the queue forever
LANES_FILE = os.path.join(AGENT_DIR, "lanes.json")
PROJECT_GODOT = os.path.join(ROOT, "project.godot")

STALE_HOURS = 12

# Godot-authored files require an exact claim and a closed editor (D-031).
EDITOR_GUARDED_SUFFIXES = (".tscn", ".tres", ".import", ".godot")
EDITOR_GUARDED_PATHS = ("project.godot", "export_presets.cfg")
# F-051/F-067: registering an autoload is the ONE edit to project.godot that needs no claim, because
# `agent autoload` writes it append-only (D-019) and claiming the file would serialise every
# autoload-producing task against every other one. The hook has to recognise that exact shape, or the
# sanctioned path dead-ends in a blocked commit and everyone learns to reach for --no-verify — which
# also switches off the closed-editor check D-031 actually cares about.
AUTOLOAD_LINE_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*="\*?res://[^"]+"$')
# Always safe for anyone to edit.
FREE_PREFIXES = ("docs/", ".agent/", "CLAUDE.md", "AGENTS.md", "README.md", ".gitignore")
# — except these. F-081: `.agent/` is claim-free because it is coordination state nobody authors by
# hand, but `.agent/bin/` sits under the same prefix and is the harness itself: the code every lane,
# every hook and every check shells out to. It is source, and it follows the rule every other source
# follows — an exact claim, held by the task that edits it.
UNFREE_PREFIXES = (".agent/bin/",)
# The harness-generated coordination files. Every task legitimately updates them and nobody claims
# them, so `ship` carries them for whichever task commits next. F-081: this is an allowlist and not
# a `.agent/` glob, because the glob also matched `.agent/bin/` — on 2026-08-18 an unrelated
# content task's ship (882993d) committed the director's half-finished harness edits under its own
# name and message. A newly generated file has to be named here to be carried; one that is not
# shows up in ship's "left alone" list, which is a visible miss rather than a silent theft.
COORDINATION_PATHS = (".agent/BOARD.md", ".agent/JOURNAL.md", ".agent/state.json")
# Engine-generated sidecars. Godot writes .uid files next to every script; they are not authored
# by anyone and claiming them would be noise.
GENERATED_SUFFIXES = (".uid",)

C = {
    "b": "\033[1m", "dim": "\033[2m", "r": "\033[31m", "g": "\033[32m",
    "y": "\033[33m", "c": "\033[36m", "x": "\033[0m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}


# ---------------------------------------------------------------- state io

def now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def age_hours(iso):
    try:
        then = datetime.fromisoformat(iso)
    except ValueError:
        return 0.0
    return (datetime.now(timezone.utc) - then).total_seconds() / 3600.0


def load():
    if not os.path.exists(STATE):
        return {"version": 1, "tasks": {}, "in_flight": {}, "claims": {}}
    with open(STATE) as f:
        return json.load(f)


RECENT_GRACE_HOURS = 6


def save(st):
    os.makedirs(AGENT_DIR, exist_ok=True)
    recent = st.get("recent")
    if recent:
        st["recent"] = {f: d for f, d in recent.items()
                        if age_hours(d.get("at", now())) < 24}
    with open(STATE, "w") as f:
        json.dump(st, f, indent=2, sort_keys=True)
        f.write("\n")
    render_board(st)


# ---------------------------------------------------------------- identity

# Nobody should have to name an agent. The old scheme — one name in .agent/session, overridden by
# MIRE_AGENT on every single command — put that chore on Sequoyah and failed silently when skipped
# (F-007): a second chat overwrote the file and its claims landed under the first chat's name.
#
# Identity is now derived from the chat itself. Every tool call from one chat carries the same
# session id in its environment, and a git hook inherits it too, so the name is stable across a whole
# session including commits, and two chats cannot collide because their tokens differ.
SESSION_ENV_KEYS = (
    "MIRE_SESSION",             # manual override, mostly for testing
    "CLAUDE_CODE_SESSION_ID",   # Claude Code, one per chat
    "CODEX_SESSION_ID",         # Codex, if it sets one
    "CODEX_THREAD_ID",
    "TERM_SESSION_ID",          # a human's terminal tab
)

# Short, unlike each other at a glance, and not words that appear in this codebase — a name has to be
# scannable in a board full of file paths.
AUTO_NAMES = (
    "ash", "bram", "cinder", "dusk", "ember", "flint", "gale", "hollow", "ivy", "kiln",
    "larch", "moss", "nettle", "onyx", "pike", "quill", "reed", "slate", "tine", "vane",
    "wick", "yarrow", "birch", "coil",
)

SESSION_KEEP_DAYS = 14


def _session_token():
    for key in SESSION_ENV_KEYS:
        value = os.environ.get(key, "").strip()
        if value:
            return "%s:%s" % (key, value)
    return None


def _load_sessions():
    try:
        with open(SESSIONS) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (IOError, ValueError):
        return {}


def _save_sessions(data):
    # Machine-local and gitignored: this maps chat ids to names, which means nothing on another
    # machine and would produce a diff on every command if it were tracked.
    tmp = SESSIONS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, SESSIONS)


# One write a minute at most. whoami() runs on every single command, including the pre-commit
# hook, and sessions.json is rewritten whole each time.
SESSION_HEARTBEAT_HOURS = 60.0 / 3600.0


def _touch_session(token, sessions):
    """Record that this chat is still alive, so `reap` can tell an abandoned session from a busy one.

    A lane has a pid in lanes.json to check; a chat had nothing at all — its `at` is the moment it
    registered and never moved — so claims left behind by a dead chat sat forever and blocked every
    task that needed those files (F-186).

    Deliberately takes no lock. This runs on every command with dozens of chats live, and a lock here
    serialises all of them behind one file — the first version did exactly that and, with a contended
    lock, spent 10s per command before dying. A missed beat is harmless: the next command re-beats
    within the minute, and `reap` only ever *reports* on this by default. So re-read immediately
    before the atomic replace, which narrows the lost-update window to the write itself, and accept
    that window rather than pay for it on every invocation."""
    rec = sessions.get(token)
    if not isinstance(rec, dict):
        return
    if age_hours(rec.get("seen") or rec.get("at", "")) < SESSION_HEARTBEAT_HOURS:
        return
    try:
        fresh = _load_sessions()
        target = fresh.get(token)
        if not isinstance(target, dict):
            return
        target["seen"] = now()
        _save_sessions(fresh)
        rec["seen"] = target["seen"]
    except (IOError, OSError, ValueError, TypeError):
        pass


def _beat():
    """Heartbeat for this invocation. Silent and best-effort by design: a lane (MIRE_AGENT, no
    token) or an unregistered shell simply has nothing to record.

    Catches BaseException on purpose. This runs before every single command, so anything it raises
    would take down a command that has nothing to do with it — and `die()` raises SystemExit, which
    an `except Exception` would let straight through."""
    try:
        token = whoami_token()
        if not token:
            return
        sessions = _load_sessions()
        if token in sessions:
            _touch_session(token, sessions)
    except BaseException:
        pass


def _prune_sessions(data):
    fresh = {}
    for token, rec in data.items():
        if isinstance(rec, dict) and age_hours(rec.get("at", "")) < SESSION_KEEP_DAYS * 24:
            fresh[token] = rec
    return fresh


def _auto_name(token, taken):
    """Deterministic from the token, so the same chat gets the same name every call — including from
    a git hook, which is a different process with the same environment. crc32, not hash(): Python
    randomizes string hashing per process, which would hand one chat a new name every command."""
    start = binascii.crc32(token.encode()) % len(AUTO_NAMES)
    for offset in range(len(AUTO_NAMES)):
        candidate = AUTO_NAMES[(start + offset) % len(AUTO_NAMES)]
        if candidate not in taken:
            return candidate
    # Pool exhausted. The suffix has to be wide and token-derived, NOT the pool index: `start` has
    # only len(AUTO_NAMES) values, so the old `AUTO_NAMES[start] + str(start)` collapsed every chat
    # sharing a base name onto one identical string. Identity is exactly what `claim` and the
    # pre-commit `check` compare, so two concurrent sessions that collided stopped being able to see
    # each other's claims and the guard failed open (F-145).
    # Still a pure function of the token, and deliberately does not consult `taken`: a git hook is a
    # separate process that must derive the same name later, when `taken` has grown.
    return "%s%06x" % (AUTO_NAMES[start], binascii.crc32(token.encode()) & 0xFFFFFF)


def _register(token, name):
    data = _prune_sessions(_load_sessions())
    data[token] = {"name": name, "at": now()}
    _save_sessions(data)
    return name


def whoami(required=True, assign=True):
    """Resolve this chat's agent name, assigning one on first use.

    Order: an explicit MIRE_AGENT, then this chat's registered name, then the legacy single-name
    file (a human's terminal, or a shell with no session id at all), then a fresh auto-name."""
    env_name = os.environ.get("MIRE_AGENT", "").strip().lower()
    if env_name:
        return env_name

    token = _session_token()
    sessions = _load_sessions()
    if token and token in sessions:
        _touch_session(token, sessions)
        return sessions[token]["name"]

    legacy = ""
    if os.path.exists(SESSION):
        legacy = open(SESSION).read().strip()

    if token and assign:
        # A name already in use by another live chat is not reusable — that is the collision the
        # whole scheme exists to prevent.
        taken = {rec["name"] for rec in _prune_sessions(sessions).values()
                 if isinstance(rec, dict)}
        taken.add(legacy)
        return _register(token, _auto_name(token, taken))

    if legacy:
        return legacy
    if required:
        die("no session id in the environment and no name set.\n"
            "  Run 'agent start' (it will name you), or set MIRE_AGENT=<name>.")
    return None


def whoami_token():
    """This chat's session token, or None for a lane (MIRE_AGENT) or a shell with no session id.

    A lane's name is fixed and unique by construction, so it needs no token to disambiguate.
    Auto-named chats are the ones that can collide (F-145: two different chats assigned the same
    name from AUTO_NAMES) — this is what lets `_is_mine` tell them apart once that happens."""
    if os.environ.get("MIRE_AGENT", "").strip():
        return None
    return _session_token()


def _is_mine(record, me, me_token):
    """True if a claim/in-flight/recent record belongs to this session (F-147).

    F-145 fixed new auto-names from colliding, but did nothing for identities that already had —
    an old claim's `agent` field is indistinguishable from a same-named live session by name alone.
    Prefer the session token when both the record and this session have one; fall back to the name
    for lane agents (no token by design) and for records written before this field existed."""
    tok = record.get("token")
    if tok and me_token:
        return tok == me_token
    return record.get("agent") == me


def die(msg):
    print("%s✗ %s%s" % (C["r"], msg, C["x"]))
    sys.exit(1)


def ok(msg):
    print("%s✓%s %s" % (C["g"], C["x"], msg))


def task_sort_key(tid):
    if _is_finding(tid):
        # After every roadmap task, in filed order. Findings are work, but they are not the
        # milestone plan, and sorting them into it would reorder the plan every time one is filed.
        try:
            return (1000, int(tid.split("-")[1]))
        except (IndexError, ValueError):
            return (1000, 999)
    try:
        a, b = tid.split(".")
        return (int(a), int(b))
    except ValueError:
        return (999, 999)


# ---------------------------------------------------------------- findings as work (F-015)

# Findings are the work most likely to happen BETWEEN roadmap tasks, and until F-015 they had no
# claimable id at all — so fixing one always meant editing unclaimed files and being warned at for
# it. A warning that fires during correct work is how agents learn to ignore it. So an F-number is
# a task id everywhere a task id is accepted: claim, brief, note, done, handoff, drop, ship.
FINDINGS_MILESTONE = "Findings"


def _is_finding(tid):
    return tid.upper().startswith("F-")


def _norm_id(tid):
    return tid.upper() if _is_finding(tid) else tid


def _sync_findings(st):
    """Mirror docs/FINDINGS.md's open section into tasks. Same shape as cmd_sync's roadmap pass:
    adds and refreshes titles, and never downgrades a status — but a finding that has LEFT '## Open'
    while still marked todo gets marked done (F-049). FINDINGS.md is the source of truth for what is
    open; before this, a finding resolved without `agent done` (F-027 sat that way for a day) stayed
    on the board as claimable work forever, and once a director routes off the board that is a
    dispatch waiting to happen. Journal entries are append-only and unaffected by status."""
    added = 0
    open_ids = set()
    for fid, title in _open_findings():
        open_ids.add(fid)
        title = title or fid
        if fid in st["tasks"]:
            st["tasks"][fid]["title"] = title
        else:
            st["tasks"][fid] = {
                "title": title, "tier": "F", "est": "—",
                "milestone": FINDINGS_MILESTONE, "status": "todo",
            }
            added += 1
    for fid, t in st["tasks"].items():
        if t.get("milestone") != FINDINGS_MILESTONE:
            continue
        if t.get("status") == "todo" and fid not in open_ids:
            t["status"] = "done"
        # The reverse, narrowly (F-131). The rule above is an *inference* — "it left the doc, so
        # somebody must have fixed it" — and it was one-way, so a transient error in a markdown file
        # became a permanent state change with no way back. That is not hypothetical: F-112's
        # heading was accidentally overwritten by an unrelated commit (89fea39), the next sync
        # inferred it closed, a later task restored the heading, and the status stayed `done`
        # forever. It sat in the board's Done row while `brief` still offered it as work, so no
        # director would ever dispatch a real, unwritten check.
        #
        # `done_at` is what separates the inference from a fact: every real `agent done` stamps it,
        # and this rule never does. So a finding that is back under '## Open' with no `done_at` was
        # closed by nobody, and the source of truth F-049 already defers to says it is open. Restore
        # it. A finding an agent actually closed is untouched — it keeps its `done_at`, and moving it
        # out of '## Open' stays a human judgement (`agent reopen` is the verb for changing it).
        if t.get("status") == "done" and not t.get("done_at") and fid in open_ids:
            t["status"] = "todo"
    return added


def _require_task(st, tid, verb="that"):
    """Resolve a task id, syncing findings on demand so an F-number never has to be pre-registered.
    Returns the canonical id; exits with a message that names the right file otherwise."""
    tid = _norm_id(tid)
    if tid in st["tasks"]:
        return tid
    if _is_finding(tid):
        # Save unconditionally: the sync's return value counts only NEW findings, and F-131's heal
        # changes a status without adding one. Conditioning the save on the count dropped it.
        _sync_findings(st)
        save(st)
        if tid in st["tasks"]:
            return tid
        die("unknown finding %s — it is not under '## Open' in docs/FINDINGS.md.\n"
            "  A resolved finding is not claimable; file a new one if there is more to do." % tid)
    die("unknown task %s — run 'agent sync' or check docs/ROADMAP.md.\n"
        "  Fixing a finding? Use its F-number directly: agent %s F-013" % (tid, verb))


# ---------------------------------------------------------------- roadmap sync

def cmd_sync(args):
    """Parse docs/ROADMAP.md task tables into state. Safe to re-run — never
    overwrites status, only adds new tasks and refreshes titles."""
    if not os.path.exists(ROADMAP):
        die("docs/ROADMAP.md not found")

    st = load()
    milestone = "?"
    added = updated = 0

    for line in open(ROADMAP):
        line = line.strip()
        if line.startswith("## M"):
            milestone = line[3:].split("·")[0].strip()
            continue
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) < 4:
            continue
        tid = cells[0]
        if not tid or not tid[0].isdigit() or "." not in tid:
            continue
        title = cells[1].replace("**", "")
        tier = cells[2]
        est = cells[3]
        if tid in st["tasks"]:
            t = st["tasks"][tid]
            if t.get("title") != title or t.get("tier") != tier:
                t.update({"title": title, "tier": tier, "est": est, "milestone": milestone})
                updated += 1
        else:
            st["tasks"][tid] = {
                "title": title, "tier": tier, "est": est,
                "milestone": milestone, "status": "todo",
            }
            added += 1

    findings = _sync_findings(st)
    save(st)
    ok("roadmap synced — %d new, %d updated, %d total" % (added, updated, len(st["tasks"])))
    if findings:
        print("  %s+%d open finding(s) from docs/FINDINGS.md, claimable by F-number%s"
              % (C["dim"], findings, C["x"]))


# ---------------------------------------------------------------- session

def cmd_start(args):
    """`agent start` takes no argument now. A name is derived from the chat's own session id, so
    parallel agents get distinct names with nobody having to think about it."""
    token = _session_token()
    if args:
        # An explicit name still works — a human wanting to be 'sequoyah' on the board, or a script.
        name = args[0].strip().lower()
        if token:
            _register(token, name)
        else:
            with open(SESSION, "w") as f:
                f.write(name + "\n")
    else:
        if not token and not os.environ.get("MIRE_AGENT"):
            die("no session id in this environment, so a name cannot be derived.\n"
                "  Run:  agent start <your-name>")
        name = whoami()
    st = load()
    # The board a session starts from must reflect FINDINGS.md as it is NOW — new findings filed
    # since the last sync, and any resolved out-of-band, both surface here (F-049).
    _sync_findings(st)
    save(st)

    print("\n%s%s session started%s\n" % (C["b"], name, C["x"]))
    if name not in ("sequoyah", "human"):
        print("  %sYou may edit Godot files under exact claims, but only while Godot is closed (D-031).%s"
              % (C["dim"], C["x"]))
    if os.environ.get("MIRE_AGENT", "").strip().lower() not in ("", name):
        print("  %s⚠ MIRE_AGENT=%s is set and overrides this — you are acting as '%s'.%s"
              % (C["y"], os.environ["MIRE_AGENT"], os.environ["MIRE_AGENT"].strip().lower(), C["x"]))
    elif token:
        print("  %sName derived from this chat's session id — it is yours for the whole session,"
              " commits included. No MIRE_AGENT prefix needed.%s" % (C["dim"], C["x"]))
    _print_board(st, focus=name)
    _print_stale(st)
    _print_findings_drift(st)
    _print_git()
    print("  %sGiven only a task id? That is enough:%s  agent brief <task-id>" % (C["dim"], C["x"]))
    print("  %sClaim before you edit:%s  agent claim <task-id> <files...>\n" % (C["dim"], C["x"]))


def _print_git():
    try:
        out = subprocess.run(["git", "status", "--porcelain"], cwd=ROOT,
                             capture_output=True, text=True).stdout.strip()
        log = subprocess.run(["git", "log", "--oneline", "-5"], cwd=ROOT,
                             capture_output=True, text=True).stdout.strip()
    except Exception:
        return
    print("%sRecent commits%s" % (C["b"], C["x"]))
    for l in log.splitlines():
        print("  %s" % l)
    if out:
        n = len(out.splitlines())
        print("\n  %s⚠ %d uncommitted file(s) — someone stopped mid-task%s" % (C["y"], n, C["x"]))
    print()


def _findings_drift(st):
    """F-071: `docs/FINDINGS.md` and `state.json` are two records of the same fact, and they drift.

    A finding closed with `agent done` but never moved out of '## Open' stays *done* in state and
    *open* in the doc. The two readers then disagree in opposite directions: `board` lists findings
    from state, so it hides it; `brief` lists them from the doc, so it advertises it as claimable
    work. Eight had drifted that way at once — a quarter of what `brief` called the queue was
    already finished, and claiming one only failed because state happened to disagree.

    Neither reader is wrong on its own, so this does not pick a winner: the doc is the source of
    truth for what is open (F-049), but only a human or an agent who knows what was actually fixed
    can write the resolution note that makes the move meaningful. Printing the disagreement is the
    part a tool can do.

    **F-131 narrowed what is left here.** The half of this that needed no judgement — a finding
    marked done with no `done_at`, i.e. closed by `_sync_findings()`'s inference rather than by
    anyone — now heals itself in `_sync_findings()`, so it never reaches this warning. What still
    prints is the half that genuinely needs a reader: a finding an agent really did run `agent done`
    on, which is still open in the doc. That has two legitimate resolutions and the warning names
    both, because assuming the first one was wrong on both findings it was firing on."""
    done_ids = {fid for fid, t in st["tasks"].items()
                if t.get("milestone") == FINDINGS_MILESTONE and t.get("status") == "done"}
    return sorted({fid for fid, _ in _open_findings() if fid in done_ids})


def _duplicate_findings():
    """F-071/F-058: F-numbers are not unique. `docs/` is deliberately unclaimed so no lane blocks on
    it, which also let two lanes read the same "next number" from `agent brief` and both append as
    it. `agent finding` allocates under a lock now, so this cannot happen again — but the pairs
    filed before that fix are still in the file, and `brief`/`claim` silently pick one of them.

    Renumbering is the real fix and is deliberately not done here: code comments and queued work
    orders cite BOTH members of most pairs, so it is a cross-cutting pass, not a doc edit. Until
    someone does it, printing the collision is what stops it from being a trap you only find by
    reading the file in order."""
    seen, dupes = set(), set()
    for fid, _ in _open_findings():
        (dupes if fid in seen else seen).add(fid)
    return sorted(dupes)


def _self_resolved_findings():
    """Findings under '## Open' whose own text says they are resolved.

    A third way the queue rots, and the one neither `_findings_drift()` nor `_sync_findings()` can
    see: an agent fixes something, writes the resolution INTO the entry — a `— **fixed**` suffix on
    the heading, or a `**Resolved ...**` line in the body — and never moves the section or runs
    `agent done`. Both records then agree the finding is open, so nothing disagrees and no drift is
    detectable; only the prose knows. F-067 sat that way with `— **fixed**` in its own heading while
    `brief` offered it as work.

    This is a text scan rather than a status comparison for exactly that reason. It is the entry
    itself, not the bookkeeping, that is being believed."""
    import re as _re
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return []
    text = open(path).read()
    if "## Open" not in text or "## Resolved" not in text:
        return []
    section = text[text.index("## Open"):text.index("## Resolved")]
    blocks = _re.split(r"(?m)^(### F-\d+ · .+)$", section)
    out = []
    for i in range(1, len(blocks), 2):
        head, body = blocks[i], blocks[i + 1]
        fid = head[4:].partition("·")[0].strip()
        settled = _re.search(r"—\s*\*\*(fixed|partly fixed|decided|won't[^*]*)[^*]*\*\*\s*$",
                             head.strip())
        noted = _re.search(r"(?m)^\*\*(Resolved|Fixed)\b", body)
        if settled or noted:
            out.append(fid)
    return sorted(set(out))


def _print_findings_drift(st):
    settled = _self_resolved_findings()
    if settled:
        print("  %s⚠ %d finding(s) under '## Open' whose own text says they are resolved: %s%s"
              % (C["y"], len(settled), "  ".join(settled), C["x"]))
        print("    %sneither the doc nor state.json disagrees here, so only the prose knows —"
              % C["dim"])
        print("    run `agent done <id>` and move the section to '## Resolved'.%s" % C["x"])
        print()
    dupes = _duplicate_findings()
    if dupes:
        print("  %s⚠ %d F-number(s) used by more than one open finding: %s%s"
              % (C["y"], len(dupes), "  ".join(dupes), C["x"]))
        print("    %sbrief/claim will pick one of them, and it may not be the one you mean —"
              % C["dim"])
        print("    read the surrounding text, not the number alone (F-058).%s" % C["x"])
        print()
    drift = _findings_drift(st)
    if not drift:
        return
    print("  %s⚠ %d finding(s) marked done but still under '## Open' in docs/FINDINGS.md%s"
          % (C["y"], len(drift), C["x"]))
    print("    %s%s%s" % (C["dim"], "  ".join(drift), C["x"]))
    print("    %s`board` hides these; `brief` still offers them. Read the entry, then pick one:"
          % C["dim"])
    print("      · it IS fixed  -> move its section to '## Resolved' with what you did and how")
    print("                        you verified it")
    print("      · it is NOT    -> agent reopen %s \"why\"   — `agent done` also gets used to mean"
          % drift[0])
    print("                        \"my session ended\", and that is not the same fact (F-131)%s"
          % C["x"])
    print()


def _print_stale(st):
    stale = [(t, d) for t, d in st["in_flight"].items()
             if age_hours(d.get("started", now())) > STALE_HOURS]
    if not stale:
        return
    print("%s%sStale (>%dh, likely abandoned)%s" % (C["y"], C["b"], STALE_HOURS, C["x"]))
    for tid, d in sorted(stale, key=lambda x: task_sort_key(x[0])):
        print("  %s  %s  %.0fh — release with:  agent drop %s"
              % (tid, d["agent"], age_hours(d["started"]), tid))
    print()


# ---------------------------------------------------------------- brief

def _journal_entries():
    """JOURNAL.md parsed into entries, oldest first. Written by _journal(), so the
    header shape is ours: '### KIND · task · agent · timestamp'."""
    if not os.path.exists(JOURNAL):
        return []
    entries, cur = [], None
    for line in open(JOURNAL):
        if line.startswith("### "):
            parts = [p.strip() for p in line[4:].strip().split("·")]
            cur = None
            if len(parts) >= 4:
                # Keep the timestamp. Without it every time-windowed reader (collect) sees an empty
                # "at", treats the entry as infinitely old, and silently reports nothing finished —
                # which is worse than no report, because it reads as "the lanes did nothing".
                cur = {"kind": parts[0].lower(), "task": parts[1], "agent": parts[2],
                       "at": parts[3], "body": []}
                entries.append(cur)
            continue
        if cur is not None and line.strip():
            cur["body"].append(line.rstrip())
    return entries


def _open_findings():
    """(id, title) for every finding under '## Open'. The template example under
    'How to file one' sits above that heading, so it is skipped for free."""
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return []
    out, in_open = [], False
    for line in open(path):
        if line.startswith("## "):
            in_open = line.strip() == "## Open"
        elif in_open and line.startswith("### F-"):
            fid, _, title = line[4:].strip().partition("·")
            out.append((fid.strip(), title.strip()))
    return out


def _finding_body(fid):
    """The prose of one open finding, so `agent brief F-013` is self-contained — the whole point of
    brief is that the agent does not have to go reading to find out what it was asked to do."""
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return []
    out, in_open, in_this = [], False, False
    for line in open(path):
        if line.startswith("## "):
            if in_this:
                break
            in_open = line.strip() == "## Open"
        elif line.startswith("### "):
            if in_this:
                break
            in_this = in_open and line[4:].strip().upper().startswith(fid.upper())
        elif in_this:
            out.append(line.rstrip())
    while out and not out[0].strip():
        out.pop(0)
    while out and (not out[-1].strip() or out[-1].strip() == "---"):
        out.pop()
    return out


def _wrap(text, width=94, indent="      "):
    words, line, out = text.split(), "", []
    for w in words:
        if len(line) + len(w) + 1 > width:
            out.append(indent + line)
            line = w
        else:
            line = (line + " " + w).strip()
    if line:
        out.append(indent + line)
    return out


def _warn_if_stale_finding(fid):
    """Warn when a finding's own files moved after it was filed — it may already be fixed.

    The most repeated waste in this project is dispatching a lane at a finding that stopped being
    true. A neighbouring task fixes the underlying bug in passing, nobody edits `## Open`, and the
    finding sits there looking like work. Six dispatches went this way in a single day (F-103, F-107,
    F-108, F-111, F-135, F-151) — each one a lane spending a window to discover the fix had already
    landed, then writing the docs the original task skipped.

    This cannot be authoritative — a changed file does not prove the finding is fixed — so it warns
    rather than blocks, and tells the reader to do the one thing that settles it: run the check
    first. That is cheap; a wasted dispatch is not."""
    body, filed = _finding_body(fid)
    if not body or not filed:
        return
    # Paths appear as `tools/x.gd`, `tools/x.gd:126`, or bare in the heading — findings name their
    # file in the title as often as in the body, which an earlier version of this missed entirely.
    paths = sorted(set(re.findall(r"([a-zA-Z0-9_./-]+\.(?:gd|py|tres|tscn|gdshader|md|json))",
                                  body)))
    paths = [p for p in paths if os.path.exists(os.path.join(ROOT, p))][:12]
    if not paths:
        return
    touched = []
    for p in paths:
        # "--since=2026-08-18" is NOT midnight: git's approxidate reads a bare date as that day at
        # the CURRENT time of day, so at 5pm it silently excludes everything committed earlier the
        # same day — which is most of what makes a finding stale. Pin the time explicitly.
        out = _git("log", "--oneline", "--since=%s 00:00" % filed, "--", p).stdout.strip()
        if out:
            touched.append((p, len(out.splitlines())))
    if not touched:
        return
    print("\n  %s⚠ this finding may already be fixed — files it names have changed since it was "
          "filed (%s)%s" % (C["y"], filed[:10], C["x"]))
    for p, n in touched[:6]:
        print("      %s%s — %d commit(s) since%s" % (C["dim"], p, n, C["x"]))
    print("  %sRun its check BEFORE editing anything. If it passes, the work is to close the "
          "finding and write whatever docs the original fix skipped.%s" % (C["dim"], C["x"]))


def _finding_body(fid):
    """A finding's text and its filed date, read from the doc rather than the task registry."""
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return "", ""
    lines = open(path).read().split("\n")
    body, grabbing = [], False
    for line in lines:
        if line.startswith("### "):
            if grabbing:
                break
            grabbing = line.startswith("### %s " % fid) or line.startswith("### %s·" % fid)
            if grabbing:
                body.append(line)      # the heading names the file as often as the body does
            continue
        if grabbing:
            body.append(line)
    text = "\n".join(body)
    m = re.search(r"\*\*Found:\*\*\s*(\d{4}-\d{2}-\d{2})", text)
    return text, (m.group(1) if m else "")


def cmd_brief(args):
    """Everything needed to start a task, in one call.

    This exists so that "start task 1.6" is a complete instruction. Before it, the
    context lived in hand-written prompts that a human pasted in, which made him the
    courier between agents and made every task cost a prompt-writing session first."""
    st = load()
    if not args:
        print("usage: agent brief <task-id>\n")
        _print_ready(st)
        return
    tid = _require_task(st, args[0], "brief")

    me = whoami(required=False) or "?"
    me_token = whoami_token()
    t = st["tasks"][tid]
    print("\n%s%s · %s%s" % (C["b"], tid, t["title"], C["x"]))
    print("  %s%s · tier %s · est %s · status %s%s"
          % (C["dim"], t.get("milestone", "?"), t.get("tier", "?"),
             t.get("est", "?"), t["status"], C["x"]))

    held = st["in_flight"].get(tid)
    if held and not _is_mine(held, me, me_token):
        print("\n  %s⚠ already in flight under '%s' since %s — pick another task%s"
              % (C["y"], held["agent"], held["started"][:16].replace("T", " "), C["x"]))
    if t["status"] == "done":
        print("\n  %s⚠ already done (%s by %s) — check the journal below before redoing it%s"
              % (C["y"], t.get("done_at", "?")[:10], t.get("done_by", "?"), C["x"]))
    if _is_finding(tid):
        _warn_if_stale_finding(tid)

    # Read these, in this order. Bounded on purpose: this list is the alternative to
    # exploring, which is the most expensive thing an agent does here.
    print("\n%sRead first%s" % (C["b"], C["x"]))
    for path, why in (
        ("AGENTS.md", "the protocol — claim, record, close out"),
        ("docs/ARCHITECTURE.md §2.2", "the authority table. Your system declares a row of it"),
        ("docs/DELEGATION.md", "'Current state' — what shipped, and the APIs you build against"),
        ("docs/DECISIONS.md", "settled calls. Check before relitigating one"),
    ):
        print("  %-32s %s%s%s" % (path, C["dim"], why, C["x"]))

    if _is_finding(tid):
        body = _finding_body(tid)
        if body:
            print("\n%sThe finding, in full — this is the spec%s" % (C["b"], C["x"]))
            for line in body:
                print("  %s%s%s" % (C["dim"], line[:110], C["x"]))
            print("\n  %sClosing it means the fix AND moving the section to '## Resolved' in"
                  " docs/FINDINGS.md,%s" % (C["dim"], C["x"]))
            print("  %swith what you did and how you verified it. A fix nobody can find is not"
                  " closed.%s" % (C["dim"], C["x"]))

    findings = [(fid, title) for fid, title in _open_findings() if fid != tid]
    if findings:
        print("\n%sOther open findings — traps someone already paid for%s" % (C["b"], C["x"]))
        for fid, title in findings:
            print("  %-8s %s%s%s" % (fid, C["dim"], title[:78], C["x"]))

    entries = _journal_entries()
    mine_hist = [e for e in entries if e["task"] == tid]
    milestone = t.get("milestone", "")
    siblings = [e for e in entries
                if e["task"] != tid
                and st["tasks"].get(e["task"], {}).get("milestone") == milestone][-4:]

    if mine_hist:
        print("\n%sThis task has history — read it before starting over%s" % (C["y"], C["x"]))
        for e in mine_hist:
            print("  %s%s by %s%s" % (C["b"], e["kind"].upper(), e["agent"], C["x"]))
            for line in e["body"][1:6]:
                print("      %s%s%s" % (C["dim"], line[:100], C["x"]))

    if siblings:
        print("\n%sRecent work in %s — what it left you%s" % (C["b"], milestone, C["x"]))
        for e in siblings:
            print("  %s%s · %s · %s%s"
                  % (C["b"], e["kind"].upper(), e["task"], e["agent"], C["x"]))
            notes = [l for l in e["body"] if l.startswith("- ")]
            for n in notes[:4]:
                for line in _wrap(n[2:]):
                    print("    %s%s%s" % (C["dim"], line[4:], C["x"]))
            if not notes and len(e["body"]) > 1:
                for line in _wrap(" ".join(e["body"][1:3]))[:2]:
                    print("    %s%s%s" % (C["dim"], line[4:], C["x"]))

    others = {f: c for f, c in st["claims"].items() if not _is_mine(c, me, me_token)}
    if others:
        print("\n%sHeld by someone else right now — do not edit%s" % (C["b"], C["x"]))
        for f, c in sorted(others.items()):
            print("  %-52s %s%s (%s)%s" % (f, C["dim"], c["agent"], c["task"], C["x"]))

    print("""
%sHow this task ends%s — all of it yours, none of it Sequoyah's to relay:
  1. %sagent claim %s <files>%s      before the first edit
  2. %sagent note %s "..."%s        each trap or decision, as you hit it
  3. anything outside this task  ->  docs/FINDINGS.md (next F-number)
     a settled call others must not relitigate  ->  docs/DECISIONS.md
     an API or layout the next task builds on  ->  docs/DELEGATION.md 'Current state'
  4. %sagent done %s "..."%s then %sagent ship %s "msg"%s
%sAmbiguous spec? Decide it, write down why, keep going. Do not stop and wait.%s
""" % (C["b"], C["x"], C["c"], tid, C["x"], C["c"], tid, C["x"],
       C["c"], tid, C["x"], C["c"], tid, C["x"], C["dim"], C["x"]))


# ---------------------------------------------------------------- claiming

def cmd_claim(args):
    if not args:
        die("usage: agent claim <task-id> [files...]")
    me = whoami()
    me_token = whoami_token()
    files = [_rel(f) for f in args[1:]]
    st = load()
    tid = _require_task(st, args[0], "claim")

    if st["tasks"][tid]["status"] == "done":
        die("%s is already done" % tid)
    held = st["in_flight"].get(tid)
    if held and not _is_mine(held, me, me_token):
        die("%s is already claimed by %s (started %s)" % (tid, held["agent"], held["started"]))

    conflicts = [(f, st["claims"][f]) for f in files
                 if f in st["claims"] and not _is_mine(st["claims"][f], me, me_token)]
    if conflicts:
        for f, c in conflicts:
            print("%s✗ %s is claimed by %s for task %s%s" % (C["r"], f, c["agent"], c["task"], C["x"]))
        die("resolve the overlap before continuing — two agents in one file will conflict")

    if not held:
        st["in_flight"][tid] = {"agent": me, "token": me_token, "started": now(), "files": [], "notes": []}
    entry = st["in_flight"][tid]
    for f in files:
        if f not in entry["files"]:
            entry["files"].append(f)
        st["claims"][f] = {"task": tid, "agent": me, "token": me_token, "at": now()}
    st["tasks"][tid]["status"] = "in_flight"
    save(st)

    ok("%s claimed by %s" % (tid, me))
    print("  %s" % st["tasks"][tid]["title"])
    if files:
        for f in files:
            print("  %s· %s%s" % (C["dim"], f, C["x"]))
    else:
        print("  %sno files claimed yet — add them with:  agent claim %s <files...>%s"
              % (C["dim"], tid, C["x"]))


def _rel(p):
    p = os.path.abspath(p) if os.path.exists(p) else os.path.join(ROOT, p)
    return os.path.relpath(p, ROOT)


def cmd_note(args):
    if len(args) < 2:
        die('usage: agent note <task-id> "what you learned or did"')
    me = whoami()
    tid, text = _norm_id(args[0]), " ".join(args[1:])
    st = load()
    if tid not in st["in_flight"]:
        die("%s is not in flight" % tid)
    st["in_flight"][tid]["notes"].append({"at": now(), "by": me, "text": text})
    save(st)
    ok("noted on %s" % tid)


# ---------------------------------------------------------------- finishing

def _file_hash(rel):
    """sha256 of a repo-relative file's current bytes, or None if it doesn't exist / can't be read.

    Used to notice a claimed file changing under a task between its done() and its ship() —
    see the F-117 warning in cmd_ship."""
    try:
        with open(os.path.join(ROOT, rel), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def _release(st, tid):
    """Release a task's claims, but remember them briefly.

    `agent done` runs before `git commit`, so without this the pre-commit check
    would see every just-finished file as unclaimed and warn about all of them —
    noise that trains you to ignore the warnings that matter."""
    entry = st["in_flight"].pop(tid, None)
    if entry:
        recent = st.setdefault("recent", {})
        for f in entry.get("files", []):
            if st["claims"].get(f, {}).get("task") == tid:
                del st["claims"][f]
            # F-117: docs/ files need no claim to WRITE, only to commit (F-006/F-072), so a second
            # lane can and does edit a file in the window between this task finishing with it and
            # actually shipping it — ship has no way to attribute a hunk in a file it legitimately
            # holds to a different task. Snapshotting the content right now, at the moment this task
            # is done with the file, gives ship something cheap to compare against later: if the
            # working tree no longer matches this snapshot when ship runs, somebody else touched the
            # file in between and ship should say so instead of silently sweeping it into this
            # task's commit under this task's name.
            recent[f] = {"task": tid, "agent": entry["agent"], "token": entry.get("token"),
                         "at": now(), "hash": _file_hash(f)}
    return entry


def _head():
    try:
        return subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT,
                              capture_output=True, text=True).stdout.strip()
    except Exception:
        return "?"


def _journal(kind, tid, title, agent, body, files):
    os.makedirs(AGENT_DIR, exist_ok=True)
    if not os.path.exists(JOURNAL):
        with open(JOURNAL, "w") as f:
            f.write("# Journal\n\nAppend-only. Newest at the bottom. "
                    "Written by `agent done` / `agent handoff`.\n")
    with open(JOURNAL, "a") as f:
        f.write("\n---\n\n### %s · %s · %s · %s\n\n" % (kind, tid, agent, now()))
        f.write("**%s**\n\n" % title)
        f.write("%s\n\n" % body)
        if files:
            f.write("Files: %s\n\n" % ", ".join("`%s`" % x for x in files))
        f.write("Commit at time of writing: `%s`\n" % _head())


def cmd_reopen(args):
    """Mark a finding open again, with a reason, in the journal (F-131).

    `agent done` is the only close-out verb, so it gets used for "my session on this finding ended"
    as well as "this finding is resolved" — and those are different facts. F-036 is the worked
    example: lp did real work on it, ran `agent done`, and wrote in the same journal entry that the
    finding *stays open* because closing it needs Sequoyah's playtest verdict. State said done; the
    doc said open; `board` hid it and `brief` offered it, so the one genuine human hand-off in the
    queue became invisible to the director routing work off the board.

    The alternative was hand-editing `state.json`, which leaves no trace of who decided what. This
    is the same act with a journal entry attached.
    """
    if len(args) < 2:
        die('usage: agent reopen <task-id> "why it is not actually resolved"\n'
            "  For a finding that was marked done but was never resolved — a status correction,\n"
            "  not a new finding. If there is genuinely NEW work, file a new F-number instead.")
    me = whoami()
    st = load()
    tid = _require_task(st, args[0], "reopen")
    reason = " ".join(args[1:])
    t = st["tasks"][tid]
    if t.get("status") != "done":
        die("%s is already %s — nothing to reopen." % (tid, t.get("status", "todo")))
    was = "%s by %s" % (t.get("done_at", "?")[:10], t.get("done_by", "?"))
    t["status"] = "todo"
    t.pop("done_at", None)
    t.pop("done_by", None)
    save(st)
    _journal("REOPEN", tid, t["title"], me,
             "Reopened (was marked done %s).\n\n%s" % (was, reason), [])
    ok("%s reopened — claimable again, journal updated" % tid)
    if _is_finding(tid) and tid not in dict(_open_findings()):
        print("  %s⚠ %s is under '## Resolved' in docs/FINDINGS.md — move its section back to"
              % (C["y"], tid))
        print("    '## Open', or the next sync will close it again.%s" % C["x"])
    print("  %sCommit now so the next agent sees it.%s" % (C["dim"], C["x"]))


def cmd_done(args):
    if not args:
        die('usage: agent done <task-id> ["one-line summary"]')
    me = whoami()
    summary = " ".join(args[1:]) or "Completed."
    st = load()
    tid = _require_task(st, args[0], "done")
    entry = _release(st, tid)
    st["tasks"][tid]["status"] = "done"
    st["tasks"][tid]["done_at"] = now()
    st["tasks"][tid]["done_by"] = me
    save(st)

    notes = ""
    if entry and entry.get("notes"):
        notes = "\n\nNotes along the way:\n" + "\n".join(
            "- %s" % n["text"] for n in entry["notes"])
    _journal("DONE", tid, st["tasks"][tid]["title"], me, summary + notes,
             entry.get("files", []) if entry else [])

    ok("%s done — claims released, journal updated" % tid)
    if _is_finding(tid) and tid in dict(_open_findings()):
        print("  %s⚠ %s is still under '## Open' in docs/FINDINGS.md — move it to '## Resolved'"
              % (C["y"], tid))
        print("    with what you did and how you verified it, or the next agent re-fixes it.%s"
              % C["x"])
    _print_ready(load())
    print("  %sCommit now so the next agent sees it.%s" % (C["dim"], C["x"]))


def cmd_handoff(args):
    if len(args) < 2:
        die('usage: agent handoff <task-id> "what is done, what is left, what to watch out for"')
    me = whoami()
    tid, body = _norm_id(args[0]), " ".join(args[1:])
    st = load()
    if tid not in st["in_flight"]:
        die("%s is not in flight" % tid)
    entry = _release(st, tid)
    st["tasks"][tid]["status"] = "todo"
    save(st)
    _journal("HANDOFF", tid, st["tasks"][tid]["title"], me, body, entry.get("files", []))
    ok("%s handed off — claims released, next agent can pick it up" % tid)
    print("  %sCommit your partial work so it isn't lost.%s" % (C["dim"], C["x"]))


def cmd_drop(args):
    if not args:
        die("usage: agent drop <task-id>")
    tid = _norm_id(args[0])
    st = load()
    entry = _release(st, tid)
    if not entry:
        die("%s is not in flight" % tid)
    st["tasks"][tid]["status"] = "todo"
    save(st)
    ok("%s dropped — claims released" % tid)


# ---------------------------------------------------------------- ship

def _git(*a):
    return subprocess.run(["git"] + list(a), cwd=ROOT, capture_output=True, text=True)


def _branch():
    return _git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() or "main"


GODOT_CANDIDATES = (
    os.environ.get("GODOT", ""),
    "/Applications/Godot.app/Contents/MacOS/Godot",
    "godot",
    "godot4",
)


def _find_godot():
    """The pinned engine, or None. Never fatal: Codex on another machine may not have it."""
    for c in GODOT_CANDIDATES:
        if not c:
            continue
        if os.path.sep in c:
            if os.path.isfile(c) and os.access(c, os.X_OK):
                return c
            continue
        try:
            if subprocess.run(["which", c], capture_output=True, text=True).returncode == 0:
                return c
        except FileNotFoundError:
            pass
    return None


def _generate_missing_uids(to_stage, changed):
    """Run one Godot import if any staged .gd has no .uid, and return a refreshed `changed` list.

    F-017. `ship` can only stage what is on disk, and Godot writes the sidecar at import time — so a
    task whose work never required an import shipped a script with no .uid, every time. Harmless
    while .tscn files reference scripts by `path=`, and not harmless the first time Godot rewrites
    those as `uid://`. This is the same command that rebuilds the global class cache (F-016), so it
    fixes both failures rather than leaving a per-milestone sweep to catch them.
    """
    orphans = [f for f in to_stage
               if f.endswith(".gd") and not os.path.exists(os.path.join(ROOT, f + ".uid"))]
    if not orphans:
        return changed

    # F-120: also a bare `pgrep -fl Godot` until now, so any concurrent headless check run made
    # `ship` skip the import pass and every .gd in that commit went out without its .uid sidecar —
    # exactly the F-017 failure the message below warns about, triggered by a process that was
    # never a risk to anything.
    if _godot_running():
        print("  %s⚠ %d script(s) have no .uid, and the Godot editor is open — skipping import "
              "(D-031).%s" % (C["y"], len(orphans), C["x"]))
        print("  %sClose the editor and re-run ship, or the sidecars ship late (F-017).%s"
              % (C["dim"], C["x"]))
        return changed

    godot = _find_godot()
    if godot is None:
        print("  %s⚠ %d script(s) have no .uid and Godot was not found — sidecars will ship late.%s"
              % (C["y"], len(orphans), C["x"]))
        print("  %sSet GODOT=/path/to/Godot to let ship generate them (F-017).%s"
              % (C["dim"], C["x"]))
        return changed

    print("  %sgenerating .uid for %d new script(s) — one Godot import…%s"
          % (C["dim"], len(orphans), C["x"]))
    r = subprocess.run([godot, "--headless", "--path", ROOT, "--import"],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        print("  %s⚠ import failed (%d) — sidecars will ship late.%s" % (C["y"], r.returncode, C["x"]))
        return changed

    return [l[3:].strip().strip('"').split(" -> ")[-1]
            for l in _git("status", "--porcelain", "-uall").stdout.splitlines() if l.strip()]


def cmd_ship(args):
    """Commit and push exactly this task's files, then print the completion notice.

    Deliberately NOT `git add -A`. Parallel agents share one working directory, so a
    blanket add would sweep another agent's half-written files into this commit — the
    real hazard when several chats run at once (push races can't happen from one repo).
    Only the files this task claimed, plus the coordination state, are staged — and the
    commit itself is limited to those same paths, because one shared index means `add`
    alone does not decide what a commit contains (F-014)."""
    if not args:
        die('usage: agent ship <task-id> ["commit message"]')

    # F-034: `claim` takes a file list, so passing one to `ship` too is the natural guess — and it
    # used to be silently glued onto the commit subject, which is how 340d9a3 ended up titled
    # "Art: rebuild the tool set and add inventory icons tools/blender/build_tool_weapon_set.py …".
    # Reject anything that looks like a path rather than prose. A message word is essentially never
    # an existing path, so this catches the mistake without breaking an unquoted message.
    pathish = [a for a in args[1:]
               if os.path.exists(os.path.join(ROOT, a)) or (("/" in a) and not a.endswith(("/", ".")))]
    if pathish:
        die("ship takes a task id and a MESSAGE, not a file list — it commits what the task claimed.\n"
            "  Looks like a path: %s\n"
            '  Did you mean:  agent ship %s "your message here"'
            % (", ".join(pathish[:4]), args[0]))

    me = whoami()
    st = load()
    tid = _require_task(st, args[0], "ship")
    if tid in st["in_flight"]:
        die("%s is still in flight — run 'agent done %s' or 'agent handoff %s' first" % (tid, tid, tid))

    title = st["tasks"][tid]["title"]
    msg = " ".join(args[1:]) or ("%s %s" % (tid, title[:60]))

    # The files this task held, recorded by _release() when it closed out.
    mine = sorted(f for f, d in st.get("recent", {}).items() if d.get("task") == tid)
    changed = [l[3:].strip().strip('"').split(" -> ")[-1]
               for l in _git("status", "--porcelain", "-uall").stdout.splitlines() if l.strip()]

    # F-034: a claim on a directory is legal — `agent check` and the pre-commit hook both honour it —
    # but it names nothing in `changed`, which lists files. 2.1d claimed `assets/tools_weapons` and
    # `assets/icons`, shipped a third of its work, and still printed a clean sign-off. Expand every
    # claimed directory to the changed files underneath it.
    claimed_dirs = [p for p in mine if os.path.isdir(os.path.join(ROOT, p))]
    expanded = [f for f in changed
                if any(f.startswith(d.rstrip("/") + "/") for d in claimed_dirs)]

    to_stage = [f for f in mine if f in changed]
    to_stage += expanded
    to_stage += [f for f in changed if f in COORDINATION_PATHS]  # F-081, not a .agent/ glob
    # F-070: a reviewer claims nothing by design, so `mine` is empty and the mandated ship staged
    # coordination state and nothing else — stranding the findings it had just been told to write.
    # A review task owns exactly one artifact; give it that, and only that.
    if st["tasks"][tid].get("review_of"):
        to_stage += [f for f in changed if f == "docs/FINDINGS.md"]
    # Godot writes a .uid sidecar beside every script and regenerates it when the script
    # changes. Nobody authors one and nobody claims one, so it never appeared in any task's
    # file list — which is precisely how F-010 left a trail of untracked .uid files behind
    # shipped tasks. Ship each sidecar with the script it belongs to.
    to_stage += [f + ".uid" for f in list(to_stage) if f + ".uid" in changed]
    to_stage = list(dict.fromkeys(to_stage))
    if not to_stage:
        die("nothing to ship for %s — no changed files from this task" % tid)

    # F-017: the line above can only stage a sidecar that already exists. Godot writes .uid at IMPORT
    # time, so a task that never had a reason to import ships before the file exists at all — which
    # is why every new script left one behind. Import now, then look again.
    changed = _generate_missing_uids(to_stage, changed)
    to_stage += [f + ".uid" for f in list(to_stage) if f + ".uid" in changed]
    to_stage = list(dict.fromkeys(to_stage))

    others = [f for f in changed if f not in to_stage]

    # F-117: `mine` says this task is the last one to have released a claim on the file, but on an
    # exempt-from-claim path (docs/, mainly — F-006) that is not the same thing as "nobody else has
    # touched it since." Compare each file's current bytes to the snapshot _release() took when this
    # task finished with it; a mismatch means another lane edited the same file in the gap between
    # this task's `done()` and this `ship()`, and it is about to be swept into this commit under
    # this task's name. Heuristic, not proof (see F-117) — warn, don't block: the content is usually
    # fine, just misattributed, and blocking would strand a lane on a false positive.
    recent = st.get("recent", {})
    drifted = [f for f in to_stage
               if recent.get(f, {}).get("task") == tid
               and recent[f].get("hash") is not None
               and _file_hash(f) != recent[f]["hash"]]
    if drifted:
        print("\n%s⚠ %d file(s) changed since %s finished with them — this commit may carry another "
              "lane's edits too (F-117):%s" % (C["y"], len(drifted), tid, C["x"]))
        for f in drifted:
            print("      %s· %s%s" % (C["dim"], f, C["x"]))
        print("  %sCheck before trusting the attribution: git diff -- %s%s"
              % (C["dim"], " ".join(drifted), C["x"]))

    # `add` first: a pathspec commit cannot name a file git has never seen.
    r = _git("add", "--", *to_stage)
    if r.returncode != 0:
        die("git add failed: %s" % r.stderr.strip())

    # Commit BY PATHSPEC, not the whole index (F-014). Several agents share one working
    # directory and therefore one index, so a bare `git commit` sweeps in whatever another
    # agent has staged and not yet committed — the exact hazard the careful `add` list above
    # exists to prevent. With a pathspec git builds a temporary index from HEAD plus these
    # paths, so the other agent's staging is neither committed nor disturbed, and the
    # pre-commit hook sees only this task's files.
    r = _git("commit", "-m", "%s\n\nTask %s shipped by %s." % (msg, tid, me), "--", *to_stage)
    if r.returncode != 0:
        # Scoped reset. A bare `git reset` here would unstage the other agent's work too —
        # reaching into state that is not ours to touch (F-014).
        _git("reset", "--", *to_stage)
        die("commit blocked:\n%s%s" % (r.stdout, r.stderr))
    ok("committed %d file(s) — %s" % (len(to_stage), _head()))

    if others:
        # F-034: the count and the truncation both matter. "Left alone" used to print at most eight
        # paths with no total, so a run that shipped a third of its work read exactly like one that
        # shipped all of it.
        print("  %sLeft alone — %d file(s), not this task's, may belong to another agent:%s"
              % (C["dim"], len(others), C["x"]))
        for f in others[:8]:
            print("      %s· %s%s" % (C["dim"], f, C["x"]))
        if len(others) > 8:
            print("      %s… and %d more — run 'git status' to see them all%s"
                  % (C["dim"], len(others) - 8, C["x"]))
        # F-081: harness source used to ride along on every ship. It no longer does, which means a
        # director who edited it without claiming it now watches their own fix stay behind. Say so
        # here, at the moment it happens and by name, instead of leaving it to be noticed later.
        harness = [f for f in others if f.startswith(UNFREE_PREFIXES)]
        if harness:
            print("      %s↳ %s — harness source, not coordination state: it ships under a claim%s"
                  % (C["dim"], ", ".join(harness), C["x"]))
            print("        %sheld by the task that edited it, claimed before that task closes "
                  "out (F-081)%s" % (C["dim"], C["x"]))

    if not _git("remote").stdout.strip():
        print("\n%s⚠ No git remote configured — committed locally, nothing pushed.%s"
              % (C["y"], C["x"]))
        print("  %sSequoyah: gh repo create mire --private --source=. --remote=origin --push%s"
              % (C["dim"], C["x"]))
    else:
        br = _branch()
        r = _git("push")
        if r.returncode != 0:
            r = _git("push", "-u", "origin", br)
        if r.returncode == 0:
            ok("pushed to origin/%s" % br)
        else:
            print("%s✗ push failed:%s %s" % (C["r"], C["x"], (r.stderr or r.stdout).strip()[:300]))
            print("  %sWork is committed locally and safe. Tell Sequoyah the push failed.%s"
                  % (C["dim"], C["x"]))

    print("\n%s%s Task %s shipped — before you stop:%s" % (C["b"], "─" * 3, tid, C["x"]))
    print("""
  %sSequoyah is not a courier.%s Anything the NEXT agent needs must already be in the
  repo, not in your final message. Check each of these, and go do it if it is missing:

    · a problem you spotted outside this task      -> docs/FINDINGS.md, next F-number
    · a call you made that others must not redo    -> docs/DECISIONS.md, next D-number
    · an API, node layout or constant 1.x builds on -> docs/DELEGATION.md 'Current state'
    · how it went, what bit you                    -> already in the journal via done/note

  %sThen tell Sequoyah only what is genuinely his:%s
    · what you verified, with the command and its actual output — not "it works"
    · whether it RUNS or only compiles, in those words
    · what he must do in the Godot editor, if anything. Make required .tscn/.tres changes
      yourself under exact claims while Godot is closed; hand off only genuine visual tuning
    · whether it is safe to start the next task
""" % (C["b"], C["x"], C["b"], C["x"]))


# ---------------------------------------------------------------- check

def _autoload_section_lines(text):
    """Every non-blank line inside project.godot's [autoload] section, stripped."""
    lines, in_section = set(), False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            in_section = stripped == "[autoload]"
            continue
        if in_section and stripped:
            lines.add(stripped)
    return lines


def _autoload_only_project_change(staged):
    """True when the only change to project.godot is appended autoload registrations (F-051).

    Deliberately strict, because everything else about this file genuinely does want a claim: a
    changed rendering setting, a reordered line, a deletion. Requires the diff to be pure additions,
    every added line to have the shape `Name="*res://path"`, and every one of those lines to actually
    land inside [autoload] — a registration-looking line appended to [rendering] is not this path."""
    rel = "project.godot"
    try:
        diff_cmd = ["git", "diff", "-U0"] + (["--cached"] if staged else []) + ["--", rel]
        d = subprocess.run(diff_cmd, cwd=ROOT, capture_output=True, text=True)
        if d.returncode != 0 or not d.stdout.strip():
            return False
        added = []
        for line in d.stdout.splitlines():
            if line.startswith(("+++", "---", "@@", "diff ", "index ")):
                continue
            if line.startswith("-"):
                return False  # A deletion is never an append-only registration.
            if line.startswith("+"):
                added.append(line[1:].strip())
        added = [a for a in added if a]
        if not added or not all(AUTOLOAD_LINE_RE.match(a) for a in added):
            return False
        if staged:
            shown = subprocess.run(["git", "show", ":" + rel], cwd=ROOT,
                                   capture_output=True, text=True)
            if shown.returncode != 0:
                return False
            content = shown.stdout
        else:
            with open(PROJECT_GODOT) as fh:
                content = fh.read()
        return set(added) <= _autoload_section_lines(content)
    except Exception:
        return False  # Never fail open: an unreadable diff falls back to demanding the claim.


def cmd_check(args):
    """Verify uncommitted changes respect claims and the closed-editor rule.
    Run by the pre-commit hook."""
    me = whoami(required=False) or "unknown"
    me_token = whoami_token()
    st = load()

    # Inside a git hook, judge the STAGED set — that is what is actually being
    # committed (F-001). Scanning the working tree instead made any two agents
    # working at once block each other's commits over files neither was
    # committing, which taught everyone to reach for --no-verify. Git exports
    # GIT_INDEX_FILE to its hooks and nowhere else, so it tells us which we are.
    # Run by hand, the working tree is still the useful scope.
    staged_only = bool(os.environ.get("GIT_INDEX_FILE"))
    changed = None
    if staged_only:
        try:
            r = subprocess.run(["git", "diff", "--cached", "--name-only"], cwd=ROOT,
                               capture_output=True, text=True)
            if r.returncode == 0:
                changed = [l.strip().strip('"') for l in r.stdout.splitlines() if l.strip()]
        except Exception:
            changed = None
    if changed is None:
        # Fall back to the working tree: manual runs, and the first-commit case
        # where there is no HEAD to diff against. Never fail open.
        try:
            # -uall: list untracked files individually. Without it git collapses a
            # wholly-untracked directory to "dir/" and we never see the files inside.
            raw = subprocess.run(["git", "status", "--porcelain", "-uall"], cwd=ROOT,
                                 capture_output=True, text=True).stdout
        except Exception:
            return
        changed = [l[3:].strip().strip('"') for l in raw.splitlines() if l.strip()]
        changed = [c.split(" -> ")[-1] for c in changed]

    errors, warnings = [], []
    human = me in ("sequoyah", "human", "unknown")
    editor_running = None

    def godot_is_running():
        # F-120: this was its own bare `pgrep -fl Godot`, which matched any headless check run. The
        # hook then refused commits that were never unsafe, and the only way past a blocked commit
        # is --no-verify — which also switches off the closed-editor rule this line enforces. One
        # implementation now, shared with `agent autoload`, `agent order` and `agent editor-running`.
        nonlocal editor_running
        if editor_running is None:
            editor_running = _godot_running()
        return editor_running

    def in_grace(path):
        r = st.get("recent", {}).get(path)
        return bool(r) and _is_mine(r, me, me_token) and age_hours(r["at"]) < RECENT_GRACE_HOURS

    for f in changed:
        if ((any(f.startswith(p) for p in FREE_PREFIXES)
             and not f.startswith(UNFREE_PREFIXES))  # F-081: harness source is source
                or f.endswith(GENERATED_SUFFIXES)):
            # F-072: free means "free unless somebody actually claimed it". F-006 exempts docs/ so
            # that no lane ever blocks on a doc NOBODY claimed — that is the property worth keeping,
            # and an unclaimed doc stays free below. But `agent claim` accepts a docs/ path, records
            # it, and prints it on the board under an agent's name, where it reads exactly like
            # every other claim. It was enforced nowhere: task 2.1k held docs/ROADMAP.md and another
            # session committed that file with the hook waving it through, because the hook saw a
            # docs/ prefix and stopped asking. An explicit claim now means what it looks like.
            held = st["claims"].get(f)
            if held and not _is_mine(held, me, me_token) and not in_grace(f) and not human:
                errors.append("%s — %s holds an exact claim on it for %s. docs/ is free only while "
                              "nobody has claimed it (F-006/F-072)" % (f, held["agent"], held["task"]))
            continue
        c = st["claims"].get(f)
        is_editor_guarded = f.endswith(EDITOR_GUARDED_SUFFIXES) or f in EDITOR_GUARDED_PATHS
        if is_editor_guarded and not human:
            # F-051's carve-out, checked before the claim rule: an autoload registration is
            # claim-free by design. The closed-editor half of D-031 still applies — that is the half
            # protecting against the editor overwriting the file, and it is not about claims at all.
            if f == "project.godot" and _autoload_only_project_change(staged_only):
                if godot_is_running():
                    errors.append("%s — Godot is running; close it before committing an autoload "
                                  "registration (D-031)" % f)
                else:
                    warnings.append("%s — autoload registration only, no claim needed (F-051)" % f)
                continue
            # D-031: agents may edit Godot-authored files under an exact claim, but
            # never while the editor is running because it may overwrite them.
            if (c and _is_mine(c, me, me_token)) or in_grace(f):
                if godot_is_running():
                    errors.append("%s — Godot is running; close it before committing editor-guarded files (D-031)" % f)
                else:
                    warnings.append("%s — Godot file edited under an exact claim with the editor closed (D-031)" % f)
                continue
            errors.append("%s — Godot file requires an exact-file claim and a closed editor (D-031)" % f)
            continue
        if c and not _is_mine(c, me, me_token):
            # The human integrates everyone's work, so they may commit any file.
            # Agents may not touch a file another agent holds.
            if human:
                warnings.append("%s — claimed by %s (task %s); committing as integrator"
                                % (f, c["agent"], c["task"]))
            else:
                errors.append("%s — claimed by %s for task %s" % (f, c["agent"], c["task"]))
        elif not c and not human and not in_grace(f):
            # in_grace: just closed this task out; committing is the expected next step.
            warnings.append("%s — edited without a claim" % f)

    for w in warnings:
        print("%s⚠ %s%s" % (C["y"], w, C["x"]))
    for e in errors:
        print("%s✗ %s%s" % (C["r"], e, C["x"]))
    if errors:
        print("\n%sCommit blocked.%s Use --no-verify only if you are certain.\n" % (C["r"], C["x"]))
        sys.exit(1)
    if not warnings:
        ok("check passed (%d changed file(s), session: %s)" % (len(changed), me))


# ---------------------------------------------------------------- board

def _print_ready(st, limit=6):
    # Findings are deliberately excluded from the milestone scan: "Findings" sorts before "M0",
    # so counting it here would make the current milestone the findings list forever.
    # "blocked" counts as settled here, not as outstanding. A deliberately deferred task (D-030's
    # 1.12) would otherwise pin its milestone active forever while offering nothing pickable, and
    # since only that milestone's todo tasks are listed, the whole board would go silent — F-026.
    # A milestone whose only remaining work is deferred is finished for the one question this scan
    # answers, which is "what should I start now".
    done_ms = set()
    for t in st["tasks"].values():
        if t["status"] not in ("done", "blocked") and t["milestone"] != FINDINGS_MILESTONE:
            done_ms.add(t["milestone"])
    active = sorted(done_ms)[:1]
    ready = [(tid, t) for tid, t in st["tasks"].items()
             if t["status"] == "todo" and t["milestone"] in active]
    ready.sort(key=lambda x: task_sort_key(x[0]))
    if ready:
        print("\n%sReady to pick up%s" % (C["b"], C["x"]))
        for tid, t in ready[:limit]:
            print("  %s%-5s%s %-4s %s" % (C["c"], tid, C["x"], t["tier"], t["title"][:66]))
        if len(ready) > limit:
            print("  %s… %d more%s" % (C["dim"], len(ready) - limit, C["x"]))
        print()

    # Their own section, so an open finding is visibly pickable work rather than a footnote in a
    # doc — which is what left F-013 sitting open across three sessions.
    open_findings = [(tid, t) for tid, t in st["tasks"].items()
                     if t["milestone"] == FINDINGS_MILESTONE and t["status"] == "todo"]
    open_findings.sort(key=lambda x: task_sort_key(x[0]))
    if open_findings:
        print("%sOpen findings — claimable by F-number%s" % (C["b"], C["x"]))
        for tid, t in open_findings[:limit]:
            print("  %s%-5s%s %-4s %s" % (C["c"], tid, C["x"], t["tier"], t["title"][:66]))
        if len(open_findings) > limit:
            print("  %s… %d more%s" % (C["dim"], len(open_findings) - limit, C["x"]))
        print()


def _print_board(st, focus=None):
    if st["in_flight"]:
        print("%sIn flight%s" % (C["b"], C["x"]))
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            mine = " %s← you%s" % (C["g"], C["x"]) if d["agent"] == focus else ""
            print("  %s%-5s%s %-9s %.0fh  %s%s"
                  % (C["c"], tid, C["x"], d["agent"], age_hours(d["started"]),
                     st["tasks"].get(tid, {}).get("title", "?")[:50], mine))
            for f in d.get("files", []):
                print("      %s· %s%s" % (C["dim"], f, C["x"]))
            for n in d.get("notes", [])[-2:]:
                print("      %s› %s%s" % (C["dim"], n["text"][:70], C["x"]))
        print()
    else:
        print("%sIn flight%s  %snothing — clean slate%s\n" % (C["b"], C["x"], C["dim"], C["x"]))
    _print_ready(st)


def _roadmap_progress(st):
    """Done/total over ROADMAP tasks only. Findings are counted separately — folding them in would
    make the milestone number move every time someone files one, which is the opposite of useful."""
    # .get, not ["milestone"]: a task without one is a hand-edited or half-migrated state file, and
    # a KeyError here takes down `board`, `start` and every `save()` — i.e. the whole harness — over
    # a field that is only used to exclude findings from the roadmap count.
    items = [t for t in st["tasks"].values() if t.get("milestone") != FINDINGS_MILESTONE]
    return sum(1 for t in items if t["status"] == "done"), len(items)


def cmd_board(args):
    st = load()
    # Same freshness rule as cmd_start (F-049): the board is read to pick work, so it must mirror
    # FINDINGS.md's open section at read time, not at last-sync time.
    _sync_findings(st)
    save(st)
    done, total = _roadmap_progress(st)
    print("\n%sMIRE%s  %d/%d tasks done\n" % (C["b"], C["x"], done, total))
    _print_board(st, focus=whoami(required=False))
    _print_stale(st)
    _print_findings_drift(st)


def render_board(st):
    """Write the human/agent-readable BOARD.md."""
    done, total = _roadmap_progress(st)
    L = ["# Board",
         "",
         "<!-- Generated by `agent`. Do not hand-edit — run `agent board` instead. -->",
         "",
         "**%d / %d tasks complete.**" % (done, total),
         "", "## In flight", ""]

    if st["in_flight"]:
        L += ["| Task | Agent | Started | Files claimed |", "|---|---|---|---|"]
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            files = ", ".join("`%s`" % f for f in d.get("files", [])) or "—"
            L.append("| **%s** %s | %s | %s | %s |"
                     % (tid, st["tasks"].get(tid, {}).get("title", "?"), d["agent"],
                        d["started"][:16].replace("T", " "), files))
        L.append("")
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            if d.get("notes"):
                L.append("**%s notes:**" % tid)
                L += ["- %s" % n["text"] for n in d["notes"]]
                L.append("")
    else:
        L += ["_Nothing in flight._", ""]

    by_ms = {}
    for tid, t in st["tasks"].items():
        by_ms.setdefault(t["milestone"], []).append((tid, t))

    L += ["## Milestones", "", "| Milestone | Progress | Remaining |", "|---|---|---|"]
    for ms in sorted(by_ms):
        items = by_ms[ms]
        d = sum(1 for _, t in items if t["status"] == "done")
        bar = "█" * round(10 * d / len(items)) + "░" * (10 - round(10 * d / len(items)))
        L.append("| %s | `%s` %d/%d | %s |" % (ms, bar, d, len(items), len(items) - d))
    L.append("")

    active = [ms for ms in sorted(by_ms)
              if ms != FINDINGS_MILESTONE
              and any(t["status"] != "done" for _, t in by_ms[ms])]
    if active:
        ms = active[0]
        L += ["## %s — current milestone" % ms, "",
              "| | Task | Tier | Est | Status |", "|---|---|---|---|---|"]
        for tid, t in sorted(by_ms[ms], key=lambda x: task_sort_key(x[0])):
            # .get throughout, same reason as _roadmap_progress above: rendering the board is
            # inside save(), so one task missing one field does not fail to draw a row — it takes
            # down every command that writes state.
            mark = {"done": "✅", "in_flight": "🔵", "todo": "⬜",
                    "blocked": "🚧"}.get(t.get("status"), "⬜")
            L.append("| %s | **%s** %s | %s | %s | %s |"
                     % (mark, tid, t.get("title", ""), t.get("tier", "?"),
                        t.get("est", "—"), t.get("status", "todo")))
        L.append("")

    open_findings = sorted(
        ((tid, t) for tid, t in st["tasks"].items()
         if t["milestone"] == FINDINGS_MILESTONE and t["status"] != "done"),
        key=lambda x: task_sort_key(x[0]))
    if open_findings:
        L += ["## Open findings — claim by F-number", "",
              "| | Finding | Status |", "|---|---|---|"]
        for tid, t in open_findings:
            mark = {"in_flight": "🔵", "blocked": "🚧"}.get(t["status"], "⬜")
            L.append("| %s | **%s** %s | %s |" % (mark, tid, t["title"], t["status"]))
        L.append("")

    L += ["## Done", "",
          " ".join("`%s`" % tid for tid, t in
                   sorted(st["tasks"].items(), key=lambda x: task_sort_key(x[0]))
                   if t["status"] == "done") or "_Nothing yet._", ""]

    with open(BOARD, "w") as f:
        f.write("\n".join(L))


# ------------------------------------------------------- orchestration (D-036)
#
# Everything above this line is pull-based: an agent opens a chat, runs `start`, and picks something.
# That works, but it makes Sequoyah the scheduler — he opens every chat and is the one who notices
# when an account runs dry.
#
# Below is the push half. One director (Claude Max, Opus) routes tasks to three worker lanes, each
# pinned to its own paid account, and watches their quota. The director does not implement; it
# routes and verifies. See docs/ORCHESTRATION.md.

LANE_NAMES = ("LC1", "LC2", "LM", "LP")

# Tier → reasoning effort. T0 is mechanical, T1 is spec-following, T2 is the work where being wrong
# costs a rewrite. M1/M4 T2 tasks step up again in cmd_order.
TIER_EFFORT = {"T0": "low", "T1": "medium", "T2": "high"}


def _lock_holder(path):
    """Who holds a lock right now, phrased for someone staring at a stalled terminal."""
    try:
        with open(path) as f:
            d = json.load(f)
    except (IOError, ValueError):
        return "holder unknown"
    try:
        os.kill(int(d.get("pid")), 0)
    except (OSError, TypeError, ValueError):
        # Killed runs cannot clean up after themselves; flock already freed the lock itself.
        return "a stale holder record (pid %s is gone) — the lock itself is free" % d.get("pid", "?")
    since = ""
    try:
        held_for = age_hours(d.get("at", "")) * 3600.0
        since = " for %.0fs" % held_for if held_for >= 1 else ""
    except (TypeError, ValueError):
        pass
    return "held by %s (pid %s) running %s%s" % (d.get("agent", "?"), d.get("pid", "?"),
                                                 d.get("label", "?"), since)


@contextlib.contextmanager
def file_lock(name, timeout=600, label=None):
    """Serialise the two resources three concurrent lanes actually share.

    `godot` — one headless Godot at a time. Lanes share a single 42 MB import cache, and two engines
    reimporting it at once is the most plausible explanation for F-038's intermittent failures.
    `git`  — one index at a time. Three lanes running `ship` together means index.lock contention.
    """
    os.makedirs(LOCKS, exist_ok=True)
    path = os.path.join(LOCKS, "%s.lock" % name)
    held = os.path.join(LOCKS, "%s.holder" % name)
    began = time.time()
    waited = False
    with open(path, "w") as fh:
        deadline = time.time() + timeout
        heartbeat = 0.0
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                # A single dim "waiting" line, then silence for minutes, is indistinguishable from a
                # hang — and an agent that reads it as one stops mid-task. So: say who has it, and
                # keep saying that time is passing. F-086 died waiting on this lock believing
                # nothing was happening. Waiting is normal here; looking stalled is what is not.
                tick = time.time()          # NOT `now` — that shadows the module's now()
                if not waited:
                    print("%s· waiting for the %s lock — %s%s"
                          % (C["dim"], name, _lock_holder(held), C["x"]))
                    print("  %sthis is normal with several agents running; keep waiting, do not "
                          "background this%s" % (C["dim"], C["x"]))
                    waited, heartbeat = True, tick
                elif tick - heartbeat >= 30:
                    print("  %s· still waiting (%.0fs) — %s%s"
                          % (C["dim"], tick - began, _lock_holder(held), C["x"]))
                    heartbeat = tick
                if tick > deadline:
                    die("timed out after %ds waiting for the %s lock (%s). If nothing is running, "
                        "remove %s" % (timeout, name, _lock_holder(held),
                                       os.path.relpath(path, ROOT)))
                time.sleep(0.4)
        if waited:
            print("%s· got the %s lock after %.0fs%s" % (C["dim"], name, time.time() - began, C["x"]))
        try:
            with open(held, "w") as h:
                json.dump({"pid": os.getpid(), "agent": whoami(required=False, assign=False) or "?",
                           "label": label or name, "at": now()}, h)
        except (IOError, OSError):
            pass
        try:
            yield
        finally:
            try:
                os.remove(held)
            except OSError:
                pass
            fcntl.flock(fh, fcntl.LOCK_UN)


def with_lock(name, fn):
    """Wrap a command so it holds a lock for its whole run, without touching the command's body."""
    def wrapped(args):
        with file_lock(name):
            return fn(args)
    return wrapped


def _lane_state():
    try:
        with open(LANES_FILE) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def _plain(fn, args):
    """Capture a command's output with colour off — work orders are piped into another CLI as a
    prompt, and ANSI escapes in a prompt are just noise the model has to read past."""
    saved = dict(C)
    C.update({k: "" for k in C})
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            fn(args)
    finally:
        C.update(saved)
    return buf.getvalue()


STOPWORDS = {"the", "and", "for", "with", "from", "into", "that", "this", "not", "but", "its",
             "one", "two", "all", "any", "per", "run", "make", "add", "use", "when", "then",
             "than", "each", "only", "over", "under", "before", "after", "until", "does", "must"}


def _tokens(text):
    """Words worth matching on. Splits camelCase too, so `WorldEnvironment` in a task title can find
    environment_vfx_check.gd."""
    text = re.sub(r"([a-z])([A-Z])", r"\1 \2", text)
    return {w for w in re.findall(r"[a-z]{4,}", text.lower()) if w not in STOPWORDS}


def _suggest_check(tid, title):
    """Point the lane at the headless proof that already exists for its area.

    A task that ends with a check someone can re-run is a task the director can verify by reading
    one exit code instead of re-deriving the work. There are ~49 of these in tools/ already.

    Match on name parts, not substrings: 'cycle' must not select session_lifecycle_check."""
    words = _tokens(title)
    scored = []
    for path in sorted(glob.glob(os.path.join(ROOT, "tools", "*_check.gd"))):
        stem = os.path.basename(path)[:-3]
        parts = [p for p in stem.split("_") if p != "check"]
        hits = sum(1 for w in words
                   if any(p.startswith(w[:5]) or w.startswith(p[:5]) for p in parts))
        if hits >= 2:
            # One shared word is noise, not a match: "food items" picks item_icons_check, and
            # pointing a lane at the wrong proof is worse than admitting there isn't one — it will
            # run a green check and believe its work is verified.
            scored.append((-hits, "tools/%s.gd" % stem))
    scored.sort()
    return [p for _, p in scored[:3]]


SPECS = os.path.join(ROOT, "docs", "SPECS.md")


def _spec_body(tid):
    """This task's execution spec from docs/SPECS.md, if it has one.

    SPECS.md exists so a lane needs zero exploration, and an order that merely *points* at it makes
    the lane open and search a 34 KB file — which is exploration with extra steps. Inline the block."""
    if not os.path.exists(SPECS):
        return []
    out, capturing = [], False
    for line in open(SPECS):
        if line.startswith("## "):
            key = re.split(r"[ ·]", line[3:].strip())[0]
            if capturing:
                break
            capturing = (key == tid)
            if capturing:
                out.append(line.rstrip())
            continue
        if line.startswith("# ") and capturing:
            break
        if capturing:
            out.append(line.rstrip())
    while out and not out[-1].strip():
        out.pop()
    return out


def _spec_claims(spec):
    """The claim set the spec itself declares.

    SPECS.md blocks carry a `**Claim:** \\`a.gd\\`, \\`b.gd\\`` line, sometimes wrapped over two
    lines. That list is authoritative — it was written against the code — so it is a better default
    than whatever the director remembered to type. A mismatch here surfaces as a failed claim
    halfway through a dispatch, after the lane has already spent quota getting there."""
    text, capturing = [], False
    for line in spec:
        stripped = line.strip()
        if stripped.startswith("**Claim:**"):
            capturing = True
            text.append(stripped[len("**Claim:**"):])
            continue
        if capturing:
            # Keep consuming wrapped continuation lines, stop at the next field or a blank line.
            if not stripped or re.match(r"\*\*[A-Z]", stripped) or stripped.startswith(("-", "#")):
                break
            text.append(stripped)
    found = re.findall(r"`([^`]+)`", " ".join(text))
    return [f for f in found if "/" in f or f.endswith((".gd", ".godot", ".tres", ".tscn", ".cfg"))]


def _spec_verify(spec):
    """The checks the spec names, which beat guessing from the title.

    A spec's `Verify:` line names the checks that actually prove this task — including ones the task
    is meant to *write*. Keyword-matching against existing tools/ can only ever find checks that
    already exist, so for any task that adds one it points at the wrong file."""
    names = []
    for line in spec:
        stripped = line.strip()
        if stripped.startswith(("Verify:", "**Verify:**")):
            for tok in re.findall(r"`([^`]+)`", stripped):
                tok = tok.strip().replace("tools/", "").replace(".gd", "")
                if tok.endswith("_check") and tok not in names:
                    names.append(tok)
    return ["tools/%s.gd" % n for n in names]


def _order_path(tid):
    return os.path.join(ORDERS, "%s.md" % tid.replace("/", "_"))


def _open_orders():
    if not os.path.isdir(ORDERS):
        return {}
    out = {}
    for path in sorted(glob.glob(os.path.join(ORDERS, "*.md"))):
        tid = os.path.basename(path)[:-3]
        head = ""
        with open(path) as f:
            for line in f:
                if line.startswith("<!-- lane:"):
                    head = line.strip()
                    break
        def field(key, default="?"):
            m = re.search(r"%s:(\S+)" % key, head)
            return m.group(1) if m else default
        files = re.search(r"files:(.*?)-->", head)
        out[tid] = {
            "path": path,
            "lane": field("lane"),
            "model": field("model", ""),
            "effort": field("effort", ""),
            "files": [x for x in (files.group(1).split() if files else []) if x],
        }
    return out


ORDER_TEMPLATE = """<!-- lane:%(lane)s model:%(model)s effort:%(effort)s files:%(files)s -->
# Work order — %(tid)s  ·  lane %(lane)s  (%(account)s)

You are **%(lane)s**, one of three worker lanes on MIRE. Your agent name is `%(agent)s` and it is
already set in your environment, so every `agent` command you run files under it automatically.

Work autonomously and finish. **Do not stop to ask questions.** If the spec is ambiguous, decide it
the way `ARCHITECTURE.md` and `DECISIONS.md` point, record the call, and keep going — a
wrong-but-documented decision is cheap to reverse, and a stalled lane is not.

**You are headless. There is no next turn, and nobody will send you a notification.** If you end your
turn to "wait" for anything — a lock, a file, another agent — you do not resume; you simply stop,
mid-task, still holding your claims, and block every lane that needs those files. This has already
happened once (task 3.5 ended itself waiting on the Godot lock). So:

- **Blocking commands are fine — let them block.** `agent godot` waits for the shared engine lock and
  returns when it is free. That is normal; wait for it in-process rather than ending your turn.
- **Never background your verification and then wait to be told about it.** No `run_in_background`,
  no `Monitor`, no `&`, no "I will pick this up when it reports back" — the notification you are
  waiting for cannot be delivered, because there is no next turn to deliver it into. Run
  `agent godot` in the foreground and let it sit on the lock for as long as it takes; with five or
  six agents on this machine, minutes of waiting is normal and is not a failure. F-086 was lost
  exactly this way: it backgrounded its check, armed a monitor, said "I will pick back up as soon as
  it reports back", and stopped there with the whole build wiring uncommitted.
- If something is genuinely unavailable and you cannot proceed, **do not go quiet** — run
  `.agent/bin/agent handoff %(tid)s "..."` so your claims are released and the next agent knows where
  you stopped. Stopping silently is the one outcome worse than failing.

%(spec)s
## 1. Claim before your first edit

```bash
%(claim)s
```

If that fails, another lane holds a file you need. **Stop and run `.agent/bin/agent drop %(tid)s`** —
do not work around it. Two agents in one file is the failure this whole system exists to prevent.

## 2. Verify it yourself, headless — never ask a human to run it

```bash
%(verify)s
```

Always launch Godot through `agent godot`. It takes a lock so your run cannot collide with another
lane's; a bare `Godot --headless` can corrupt the shared import cache (F-038, F-044).

## 3. Before you close out: sweep for the same bug elsewhere

**A bug you just fixed is evidence about a class, not an incident.** Before writing the close-out,
grep the repo for the shape you just repaired — the same call, the same guard omission, the same
wrong assumption — and either fix the siblings under your claim or file them with the exact list.
This is the single most reliable source of new findings in this project, so a task that skips it is
usually manufacturing the next one:

- F-059 established the `has_peer()` guard; five later `rpc_id()` sites shipped without it, and 7.8
  found all five at once by auditing every call site instead of the one it tripped over.
- F-167 needed `sort_custom` for one `Array[StringName].sort()`; F-175 then found four more, two of
  them a determinism hazard in seeded world generation.
- F-168 fixed a host-only `EventBus` emit in `Wellspring`; F-181 is the *same bug in the same file*,
  in the sibling function, missed on the first pass.

The sweep is cheap — one `grep -rn` over `--include=*.gd` — and the alternative is that somebody
routes a whole dispatch at what you already had open in your editor.

## 4. Close out — this part is not optional

**Verify first, then write the docs — never the other way round.** Moving a finding to
`## Resolved`, or marking it `**fixed**`, is a claim that a check has *already passed*. The board
believes that claim: `agent start` derives a finding's done-ness from `docs/FINDINGS.md`, so a
finding you resolve before your check runs is reported as finished work whether or not it works. If
you then stop for any reason, nothing will ever be routed to it again. F-086 did this — resolved in
the doc, stalled before the check, and the board called it done with the work unverified on disk.

Everything the next agent needs goes **in the repo**, not in a closing message. Nobody reads your
final message; Sequoyah does not relay between tasks.

| What you have | Where it goes |
|---|---|
| A problem outside this task | `docs/FINDINGS.md`, next `F-0NN` |
| A call others must not relitigate | `docs/DECISIONS.md`, next `D-0NN` |
| An API or layout the next task builds on | `docs/DELEGATION.md` *Current state* |

Then, in order:

```bash
.agent/bin/agent done %(tid)s "what works, and the command that proves it"
.agent/bin/agent ship %(tid)s "%(tid)s: short imperative summary"
```

If you run out of quota or hit a wall, stop cleanly instead of thrashing:

```bash
.agent/bin/agent handoff %(tid)s "what works, what doesn't, what you'd decided, what's next"
```

## 4. Hard rules

- **Never edit `.tscn`/`.tres`/`.import`/`project.godot` unless this order's claim set names it**, and
  never while the Godot editor is open — ask with `.agent/bin/agent editor-running`, never a pgrep of
  your own: both pgreps people have written for this miss a real editor launch shape (F-045, F-120).
  D-021, D-031.
- **Never explore speculatively.** Read the four docs below, then the files this task touches. If you
  need one more file, name your best guess and read that one — do not grep the repo.
- **Never bulk-generate content data.** `.tres` items/recipes/powerups are hand-authored. Build the
  framework, not the content.
- **Every system declares its network authority** (`ARCHITECTURE.md` §2.2). Host-authoritative by
  default. There is no "multiplayer later" here.
- **Typed GDScript everywhere.** `snake_case` files/functions, `PascalCase` classes, `net_` prefix on
  networked functions, cross-system comms through `event_bus`, never `randi()` in world generation.

---

%(brief)s
"""


REVIEW_TEMPLATE = """<!-- lane:%(lane)s model:%(model)s effort:%(effort)s review:%(tid)s files: -->
# Review order — %(tid)s  ·  lane %(lane)s  (%(account)s)

You are **%(lane)s**, reviewing work another lane implemented. Your agent name is `%(agent)s`.

**You are not here to implement.** Do not edit source. Read the change, judge it against its spec,
and report. The one exception is `docs/FINDINGS.md`, where your findings belong.

## What to review

```bash
git log --oneline -8
git show --stat %(sha)s
git diff %(sha)s~1..%(sha)s
```

## Judge it against these, in order

1. **The spec** — the `%(tid)s` block in `docs/SPECS.md` is the contract. Does the change do what it
   says, including its acceptance criteria? Anything the spec called a trap — did they fall in it?
2. **Network authority** — every system declares its `ARCHITECTURE.md` §2.2 row. Host-authoritative
   by default; client-authoritative only for a player's own movement. A client that mutates shared
   state is a bug, not a style note.
3. **The four standing rules** in `docs/SPECS.md` — especially rule 1 (no bare autoload identifiers
   in anything a `--script` harness can reach), which has cost real sessions (F-011, F-046).
4. **Its own check** — run it, don't trust the commit message:
   ```bash
   %(verify)s
   ```
   Grep the output for `ERROR:` and treat any as failure even when the exit code is 0 (F-021).
5. **Determinism** — no `randi()` in world generation; seeded `RandomNumberGenerator` per subsystem.
6. **Typed GDScript**, `net_` prefix on networked functions, cross-system comms via `event_bus`.

## How to report

For each real problem, append to `docs/FINDINGS.md` as the next `F-0NN`, in that file's format
(**Area** / **Severity** / **Found**), naming the file and line and the concrete failure. Severity
per its table: `high` only if it ships broken, desyncs, or blocks a milestone.

**Be specific or say nothing.** "The netcode feels fragile" is unactionable and rots there forever.
If you cannot name a file and a concrete failure, you have a hunch — keep it.

If the change is sound, say so plainly and file nothing. A clean review is a real result.

Close out with:

```bash
.agent/bin/agent done %(tid)s-review "verdict, and the check output you actually saw"
.agent/bin/agent ship %(tid)s-review "Review %(tid)s: <verdict>"
```

---

%(brief)s
"""


def cmd_order(args):
    """Compose a self-contained work order for one task and park it for a lane.

    The order is generated, not hand-written. Hand-written prompts are what made Sequoyah the
    courier; anything a lane needs that isn't in here is a bug in the docs, not a missing prompt."""
    if not args:
        die('usage: agent order <task-id> [--lane LC1] [--files a.gd b.gd] [--verify "cmd"]')
    st = load()
    tid = _require_task(st, args[0], "order")
    t = st["tasks"][tid]

    lane = "?"
    files, verify = [], None
    model = effort = None
    if "--lane" in args:
        lane = args[args.index("--lane") + 1].upper()
        if lane not in LANE_NAMES:
            die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))
    if "--verify" in args:
        verify = args[args.index("--verify") + 1]
    if "--model" in args:
        model = args[args.index("--model") + 1]
    if "--effort" in args:
        effort = args[args.index("--effort") + 1]
    review = "--review" in args
    sha = args[args.index("--sha") + 1] if "--sha" in args else "HEAD"
    if "--files" in args:
        rest = args[args.index("--files") + 1:]
        for a in rest:
            if a.startswith("--"):
                break
            files.append(_rel(a))

    # A review reads a commit that already exists, so "already done" is its normal precondition —
    # blocking it there left the review lanes with nothing they could legally be pointed at, which
    # is how both ChatGPT accounts came to sit idle over a queue of finished, unreviewed work.
    if t["status"] == "done" and not review:
        die("%s is already done — check the journal before re-ordering it.\n"
            "  Reviewing it after the fact is fine:  agent order %s --lane <L> --review --sha <sha>"
            % (tid, tid))

    # Effort matters more than the model (AI-WORKFLOW.md §2a): reserve the expensive settings for
    # work that is expensive to get wrong, and let everything else run cheap. Tier already encodes
    # exactly that judgement, so derive from it rather than making the director remember.
    if not effort:
        effort = TIER_EFFORT.get(t.get("tier", "T1"), "medium")
        if t.get("milestone") in ("M1", "M4") and t.get("tier") == "T2":
            effort = "xhigh"      # netcode and world gen — the two rewrites we cannot afford

    spec = _spec_body(tid)
    from_spec = False
    if not files:
        files = [_rel(f) for f in _spec_claims(spec)]
        from_spec = bool(files)

    # A spec that claims project.godot only wants to register an autoload. Holding the file for the
    # whole task serialises every autoload-producing task against every other one (F-051), so drop it
    # from the claim set and let the lane use the locked `agent autoload` instead.
    autoload_only = "project.godot" in files
    if autoload_only:
        files = [f for f in files if f != "project.godot"]

    # A reviewer claims nothing — it reads a commit and writes findings, and the review template
    # says exactly that. But the claim set here is derived from the *reviewed* task's spec, so a
    # review was refused whenever some lane held those files — which is precisely when you want the
    # review. The 3.3 and 3.5 reviews were both refused over autoload/registry.gd, held by LP for
    # 3.1, leaving the review lane with nothing it was allowed to be given.
    if review:
        files = []

    # Never hand out two orders that fight. This is the single most important safety property once
    # three lanes run at once: the claim system catches a collision, but only after a lane has
    # already spent quota getting to its first edit.
    # A claim held by this same lane is not a conflict: one account runs one agent at a time, so its
    # queue is strictly sequential and the claim will be released before the next order starts. The
    # open-orders loop below already reasons this way; the live-claims check did not, so deepening a
    # lane's queue on the subsystem it was working was refused by its own in-flight claim — F-085 was
    # refused over autoload/build_service.gd, held by LP for F-084, the task immediately ahead of it.
    conflicts = [(f, st["claims"][f]) for f in files
                 if f in st["claims"] and st["claims"][f].get("agent") != lane.lower()]
    for f, c in conflicts:
        print("%s✗ %s is claimed by %s for %s%s" % (C["r"], f, c["agent"], c["task"], C["x"]))
    if conflicts:
        die("that claim set overlaps live work — order a different task")
    st_now = load()
    for other, meta in _open_orders().items():
        if other == tid or meta["lane"] == lane:
            # Same lane means sequential execution (`agent saturate`), so an overlapping claim set is
            # not a conflict — it is just the same lane touching the same file twice, in order.
            # Only cross-lane overlap can put two agents in one file at once.
            continue
        if st_now["tasks"].get(other.replace("-review", ""), {}).get("status") == "done":
            continue
        overlap = set(files) & set(meta["files"])
        if overlap:
            die("claim set overlaps the open order for %s (%s) on: %s"
                % (other, meta["lane"], ", ".join(sorted(overlap))))

    guarded = [f for f in files if f.endswith(EDITOR_GUARDED_SUFFIXES)
               or os.path.basename(f) in EDITOR_GUARDED_PATHS]
    if guarded and _godot_running():
        die("this order touches Godot-authored files (%s) and Godot is open. Close the editor first "
            "(D-021, D-031)." % ", ".join(guarded))

    # The spec knows; the title heuristic only guesses.
    checks = _spec_verify(spec) or _suggest_check(tid, t["title"])
    missing = [c for c in checks if not os.path.exists(os.path.join(ROOT, c))]
    if not verify:
        verify = ("\n".join(".agent/bin/agent godot --script %s" % c for c in checks)
                  if checks else
                  ".agent/bin/agent godot --quit-after 120   # no focused check exists yet — "
                  "write one in tools/ as part of this task")

    claim = ".agent/bin/agent claim %s%s" % (tid, (" " + " ".join(files)) if files else
                                             " <the files you will edit>")
    if autoload_only:
        claim += ("\n\n# Your spec lists project.godot. Do NOT claim it — registering an autoload is\n"
                  "# one locked, atomic append, and holding the file would block every other lane\n"
                  "# that needs one (F-051). When your script exists, run instead:\n"
                  ".agent/bin/agent autoload <Name> res://<path to your script>.gd")
    lanes = _lane_state()
    account = lanes.get(lane, {}).get("account", "unassigned")

    if spec:
        spec_block = ("## 0. Your spec — this is the work, and it assumes docs/SPECS.md's preamble\n\n"
                      "%s\n\n> Read `docs/SPECS.md`'s *four standing rules* and *Seams that already\n"
                      "> exist* before your first edit. They have already cost real sessions.\n"
                      % "\n".join(spec))
    else:
        spec_block = ("## 0. No spec block exists for %s in docs/SPECS.md\n\n"
                      "Write one as part of this task — SPECS.md says fixing a missing spec belongs to\n"
                      "the task that discovers it. Read its preamble and follow the shape of a\n"
                      "neighbouring block.\n" % tid)

    os.makedirs(ORDERS, exist_ok=True)
    if review:
        # A reviewer claims nothing: it reads a commit and writes findings. Claiming source would
        # block the lane that has to act on the review.
        #
        # F-070: the template mandates `agent done <id>-review` and `agent ship <id>-review`, but
        # nothing ever put that synthetic id in the registry, so every generated review ended with
        # two failing commands, no board entry, and no journal line — the verdict lived only in the
        # lane's log. Register it here, at the one place that invents the id. It also gives the
        # queue its retirement condition: an order whose task is done is skipped, where an
        # unregistered one is re-run on every drain for as long as the file exists.
        rid = "%s-review" % tid
        st_reg = load()
        if rid not in st_reg["tasks"]:
            st_reg["tasks"][rid] = {
                "title": "Review %s @ %s — judge the commit, file findings, no edits" % (tid, sha),
                "tier": "T1", "est": "0.5", "status": "todo",
                "milestone": t.get("milestone", ""), "review_of": tid,
            }
            save(st_reg)
        body = REVIEW_TEMPLATE % {
            "lane": lane, "account": account, "agent": lane.lower(), "tid": tid, "sha": sha,
            "model": model or lanes.get(lane, {}).get("model", "default"), "effort": effort,
            "verify": verify, "brief": _plain(cmd_brief, [tid]).strip(),
        }
        path = os.path.join(ORDERS, "%s-review.md" % tid.replace("/", "_"))
        with open(path, "w") as f:
            f.write(body)
        ok("review order written for %s → %s  (%s, effort %s)"
           % (tid, lane, model or lanes.get(lane, {}).get("model", "lane default"), effort))
        print("  %s%s · reviewing %s%s" % (C["dim"], os.path.relpath(path, ROOT), sha, C["x"]))
        print("\n  next:  %sagent dispatch %s %s-review%s" % (C["c"], lane, tid, C["x"]))
        return

    body = ORDER_TEMPLATE % {
        "lane": lane, "account": account, "agent": lane.lower(), "tid": tid,
        "files": " ".join(files), "claim": claim, "verify": verify, "spec": spec_block,
        "model": model or lanes.get(lane, {}).get("model", "default"), "effort": effort,
        "brief": _plain(cmd_brief, [tid]).strip(),
    }
    path = _order_path(tid)
    with open(path, "w") as f:
        f.write(body)

    ok("order written for %s → %s  (%s, effort %s)"
       % (tid, lane, model or lanes.get(lane, {}).get("model", "lane default"), effort))
    print("  %s%s%s" % (C["dim"], t["title"][:88], C["x"]))
    print("  %s%s · %d bytes%s" % (C["dim"], os.path.relpath(path, ROOT), len(body), C["x"]))
    if files:
        if from_spec:
            print("  %sclaim set taken from docs/SPECS.md%s" % (C["dim"], C["x"]))
        for f in files:
            print("  %s· %s%s" % (C["dim"], f, C["x"]))
    else:
        print("  %s⚠ no claim set: SPECS.md declares none and none was given, so the lane claims as "
              "it goes and collisions surface mid-dispatch rather than now%s" % (C["y"], C["x"]))
    for c in checks:
        note = " %s(this task writes it)%s" % (C["y"], C["x"]) if c in missing else ""
        print("  %sverify: %s%s%s" % (C["dim"], c, C["x"], note))
    if lane != "?":
        print("\n  next:  %sagent dispatch %s%s" % (C["c"], lane, C["x"]))


def cmd_dispatch(args):
    """Hand a lane its order and run it headlessly."""
    if not args:
        die("usage: agent dispatch <LANE> [task-id] [--dry-run]")
    lane = args[0].upper()
    if lane not in LANE_NAMES:
        die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))

    tid = None
    for a in args[1:]:
        if not a.startswith("--"):
            tid = a
            break
    if not tid:
        waiting = [k for k, v in _open_orders().items() if v["lane"] == lane]
        if not waiting:
            die("no open order for %s — run:  agent order <task-id> --lane %s" % (lane, lane))
        tid = waiting[0]

    if not os.path.exists(_order_path(tid)):
        die("no work order for %s — run:  agent order %s --lane %s" % (tid, tid, lane))

    argv = [LANE_BIN, "run", lane, tid] + [a for a in args[1:] if a.startswith("--")]
    return subprocess.call(argv, cwd=ROOT)


def cmd_saturate(args):
    """Run a lane's queued orders back to back until they run out or it hits a wall.

    The point is idle time, not throughput. A subscription window's unused tokens are gone at reset,
    so a lane sitting idle for two hours because nobody was watching has burned two hours of quota
    that cannot be recovered. This keeps the queue feeding it without a human in the loop.

    It stops on a hard wall (the lane parks itself and the remaining orders stay queued for the next
    window) and on a task that fails for any other reason, because chaining more work onto a broken
    lane just multiplies the mess."""
    if not args:
        die("usage: agent saturate <LANE> [task-id ...]\n"
            "  with no ids, runs every open order assigned to that lane")
    lane = args[0].upper()
    if lane not in LANE_NAMES:
        die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))

    watch = "--watch" in args
    detach = "--detach" in args
    wanted = [a for a in args[1:] if not a.startswith("--")]
    orders = _open_orders()
    drain = not wanted                    # no ids means "drain this lane", including later arrivals
    if not wanted:
        wanted = [t for t, m in sorted(orders.items()) if m["lane"] == lane]
    if not wanted:
        die("no open orders for %s — write some with:  agent order <id> --lane %s" % (lane, lane))

    if detach:
        _daemonise(lane)

    # Serialise chains on a lock rather than by polling for one another. The polling version
    # deadlocked: a wrapper shell whose script text contains "agent saturate LP" is itself matched by
    # `pgrep -f "agent saturate LP"`, so two chains each waited forever for the other AND themselves,
    # and the lane sat idle through a window it was supposed to be draining. A lock cannot match its
    # own name.
    with file_lock("saturate-%s" % lane.lower(), timeout=8 * 3600):
        return _saturate_locked(lane, wanted, watch, drain)


def _wait_for_lane_free(lane, limit=BUSY_WAIT_LIMIT):
    """Block until the lane's own process exits; False if it outlives the limit.

    Trust the pid over the status field, for the same reason `lane.busy_block` does: a status left
    'running' by a killed process must not park the queue forever."""
    deadline = time.time() + limit
    announced = False
    while time.time() < deadline:
        st = _lane_state().get(lane, {})
        pid = st.get("pid")
        if not pid:
            return True
        try:
            os.kill(pid, 0)
        except (OSError, TypeError):
            return True
        if not announced:
            print("  %s· %s is mid-task (%s, pid %s) — waiting, not dropping the queue%s"
                  % (C["dim"], lane, st.get("task", "?"), pid, C["x"]))
            announced = True
        time.sleep(20)
    return False


def _saturate_locked(lane, wanted, watch, drain=False):
    """Run the lane's queue to the end. Two things this has to get right, both learned expensively.

    **A busy lane is not a failed lane.** `lane run` refuses to put a second agent on one account,
    and a chain that read that refusal as a failure stopped dead and left every remaining order
    queued — while the lane worked on, finished, and sat idle waiting for a human who was not there.
    Busy is temporary: wait it out and carry on.

    **The queue is re-read as it goes, not snapshotted.** Orders written after a chain started used
    to wait for that chain to end, which is exactly the moment the lane goes idle."""
    done_ok, stopped = [], None
    seen, queue, busy_waits = [], list(wanted), {}
    while queue:
        tid = queue.pop(0)
        if tid not in seen:
            seen.append(tid)
        st = load()
        if st["tasks"].get(tid, {}).get("status") == "done":
            print("  %s· %s already done, skipping%s" % (C["dim"], tid, C["x"]))
        elif not os.path.exists(_order_path(tid)):
            print("  %s· no order for %s, skipping%s" % (C["dim"], tid, C["x"]))
        else:
            code = _run_with_resume(lane, tid, watch)
            if code == EX_LANE_BUSY:
                busy_waits[tid] = busy_waits.get(tid, 0) + 1
                if busy_waits[tid] <= MAX_BUSY_WAITS and _wait_for_lane_free(lane):
                    queue.insert(0, tid)   # re-judge it — it may have just been finished for us
                    continue
                stopped = tid
                break
            if code == 0:
                done_ok.append(tid)
            else:
                stopped = tid
                break
        if drain:
            for t, m in sorted(_open_orders().items()):
                if m["lane"] == lane and t not in seen and t not in queue:
                    queue.append(t)

    print()
    if done_ok:
        ok("%s completed: %s" % (lane, ", ".join(done_ok)))
    if stopped:
        print("%s· stopped at %s — the rest stay queued for the next window%s"
              % (C["y"], stopped, C["x"]))
        print("  %sagent collect%s to see why, then %sagent saturate %s%s to resume"
              % (C["c"], C["x"], C["c"], lane, C["x"]))
    elif not done_ok:
        print("  %snothing ran%s" % (C["dim"], C["x"]))
    return 0


MAX_RESUMES = 4
MAX_WAIT_HOURS = 8


def _daemonise(lane):
    """Detach from the session that launched us, so the queue outlives it.

    Chains started from a chat are children of that chat's process. When the session is killed — a
    crash, a hard stop, quitting the app — the whole process group goes with it, taking a running
    lane and its queue. That happened: a hard stop of the director killed the lanes mid-flight, which
    is the one failure the wrapper exists to be immune to.

    Double-fork + setsid so we reparent to init and survive anything that happens upstream. Output
    goes to a file, because after this there is no terminal to write to."""
    os.makedirs(os.path.join(AGENT_DIR, "logs"), exist_ok=True)
    out = os.path.join(AGENT_DIR, "logs", "saturate-%s.log" % lane.lower())
    if os.fork() > 0:
        print("%s· %s queue detached — it now survives this session. Follow it with:%s"
              % (C["dim"], lane, C["x"]))
        print("  tail -f %s" % os.path.relpath(out, ROOT))
        # os._exit skips the flush that a normal exit does, and stdout is block-buffered whenever it
        # is a pipe rather than a terminal — so piping `agent saturate --detach` anywhere printed
        # absolutely nothing and read exactly like a chain that had failed to start.
        sys.stdout.flush()
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_APPEND)
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    devnull = os.open(os.devnull, os.O_RDONLY)
    os.dup2(devnull, 0)


TRANSIENT_RETRY_SECONDS = 90     # long enough for a 5xx to clear, short enough not to waste a window

# Wording that means "the service failed", not "your task failed". Deliberately narrow: anything that
# might be the task's own fault must NOT match, or a broken task retries in a loop and burns a window.
TRANSIENT_PAT = re.compile(
    r"error 5\d\d\b|status\"?:\s*5\d\d|web server is down|bad gateway|service unavailable"
    r"|gateway time-?out|overloaded_error|server-side issue|internal server error"
    r"|connection (?:refused|reset)|temporarily unavailable", re.I)


def _looks_transient(err):
    """True when a lane's failure names itself an infrastructure problem rather than a task fault."""
    return bool(err and TRANSIENT_PAT.search(str(err)))


def _run_with_resume(lane, tid, watch):
    """Run one task, and with --watch, sleep out a short quota wall and pick it straight back up.

    The two windows do different jobs. The 5-hour session is the rate limiter — it fills fast and is
    what actually stops a lane. The weekly is the real budget, and it is the one that expires unspent.
    So sleeping through a 5-hour park is not patience, it is throwing away a window's worth of the
    weekly budget that cannot be recovered: to spend the weekly you have to be working during each
    session window.

    Only quota parks are resumed. A task that failed for any other reason is left alone, because
    retrying a broken task on a loop just burns the window it was waiting for."""
    for attempt in range(MAX_RESUMES + 1):
        code = subprocess.call([LANE_BIN, "run", lane, tid], cwd=ROOT)
        if code == 0 or not watch or attempt == MAX_RESUMES:
            return code

        state = _lane_state().get(lane, {})
        if state.get("status") != "exhausted":
            # An infrastructure blip is not a broken task. LM lost 6.1 twenty-three minutes and 12M
            # tokens in to `API Error: 521 — Web server is down`, which the CLI itself calls
            # temporary; the chain then stopped and the lane sat idle until a human noticed. Retrying
            # a genuinely broken task on a loop is still wrong, so this only retries errors that name
            # themselves transient, and only after a pause.
            if _looks_transient(state.get("last_error")):
                print("%s· %s hit a transient API error on %s — retrying in %ds%s"
                      % (C["y"], lane, tid, TRANSIENT_RETRY_SECONDS, C["x"]))
                time.sleep(TRANSIENT_RETRY_SECONDS)
                continue
            return code                       # a real failure, not a wall
        until = state.get("exhausted_until")
        try:
            resets = datetime.fromisoformat(until)
        except (TypeError, ValueError):
            return code
        if resets.tzinfo is None:
            resets = resets.replace(tzinfo=timezone.utc)
        wait = (resets - datetime.now(timezone.utc)).total_seconds()
        if wait <= 0 or wait > MAX_WAIT_HOURS * 3600:
            return code                       # already past, or too far out to sit on

        print("%s· %s parked until %s — sleeping %.1fh, then resuming %s%s"
              % (C["y"], lane, until, wait / 3600.0, tid, C["x"]))
        time.sleep(wait + 60)                 # a minute past the reset, so it is definitely open
        subprocess.call([LANE_BIN, "reset", lane], cwd=ROOT)
    return 1


def cmd_lanes(args):
    """Lane health. --doctor also checks each account's CLI and login."""
    if "--doctor" in args:
        return subprocess.call([LANE_BIN, "doctor"], cwd=ROOT)
    return subprocess.call([LANE_BIN, "status"], cwd=ROOT)


# The editor check, and the ONLY one (F-120). There used to be three: this function, plus a bare
# `pgrep -fl Godot` inside `cmd_check` (the pre-commit hook's own guard) and another inside
# `_stage_uid_sidecars`. The two blunt ones matched every headless check run, so the hook blocked
# commits that were never unsafe — and the way round a blocked commit is `--no-verify`, which also
# switches off the closed-editor rule the guard exists to enforce (JOURNAL, 2026-08-18: "I had to
# use --no-verify twice"). A safety check that cries wolf is a safety check people turn off.

# Positively the editor. `-e` is the short form of `--editor`, and it is the shape F-120 was filed
# about: `Godot --path <proj> -e res://levels/hollowmere.tscn` never contains the substring
# "--editor", so the pgrep AGENTS.md documented read a running editor as closed.
GODOT_EDITOR_FLAGS = ("--editor", "-e")
# Positively NOT the editor. The editor never takes any of these; `agent godot` always passes one of
# --headless or --script, so its own checks stop reading as an open editor.
GODOT_RUN_FLAGS = ("--headless", "--script", "--import", "--doctool", "--export-release",
                   "--export-debug", "--export-pack", "--validate-extension-api")


def _godot_process_kind(line):
    """Classify one `ps` line: "editor", "run", or None when it is not a Godot engine at all.

    Pure and line-at-a-time so tools/harness_check.py can drive every launch shape past it without
    a real engine — the reason the old version had no test is that it shelled out to `ps` itself.

    The order is deliberate and conservative:

    1. **An editor flag wins outright.** F-120's `-e res://scene.tscn` case.
    2. **A run flag, or a `--path` project run with no editor flag, is not the editor.** This is
       what keeps `agent godot`'s own checks out of it — including `--windowed` runs, which by
       design carry no `--headless` for the old check to match on (F-077), so every render check
       used to make `agent autoload` and `agent order` refuse while it ran.
    3. **Anything else that is the engine binary — most importantly a bare, argument-free launch —
       is the editor.** Double-clicking Godot.app and opening a project from the Project Manager
       leaves argv completely empty: observed 2026-08-18, pid 89993, no arguments, MIRE open and
       writing `.godot/editor/` five minutes after launch, and invisible to BOTH documented pgreps.
       So "no flags I recognise" cannot mean "safe". Wrong in this direction costs a false alarm;
       wrong in the other costs a corrupted .tscn, which is what D-031 exists to prevent.
    """
    if "Godot.app/Contents/MacOS/Godot" not in line and "/godot" not in line:
        return None
    if "grep" in line or "ps -Ao" in line:
        return None           # our own probe, or somebody searching for the engine
    tokens = line.split()
    if any(f in tokens for f in GODOT_EDITOR_FLAGS):
        return "editor"
    if any(f in tokens for f in GODOT_RUN_FLAGS):
        return "run"
    if "--path" in tokens:
        return "run"          # `Godot --path <proj>` with no editor flag runs the game
    return "editor"


def _godot_processes(lines=None):
    """[(pid, kind, command)] for every Godot engine process on this machine.

    `lines is None` after `_ps_lines()` failed means the check could not see. That is reported as a
    synthetic editor entry rather than as "nothing found": a safety check that cannot look must not
    answer "all clear". The old `_godot_running()` returned False there — it failed OPEN, while the
    two blunt inline checks it is replacing both failed closed.
    """
    if lines is None:
        lines = _ps_lines()
    if lines is None:
        return [("?", "editor", "<ps could not be run — assuming the editor is open>")]
    found = []
    for line in lines:
        kind = _godot_process_kind(line)
        if kind is None:
            continue
        parts = line.split(None, 1)
        found.append((parts[0] if parts else "?", kind, line.strip()))
    return found


def _ps_lines():
    """Every process line on this machine, or None if `ps` itself could not be run."""
    try:
        return subprocess.run(["ps", "-Ao", "pid,command"], capture_output=True,
                              text=True, timeout=10).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return None


def _godot_running():
    """True if the Godot *editor* is open. See `_godot_process_kind` for how that is decided."""
    return any(kind == "editor" for _pid, kind, _line in _godot_processes())


def cmd_editor_running(args):
    """Answer the question D-031 turns on, out of the same code every guard uses (F-120).

    Exit 0 when the editor is open, 1 when it is closed — the predicate convention, so
    `agent editor-running && echo unsafe` reads correctly. The printed verdict states which, so
    nobody has to remember the convention, and it lists the Godot processes it decided were NOT the
    editor, because "trust me" is what the old pgrep offered and it was wrong.
    """
    procs = _godot_processes()
    editors = [p for p in procs if p[1] == "editor"]
    others = [p for p in procs if p[1] != "editor"]
    if editors:
        print("%s✗ the Godot editor is OPEN%s" % (C["r"], C["x"]))
        for pid, _kind, line in editors:
            print("    pid %s  %s" % (pid, line))
        print("  Do not edit .tscn / .tres / .import / project.godot while it is open — the editor")
        print("  rewrites them on save and will silently discard your edit (D-031, D-021).")
    else:
        ok("the Godot editor is closed")
        print("  %sGodot-authored files are safe to edit under an exact claim (D-031).%s"
              % (C["dim"], C["x"]))
    for pid, _kind, line in others:
        print("  %s· pid %s is a check or game run, not the editor: %s%s"
              % (C["dim"], pid, line, C["x"]))
    return 0 if editors else 1


GODOT_CANDIDATES = (
    "/Applications/Godot.app/Contents/MacOS/Godot",
    "/usr/local/bin/godot",
    "/opt/homebrew/bin/godot",
)


# A windowed run parks a real OS window offscreen at 64x64: the engine needs a framebuffer to read
# back, but nobody needs to look at the window itself, and a SubViewport still renders at its own
# full size so captures are unaffected. These go FIRST among the caller's arguments so an explicit
# --resolution or --position of their own still wins — Godot takes the last occurrence.
GODOT_WINDOWED_ARGS = ("--resolution", "64x64", "--position", "2400,1400")


def _godot_argv(project_path, args):
    """Engine argv for a run against `project_path`, honouring the wrapper's own `--windowed`.

    F-077: this wrapper always injected `--headless`, and headless has no framebuffer, so every
    render check under `tools/` could only ever print "capture skipped" — on a project whose whole
    point is that agents verify their own work without opening the editor. `--windowed` drops the
    injection rather than relying on a later flag to override it, and is consumed here rather than
    passed on. The override trick still works for anything this does not cover: arguments are
    appended, so a trailing `--display-driver macos` beats an injected `--headless`.
    """
    rest = [a for a in args if a != "--windowed"]
    if len(rest) != len(list(args)):
        return [_godot_binary(), "--path", project_path] + list(GODOT_WINDOWED_ARGS) + rest
    return [_godot_binary(), "--headless", "--path", project_path] + rest


def _godot_binary():
    binary = os.environ.get("GODOT_BIN") or next(
        (p for p in GODOT_CANDIDATES if os.path.exists(p)), None)
    if not binary:
        die("no Godot binary found. Set GODOT_BIN, or install Godot.app.")
    return binary


# Gitignored, and a checkout is not runnable without them: the GodotSteam binaries are ~95 MB kept
# outside git (D-022), and `.godot` is the import cache that saves a from-scratch reimport. A
# baseline worktree missing either does not measure HEAD — it measures a broken project, which is
# worse than not asking. Both are cloned rather than symlinked: the cache is written during the run
# and a symlink would point two Godot processes at one cache, which is F-044 exactly; and a symlink
# named `godotsteam` does not match `.gitignore`'s `/addons/godotsteam/`, so it would show up as
# untracked inside the checkout and mislead anything that reads git status there.
BASELINE_GRAFTS = ("addons/godotsteam", ".godot")
# Whole directories are not enough. `*.import` is gitignored too — the sidecar Godot writes beside
# every .glb/.png, naming the file under `.godot/imported/` that the engine actually loads. Without
# them a checkout cannot resolve any `ext_resource` pointing at an imported asset, so every
# `content/items/*.tres` loads as null and reports "does not contain an ItemDef": a baseline that
# looks like the revision is broken when it is the graft that is. 547 files, 1.8 MB, walked directly
# because they sit beside their assets rather than in one place.
BASELINE_SIDECARS = ".import"
BASELINE_WALK_SKIP = {".git", ".godot", "addons", "node_modules"}


def _import_pass():
    """Force a full import scan before the caller's own run loads anything (F-093).

    `--script`/scene runs load whatever `.godot/imported/` already holds and never trigger an
    import themselves, so a check run right after an asset rebuild reads the *previous* build —
    and keeps doing so indefinitely, because re-running the same check changes nothing on disk.
    Measured against 84 rebuilt flora GLBs: three consecutive `--script` runs, three identical
    stale results. Only an import pass changes what's on disk, so every real run gets one first,
    unless the caller's own invocation already is one (`--import` in `args`, handled by the
    caller) — doubling up there would just cost a second engine boot for nothing.
    """
    import_argv = [_godot_binary(), "--headless", "--path", ROOT, "--import"]
    print("%s· %s%s" % (C["dim"], " ".join(import_argv[1:]), C["x"]))
    r = subprocess.run(import_argv, cwd=ROOT, capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if out:
        # Relayed rather than swallowed on purpose (F-104's lesson: a silent subprocess is
        # indistinguishable from a hung one, and this is also the only signal a test double like
        # fake-godot has to prove the pre-pass ran at all).
        print(out)
    if r.returncode != 0:
        print("%s⚠ pre-run import failed (%d) — the run below may still see a stale build%s"
              % (C["y"], r.returncode, C["x"]))


def cmd_godot(args):
    """Run Godot headless under a lock, so concurrent lanes cannot corrupt one import cache.

    Every headless verification in this project should go through here rather than calling Godot
    directly — see F-044. Usage mirrors the engine's: `agent godot --script tools/x_check.gd`.
    Add `--windowed` when the check captures PNGs; see `_godot_argv` (F-077)."""
    argv = _godot_argv(ROOT, args)
    script = next((a for a in args if a.endswith(".gd")), "godot")
    with file_lock("godot", timeout=1800, label=script):
        if "--import" not in args:
            _import_pass()
        # Everything but the binary: whether --headless was injected is exactly what F-077 was
        # about not being able to see.
        print("%s· %s%s" % (C["dim"], " ".join(argv[1:]), C["x"]))
        proc = subprocess.Popen(argv, cwd=ROOT, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, bufsize=0)
        fd = proc.stdout.fileno()
        blamed, buf, errored, hung = set(), b"", False, False
        spoke = time.time()
        while True:
            ready = select.select([fd], [], [], 5.0)[0]
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                buf += chunk
                parts = buf.split(b"\n")
                buf = parts.pop()
                for raw in parts:
                    line = raw.decode("utf-8", "replace")
                    # Relay it AND flush. Python block-buffers its own stdout whenever it is a pipe
                    # or a file, so relaying without this hides a running check's progress entirely
                    # and makes a hang look identical to a slow start — the very confusion F-104 is
                    # about.
                    print(line, flush=True)
                    if "SCRIPT ERROR" in line or "Parse Error" in line or "Compile Error" in line:
                        errored = True
                    m = re.search(r"res://(\S+?\.gd)", line)
                    if m and errored:
                        blamed.add(m.group(1))
                spoke = time.time()
            elif errored and proc.poll() is None and time.time() - spoke > SILENT_HANG_SECONDS:
                # F-104: a script that fails to compile never reaches quit(), so its SceneTree runs
                # forever — no output, no failure, holding the shared lock until a human notices. It
                # cost eight minutes the day it was found. Silence AFTER an error is conclusive.
                hung = True
                proc.kill()
                break
        if buf:
            print(buf.decode("utf-8", "replace"), flush=True)
        proc.stdout.close()
        code = proc.wait()
        if hung:
            print("\n%s✗ killed after %ds of silence following a script error — this run was never "
                  "going to finish%s" % (C["r"], SILENT_HANG_SECONDS, C["x"]))
            print("  %sA check whose script fails to compile never reaches quit(), so its SceneTree "
                  "runs forever and holds this lock (F-104).%s" % (C["dim"], C["x"]))
            print("  %sFix the parse error above. Reference new scripts with preload() rather than "
                  "a bare class_name — a class_name is invisible until the editor rescans.%s"
                  % (C["dim"], C["x"]))
            code = code or 1
        # NOT gated on the exit code: Godot exits 0 even when a script fails to load outright with a
        # parse error, which is precisely the failure this warns about. Measured — the same reason
        # every check in tools/ prints its own `failures=N` instead of trusting $?.
        if blamed:
            _blame_foreign_break(sorted(blamed))
        return code


def _blame_foreign_break(files):
    """Name the neighbour whose uncommitted work just broke your check.

    Every agent boots the project out of ONE shared working directory, so a script another agent is
    halfway through refactoring is a parse error in everybody's run. The failure reads as your own —
    it names a file, not a person — and the honest responses to it are both wrong: chase a bug you
    did not write, or edit a file somebody else holds. Say whose it is instead."""
    st = load()
    me = whoami(required=False, assign=False)
    me_token = whoami_token()
    for f in files:
        claim = st.get("claims", {}).get(f)
        if claim and _is_mine(claim, me, me_token):
            continue                      # your own claimed file — that break really is yours
        dirty = _git("status", "--porcelain", "--", f).stdout.strip()
        if not claim and not dirty:
            continue                      # committed and unclaimed: a real repo break, not a neighbour
        who = ("claimed by %s for %s" % (claim["agent"], claim["task"]) if claim
               else "uncommitted, and claimed by nobody")
        print("\n%s⚠ %s is broken in the shared working tree and it is not yours — %s%s"
              % (C["y"], f, who, C["x"]))
        print("  %sDo NOT edit it and do not chase this failure. Confirm it is theirs by running "
              "your check against a clean checkout:%s" % (C["dim"], C["x"]))
        print("  %sagent baseline --script <your check>%s" % (C["c"], C["x"]))


def cmd_baseline(args):
    """Run something against a pristine checkout of a revision, without touching the shared tree.

    F-080. Every lane eventually asks "did this already fail before my change?", and the obvious way
    to answer it — `git stash` — is repo-wide. Several agents share one working directory here, so a
    stash rips out everyone's uncommitted work at once; on 2026-08-17 it took five files belonging to
    task 2.1k plus an in-flight autoload, and the pop happening to succeed was luck, not safety. A
    throwaway worktree touches nobody: git checks the revision out somewhere else and the shared tree
    never changes.

      agent baseline --script tools/foo_check.gd        # the check, at HEAD
      agent baseline --rev 4aa5d43 --script tools/foo_check.gd
      agent baseline python3 tools/harness_check.py     # anything else, cwd = the checkout

    A leading `-` means engine arguments, same as `agent godot`; anything else is a command to run.
    """
    rest, rev, keep = list(args), "HEAD", False
    while rest:
        if rest[0] == "--rev" and len(rest) > 1:
            rev, rest = rest[1], rest[2:]
        elif rest[0] == "--keep":
            keep, rest = True, rest[1:]
        elif rest[0] == "--":
            rest = rest[1:]
            break
        else:
            break
    if not rest:
        die("usage: agent baseline [--rev <rev>] [--keep] "
            "<--script tools/x_check.gd | command ...>")

    r = _git("rev-parse", "--short", rev + "^{commit}")
    if r.returncode != 0:
        die("unknown revision '%s'" % rev)
    sha = r.stdout.strip()

    # The pid is in the name because two lanes asking "did this already fail?" about the same commit
    # at the same time is not unusual, and the cleanup below is a `worktree remove --force`. Sharing
    # a path would mean one lane deleting the other's checkout mid-run — the very thing F-080 is
    # about, reintroduced by the tool meant to fix it.
    wt = os.path.join(tempfile.gettempdir(), "mire-baseline-%s-%d" % (sha, os.getpid()))
    _git("worktree", "remove", "--force", wt)
    shutil.rmtree(wt, ignore_errors=True)
    _git("worktree", "prune")
    r = _git("worktree", "add", "--detach", "--quiet", wt, sha)
    if r.returncode != 0:
        die("could not check %s out into %s:\n%s" % (sha, wt, r.stderr.strip()))

    for rel in BASELINE_GRAFTS:
        src, dst = os.path.join(ROOT, rel), os.path.join(wt, rel)
        if not os.path.isdir(src):
            continue
        os.makedirs(dst, exist_ok=True)
        # Entry by entry, not "clone the directory unless it exists". `.gitignore` ignores `.godot/*`
        # but un-ignores `.godot/extension_list.cfg`, so a fresh checkout already HAS a `.godot`
        # holding exactly one file — and a skip-if-exists graft therefore silently grafted nothing,
        # leaving no global class cache. The symptom is a checkout where every `class_name` is
        # "not declared in the current scope", which reads like a broken revision rather than a
        # broken tool. Anything git already placed wins; it is the tracked version for this commit.
        for name in os.listdir(src):
            s2, d2 = os.path.join(src, name), os.path.join(dst, name)
            if os.path.exists(d2):
                continue
            # -c is APFS's copy-on-write clone: ~190 MB grafted for no disk and no wait, and a real
            # copy the moment either side writes — the property that keeps the two caches apart.
            if subprocess.run(["cp", "-Rc", s2, d2], capture_output=True).returncode != 0:
                if os.path.isdir(s2):
                    shutil.copytree(s2, d2, symlinks=True, dirs_exist_ok=True)
                else:
                    shutil.copy2(s2, d2)

    for rel in _sidecar_paths():
        src, dst = os.path.join(ROOT, rel), os.path.join(wt, rel)
        if os.path.exists(dst) or not os.path.isdir(os.path.dirname(dst)):
            continue           # not tracked at this revision — the sidecar means nothing here
        shutil.copy2(src, dst)

    print("%s· %s at %s%s" % (C["dim"], wt, sha, C["x"]))
    try:
        if rest[0].startswith("-"):
            # Deliberately NOT under the shared `godot` lock. That lock exists for one thing —
            # concurrent runs corrupting one import cache (F-044) — and this run has its own cache
            # in its own worktree, so the hazard is absent. Taking it anyway would put "did this
            # already fail?" behind whatever long check a lane happens to be running, which is the
            # moment you most want the answer; that is not hypothetical, it is what happened the
            # first time this was tried. The cost is a second engine process on the machine, and a
            # clone taken mid-write by another run at worst re-imports one asset.
            code = subprocess.call(_godot_argv(wt, rest), cwd=wt)
        else:
            code = subprocess.call(rest, cwd=wt)
    except FileNotFoundError as e:
        _baseline_clean(wt, keep)
        die("could not run %s: %s" % (rest[0], e))
    except KeyboardInterrupt:
        _baseline_clean(wt, keep)
        raise
    _baseline_clean(wt, keep)
    return code


def _sidecar_paths():
    """Every gitignored `*.import` under the tree, repo-relative."""
    out = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in BASELINE_WALK_SKIP]
        for name in filenames:
            if name.endswith(BASELINE_SIDECARS):
                out.append(os.path.relpath(os.path.join(dirpath, name), ROOT))
    return out


def _baseline_clean(wt, keep):
    if keep:
        print("%s· kept: %s  (remove with: git worktree remove --force %s)%s"
              % (C["dim"], wt, wt, C["x"]))
        return
    _git("worktree", "remove", "--force", wt)
    shutil.rmtree(wt, ignore_errors=True)
    _git("worktree", "prune")


def cmd_autoload(args):
    """Register one autoload in project.godot, atomically, without claiming the file for a whole task.

    D-021 is right that a task shipping an autoload must register it — a script nothing loads is not
    shipped. But holding `project.godot` for the task's whole duration serialises every autoload-
    producing task against every other one, and five upcoming specs (2.11, 2.12, 2.13, 3.3, 3.6) each
    claim it. That would collapse three lanes back to one for most of M2 and M3 (F-051).

    A registration is one appended line. So take a short lock, verify the editor is closed, append,
    release — seconds instead of an hour, and the claim is never needed. Idempotent, and append-only
    per D-019: existing lines are never reordered or rewritten."""
    if len(args) < 2:
        die('usage: agent autoload <Name> <res://path/to/script.gd>\n'
            '  e.g. agent autoload DayNight res://systems/environment/day_night.gd')
    name, path = args[0], args[1]
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
        die("'%s' is not a valid autoload name — PascalCase identifier, no spaces" % name)
    if not path.startswith("res://"):
        path = "res://" + path.lstrip("/")
    target = os.path.join(ROOT, path[len("res://"):])
    if not os.path.exists(target):
        die("%s does not exist — write the script before registering it" % path)

    with file_lock("project", timeout=300):
        if _godot_running():
            die("the Godot editor is open. It rewrites project.godot on save and will silently "
                "discard this edit (D-021). Close it and re-run.")
        with open(PROJECT_GODOT) as f:
            lines = f.read().splitlines()

        entry = '%s="*%s"' % (name, path)
        for line in lines:
            stripped = line.strip()
            if stripped == entry:
                ok("%s is already registered" % name)
                return 0
            if stripped.startswith("%s=" % name):
                die("%s is already registered as a different path:\n  %s\n"
                    "Append-only (D-019) — resolve this by hand." % (name, stripped))

        # Append at the END of [autoload]. Order is load order, and a new autoload must not be
        # inserted ahead of one that already exists and might be its dependency.
        try:
            start = next(i for i, l in enumerate(lines) if l.strip() == "[autoload]")
        except StopIteration:
            lines += ["", "[autoload]", "", entry]
        else:
            end = len(lines)
            for i in range(start + 1, len(lines)):
                if lines[i].strip().startswith("[") and lines[i].strip().endswith("]"):
                    end = i
                    break
            while end > start + 1 and not lines[end - 1].strip():
                end -= 1
            lines.insert(end, entry)

        tmp = PROJECT_GODOT + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, PROJECT_GODOT)

    ok("registered %s" % entry)
    print("  %sverify it loads:  agent godot --quit-after 5%s" % (C["dim"], C["x"]))
    return 0


FINDINGS = os.path.join(ROOT, "docs", "FINDINGS.md")


def cmd_finding(args):
    """Allocate the next F-number and append the entry, atomically.

    `docs/` is deliberately unclaimed (F-006) so no lane ever blocks on it — but that also means two
    lanes filing at the same moment both read the same "next number" from `agent brief` and both use
    it. It has already happened four times: F-012, F-052, F-055 and F-056 each exist twice, and a
    duplicate id is worse than a missing one because `agent brief F-055` then briefs the wrong bug.

    Reading the number and writing the entry has to be one operation under one lock. Body comes from
    stdin so it can be as long as it needs to be without fighting the shell."""
    if not args:
        die('usage: agent finding "Short statement of the problem" '
            '[--area netcode] [--severity medium]\n'
            '  the body is read from stdin:  agent finding "..." <<\'EOF\' ... EOF')
    title = args[0]
    area = args[args.index("--area") + 1] if "--area" in args else "?"
    severity = args[args.index("--severity") + 1] if "--severity" in args else "medium"
    if severity not in ("high", "medium", "low"):
        die("severity must be high, medium or low (see the table in docs/FINDINGS.md)")
    body = "" if sys.stdin.isatty() else sys.stdin.read().strip()
    if not body:
        die("no body on stdin. Be specific or don't file — name a file and a concrete failure.")

    me = whoami()
    with file_lock("findings", timeout=300):
        with open(FINDINGS) as f:
            text = f.read()
        used = {int(n) for n in re.findall(r"^### F-(\d{3})", text, re.M)}
        nxt = max(used) + 1 if used else 1
        fid = "F-%03d" % nxt

        entry = ("### %s · %s\n\n**Area:** %s · **Severity:** %s · **Found:** %s by %s\n\n%s\n\n---\n\n"
                 % (fid, title, area, severity, now()[:10], me, body))
        marker = "\n## Resolved\n"
        if marker in text:
            text = text.replace(marker, "\n" + entry + "## Resolved\n", 1)
        else:
            text = text.rstrip() + "\n\n" + entry
        tmp = FINDINGS + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, FINDINGS)

    ok("filed %s — %s" % (fid, title[:70]))


def cmd_resolve(args):
    """Move a finding from '## Open' to '## Resolved', with the resolution note read from stdin.

    The mirror of `agent finding`, and it exists because the move is the half of a finding's life
    that had no command — so every agent hand-rolled the slice, and the natural way to write it is
    wrong in exactly one case (F-134). "From this heading to the next '### F-' heading" swallows the
    '## Resolved' heading itself whenever the finding being moved is the LAST entry under '## Open',
    because the next '### F-' is then the first entry inside '## Resolved'. Writing the remainder
    back deletes the section boundary, and every resolved finding in the file silently becomes open.

    It has happened twice: `89fea39` ate F-112's heading (which is the whole of F-131), and
    `9505cfd` ate '## Resolved' itself, flipping 121 resolved findings to open in one commit.

    So the bound here is `min(next '### F-' heading, index of '## Resolved')`, never the heading
    alone — and the failure modes are refusals rather than writes.
    """
    if not args:
        die('usage: agent resolve <F-NNN>\n'
            "  the resolution note is read from stdin:  agent resolve F-013 <<'EOF' ... EOF\n"
            "  Say what you did AND how you verified it — the note is the whole point of the move.")
    fid = _norm_id(args[0])
    if not _is_finding(fid):
        die("%s is not a finding id — this moves a section of docs/FINDINGS.md, nothing else." % fid)
    note = "" if sys.stdin.isatty() else sys.stdin.read().strip()
    if not note:
        die("no resolution note on stdin. A finding moved with no account of what fixed it and how\n"
            "  it was verified is worse than one left open — the next agent cannot tell either way.")

    me = whoami()
    with file_lock("findings", timeout=300):
        with open(FINDINGS) as f:
            text = f.read()

        marker = "\n## Resolved\n"
        if marker not in text:
            die("docs/FINDINGS.md has no '## Resolved' heading — the file is already damaged, and\n"
                "  appending to it would hide that. Restore the heading first, then re-run\n"
                "  (`agent godot --script tools/findings_numbering_check.gd` will confirm). F-134.")
        resolved_at = text.index(marker)

        head = "### %s · " % fid
        start = text.find(head)
        if start < 0:
            die("%s is not in docs/FINDINGS.md at all." % fid)
        if start > resolved_at:
            die("%s is already under '## Resolved'. Nothing to move." % fid)

        # THE bound. `find` returns -1 when there is no later finding heading at all, and -1 would
        # slice from the end — so a missing heading has to fall through to the section boundary
        # rather than being used as an offset. This is the line F-134 is about.
        nxt = text.find("\n### F-", start + len(head))
        end = resolved_at if (nxt < 0 or nxt > resolved_at) else nxt
        was_last_open = end == resolved_at

        body = text[start:end].rstrip("\n")
        if was_last_open:
            # It was the last entry under '## Open'. Every entry is written as
            # "### F-NNN ...\n\n<body>\n\n---\n\n", so the '---' this one carried goes with it —
            # and the text before it already ends with the PREVIOUS entry's separator, which is what
            # divides the section from the heading. Adding another would double it.
            body = body.rstrip("\n")
            if body.endswith("---"):
                body = body[:-3].rstrip("\n")
            text = text[:start].rstrip("\n") + "\n\n" + text[end:].lstrip("\n")
        else:
            text = text[:start] + text[end:].lstrip("\n")
        resolved_at = text.index(marker)   # the splice above moved it

        title_line, _, remainder = body.partition("\n")
        if not title_line.rstrip().endswith("**fixed**"):
            title_line = title_line.rstrip() + " — **fixed**"
        entry = "%s\n%s\n\n**Resolved %s by %s.** %s\n" % (
            title_line, remainder.rstrip("\n"), now()[:10], me, note)

        i = text.index(marker) + len(marker)
        text = text[:i] + "\n" + entry + text[i:]

        tmp = FINDINGS + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, FINDINGS)

    ok("%s moved to '## Resolved'" % fid)
    print("  %sRun the structure check before you commit — it is what caught both times this went"
          % C["dim"])
    print("  wrong:  agent godot --script tools/findings_numbering_check.gd%s" % C["x"])
    print("  %sdocs/FINDINGS.md · claim it later with:  agent brief %s%s" % (C["dim"], fid, C["x"]))
    return 0


def _done_without_closeout(st):
    """Tasks the board calls done whose newest journal entry is a handoff.

    `agent done` and `agent handoff` both write the journal, so the newest entry for a task is what
    actually happened to it last. A finding-task can still go `done` without one — `_sync_findings`
    derives that from docs/FINDINGS.md — which is exactly how an abandoned task acquires a finished
    board entry."""
    last = {}
    for e in _journal_entries():          # oldest first, so the last write wins
        last[e["task"]] = e["kind"]
    return [t for t, kind in sorted(last.items())
            if kind == "handoff" and st["tasks"].get(t, {}).get("status") == "done"]


CHAT_STALE_REPORT_HOURS = 4.0


def _session_last_seen(claim, sessions):
    """(idle_hours, certain) for the session holding this claim.

    Prefers the claim's own session token (F-147 put it there), which is unambiguous. Without one,
    the only handle is the agent name — and names collide (F-145), so the freshest session wearing
    that name may be a completely different chat. Guessing there would report a live task as
    abandoned and, under `--stale`, free a working session's files. So an ambiguous name returns
    certain=False: the age is still shown, but it is the age of the claim itself, and `--stale`
    refuses to act on it."""
    tok = claim.get("token")
    if tok:
        rec = sessions.get(tok)
        if isinstance(rec, dict):
            return age_hours(rec.get("seen") or rec.get("at", "")), True
        # A token that is no longer in sessions.json has been pruned — that session is long gone.
        return age_hours(claim.get("at", "")), True

    same = [r for r in sessions.values()
            if isinstance(r, dict) and r.get("name") == claim.get("agent")]
    if len(same) == 1:
        return age_hours(same[0].get("seen") or same[0].get("at", "")), True
    return age_hours(claim.get("at", "")), False


def cmd_reap(args):
    """Release claims held by a lane whose process is gone, and surface chats that look abandoned.

    A lane killed hard — closed laptop, OOM, a hung CLI — leaves its claims behind, and every other
    lane that needs those files is blocked behind a corpse. `lane run` files a handoff on any exit
    it survives to see; this is the backstop for the exits it doesn't.

    A chat cannot be judged the same way: it has no pid, only the `seen` heartbeat whoami() writes,
    and it can be legitimately idle for hours while its human is at lunch with real uncommitted edits
    in the tree. Releasing a claim does not remove those edits, it removes the protection around them
    (F-186). So chats are only ever *reported* here unless `--stale <hours>` explicitly asks."""
    stale_hours = float(args[args.index("--stale") + 1]) if "--stale" in args else None
    st = load()
    sessions = _load_sessions()
    lanes = _lane_state()
    lane_agents = {n.lower() for n in LANE_NAMES}
    alive = {}
    for name, lane in lanes.items():
        pid = lane.get("pid")
        if pid:
            try:
                os.kill(pid, 0)
                alive[name.lower()] = pid
            except (OSError, TypeError):
                pass

    freed, tasks = [], set()
    for path, claim in list(st["claims"].items()):
        holder = claim["agent"]
        if holder in lane_agents and holder not in alive:
            del st["claims"][path]
            freed.append((path, holder, claim["task"]))
            tasks.add(claim["task"])

    for tid in list(st["in_flight"]):
        entry = st["in_flight"][tid]
        if entry["agent"] in lane_agents and entry["agent"] not in alive:
            del st["in_flight"][tid]
            if st["tasks"].get(tid, {}).get("status") == "in_flight":
                st["tasks"][tid]["status"] = "todo"
            tasks.add(tid)

    # Chat-held claims, grouped by task, with how long that session has been silent.
    chat = {}
    for path, claim in st["claims"].items():
        if claim["agent"] in lane_agents:
            continue
        idle, certain = _session_last_seen(claim, sessions)
        rec = chat.setdefault(claim["task"],
                              {"agent": claim["agent"], "idle": idle, "certain": True, "files": []})
        rec["files"].append(path)
        rec["idle"] = max(rec["idle"], idle)
        rec["certain"] = rec["certain"] and certain

    threshold = stale_hours if stale_hours is not None else CHAT_STALE_REPORT_HOURS
    stale = {t: r for t, r in chat.items() if r["idle"] >= threshold}

    if stale_hours is not None:
        for tid, rec in list(stale.items()):
            if not rec["certain"]:
                # Name shared by more than one session — we cannot tell which one holds this, and
                # freeing a live chat's files is worse than leaving a dead one's held.
                continue
            for path in rec["files"]:
                st["claims"].pop(path, None)
                freed.append((path, rec["agent"], tid))
            st["in_flight"].pop(tid, None)
            if st["tasks"].get(tid, {}).get("status") == "in_flight":
                st["tasks"][tid]["status"] = "todo"
            tasks.add(tid)

    if freed or tasks:
        save(st)
        ok("reaped %d claim(s) across %d task(s)" % (len(freed), len(tasks)))
        for path, holder, tid in freed:
            print("  %s· %s (was %s, %s)%s" % (C["dim"], path, holder, tid, C["x"]))
        print("  %sthose tasks are back on the board — re-order them when a lane frees up%s"
              % (C["dim"], C["x"]))
    else:
        ok("nothing to reap — no lane is holding claims it shouldn't")
        if alive:
            print("  %slive: %s%s" % (C["dim"], ", ".join(sorted(alive)), C["x"]))

    if stale and stale_hours is None:
        print("\n%s⚠ %d chat task(s) silent for %gh or more, still holding claims%s"
              % (C["y"], len(stale), threshold, C["x"]))
        for tid, rec in sorted(stale.items(), key=lambda kv: -kv[1]["idle"]):
            note = "" if rec["certain"] else " · NAME SHARED, cannot attribute — will not auto-free"
            print("  %s %s · %s · %.1fh silent · %d file(s)%s%s"
                  % (C["y"], tid, rec["agent"], rec["idle"], len(rec["files"]), note, C["x"]))
            for path in sorted(rec["files"]):
                print("      %s· %s%s" % (C["dim"], path, C["x"]))
        print("  %sthe session may simply be idle — its uncommitted edits are still in the tree.%s"
              % (C["dim"], C["x"]))
        print("  %scheck with the human, then:  agent reap --stale %g%s"
              % (C["dim"], threshold, C["x"]))


def _git_since(hours):
    try:
        out = subprocess.run(
            ["git", "log", "--since=%d hours ago" % hours, "--pretty=%h\t%an\t%s"],
            cwd=ROOT, capture_output=True, text=True, timeout=20).stdout
        return [l.split("\t", 2) for l in out.strip().splitlines() if l]
    except (OSError, subprocess.SubprocessError):
        return []


def cmd_collect(args):
    """What came back from the lanes: what shipped, what stopped, what needs the director."""
    hours = int(args[args.index("--hours") + 1]) if "--hours" in args else 24
    st = load()
    lanes = _lane_state()
    lane_agents = {n.lower() for n in LANE_NAMES}

    print("\n%sCollected — last %dh%s" % (C["b"], hours, C["x"]))

    entries = [e for e in _journal_entries() if age_hours(e.get("at", "")) < hours]
    shipped = [e for e in entries if e["kind"] == "done"]
    stopped = [e for e in entries if e["kind"] == "handoff"]

    if shipped:
        print("\n%sFinished%s" % (C["g"], C["x"]))
        for e in shipped:
            who = e["agent"]
            tag = " %s(lane)%s" % (C["c"], C["x"]) if who in lane_agents else ""
            print("  %s✓%s %-7s %s%s" % (C["g"], C["x"], e["task"], who, tag))
            for line in e["body"][1:3]:
                if line.strip():
                    print("      %s%s%s" % (C["dim"], line.strip()[:96], C["x"]))

    if stopped:
        print("\n%sStopped mid-task — needs a decision%s" % (C["y"], C["x"]))
        for e in stopped:
            print("  %s◐%s %-7s %s" % (C["y"], C["x"], e["task"], e["agent"]))
            for line in e["body"][1:4]:
                if line.strip():
                    print("      %s%s%s" % (C["dim"], line.strip()[:96], C["x"]))

    broken = [(n, l) for n, l in lanes.items() if l.get("status") in ("error", "exhausted")]
    if broken:
        print("\n%sLanes needing attention%s" % (C["r"], C["x"]))
        for name, lane in sorted(broken):
            why = ("quota, resets %s" % lane.get("exhausted_until")
                   if lane["status"] == "exhausted" else "error")
            print("  %s%s%s %s — %s" % (C["r"], name, C["x"], lane["account"], why))
            if lane.get("last_error"):
                first = lane["last_error"].strip().splitlines()[-1][:96]
                print("      %s%s%s" % (C["dim"], first, C["x"]))

    commits = _git_since(hours)
    if commits:
        print("\n%sCommits%s" % (C["b"], C["x"]))
        for sha, who, subject in commits[:12]:
            print("  %s%s%s %-9s %s" % (C["dim"], sha, C["x"], who[:9], subject[:74]))

    if not (shipped or stopped or broken or commits):
        print("  %snothing came back in the last %dh%s" % (C["dim"], hours, C["x"]))
    print()


def cmd_report(args):
    """One screen: who is doing what, what it cost, what's waiting, what's stuck.

    This is the director's answer to 'keep me informed' — Sequoyah reads this instead of watching
    three terminals."""
    st = load()
    lanes = _lane_state()
    orders = _open_orders()

    total_in = sum(l.get("tokens_in", 0) for l in lanes.values())
    total_out = sum(l.get("tokens_out", 0) for l in lanes.values())
    total_cost = sum(l.get("cost_usd", 0.0) for l in lanes.values())
    # Findings are deliberately outside the milestone count, so filing one never moves the roadmap
    # number (AGENTS.md). Count the same way the board does or the two disagree on screen.
    roadmap = {k: v for k, v in st["tasks"].items() if not _is_finding(k)}
    done = sum(1 for t in roadmap.values() if t["status"] == "done")
    open_findings = sum(1 for k, v in st["tasks"].items()
                        if _is_finding(k) and v["status"] != "done")

    print("\n%sMIRE — orchestration report%s   %s%s%s"
          % (C["b"], C["x"], C["dim"], now()[:16].replace("T", " "), C["x"]))
    print("%s%d/%d tasks done · %d open findings · %s tokens this window · ~$%.2f api-equiv%s"
          % (C["dim"], done, len(roadmap), open_findings,
             f"{total_in + total_out:,}", total_cost, C["x"]))
    print("%ssubscription lanes — nothing is billed; api-equiv is a proxy for window consumed%s"
          % (C["dim"], C["x"]))

    print("\n%sLanes%s" % (C["b"], C["x"]))
    print("  %s%-5s %-18s %-9s %11s %9s %s%s"
          % (C["dim"], "lane", "account", "status", "tokens", "api-equiv", "runs/fail", C["x"]))
    for name in LANE_NAMES:
        lane = lanes.get(name)
        if not lane:
            print("  %-5s %s(not configured — run .agent/bin/setup-lanes)%s"
                  % (name, C["dim"], C["x"]))
            continue
        used = lane.get("tokens_in", 0) + lane.get("tokens_out", 0)
        colour = {"idle": C["g"], "running": C["c"],
                  "exhausted": C["y"], "error": C["r"]}.get(lane["status"], "")
        print("  %s%-5s%s %-18s %s%-9s%s %11s %9s %d/%d"
              % (C["b"], name, C["x"], lane["account"][:18], colour, lane["status"], C["x"],
                 f"{used:,}", "$%.2f" % lane.get("cost_usd", 0.0),
                 lane.get("runs", 0), lane.get("failures", 0)))
        if lane.get("task"):
            print("        %s▶ %s since %s%s"
                  % (C["c"], lane["task"], (lane.get("started") or "")[11:16], C["x"]))
        if lane.get("exhausted_until"):
            print("        %s◐ parked until %s%s" % (C["y"], lane["exhausted_until"], C["x"]))
        for wname, w in sorted((lane.get("quota_windows") or {}).items()):
            if w.get("used_pct") is not None:
                bar = "█" * (w["used_pct"] // 10) + "░" * (10 - w["used_pct"] // 10)
                print("        %s%-10s %s %3d%%  resets %s%s"
                      % (C["dim"], wname, bar, w["used_pct"],
                         (w.get("resets_at") or "?")[11:16], C["x"]))
        budget = lane.get("budget_tokens")
        if budget:
            print("        %s%d%% of window budget%s" % (C["dim"], 100 * used // budget, C["x"]))

    if st["in_flight"]:
        print("\n%sIn flight%s" % (C["b"], C["x"]))
        for tid, e in sorted(st["in_flight"].items()):
            hrs = age_hours(e["started"])
            warn = " %s(stale)%s" % (C["y"], C["x"]) if hrs > STALE_HOURS else ""
            print("  %-7s %-9s %.1fh%s  %s%s%s"
                  % (tid, e["agent"], hrs, warn, C["dim"],
                     st["tasks"].get(tid, {}).get("title", "")[:56], C["x"]))

    queued = {k: v for k, v in orders.items()
              if st["tasks"].get(k, {}).get("status") != "done" and k not in st["in_flight"]}
    if queued:
        print("\n%sOrders waiting%s" % (C["b"], C["x"]))
        for tid, meta in sorted(queued.items()):
            print("  %-7s → %-4s %s%s%s"
                  % (tid, meta["lane"], C["dim"],
                     st["tasks"].get(tid, {}).get("title", "")[:60], C["x"]))

    # A task whose last journal word was a handoff, but which the board calls done, is the most
    # dangerous state this system can reach: it reads as finished work and nothing will ever be
    # routed to it again. F-086 got there — the lane wrote its docs close-out (moving the finding to
    # '## Resolved', marked **fixed**) BEFORE running the check that would justify the word, then
    # stalled on the shared Godot lock and never verified. `_sync_findings` reads the doc, so the
    # finding went done on the strength of a claim nobody had tested. Trust a DONE entry, not a doc.
    for tid in _done_without_closeout(st):
        print("\n%s⚠ %s is marked done but its last journal entry is a HANDOFF — no close-out ever "
              "ran%s" % (C["y"], tid, C["x"]))
        print("  %sits work may be unverified and on disk. Read the handoff, verify it yourself, "
              "then close it honestly or reopen it.%s" % (C["dim"], C["x"]))

    blocked = []
    for name in LANE_NAMES:
        lane = lanes.get(name)
        if lane and lane.get("status") in ("exhausted", "error"):
            blocked.append(name)
        elif lane and lane.get("consecutive_failures", 0) >= 3:
            blocked.append(name)
    print("\n%s%s%s" % (
        C["y"] if blocked else C["g"],
        ("⚠ %s unavailable — route around %s" % (", ".join(blocked),
                                                 "them" if len(blocked) > 1 else "it"))
        if blocked else "✓ all lanes available",
        C["x"]))
    print()


# ---------------------------------------------------------------- main

COMMANDS = {
    "start": cmd_start, "brief": cmd_brief, "claim": cmd_claim, "note": cmd_note,
    "done": cmd_done, "handoff": cmd_handoff, "drop": cmd_drop, "check": cmd_check,
    "board": cmd_board, "sync": cmd_sync,
    # Three lanes running `ship` at once means three processes in one git index. Serialising it
    # costs nothing and removes a whole class of confusing failures.
    "ship": with_lock("git", cmd_ship),
    # Orchestration (D-036)
    "order": cmd_order, "dispatch": cmd_dispatch, "lanes": cmd_lanes,
    "collect": cmd_collect, "report": cmd_report, "reap": cmd_reap, "godot": cmd_godot,
    "saturate": cmd_saturate, "finding": cmd_finding,
    "baseline": cmd_baseline,
    "autoload": cmd_autoload,
    "editor-running": cmd_editor_running,
    "reopen": cmd_reopen,
    "resolve": cmd_resolve,
}

USAGE = """agent — multi-agent coordination for MIRE

  agent start                     begin a session (named from this chat automatically)
  agent brief <id>                everything you need to start that task
  agent board                     show what's happening
  agent claim <id> [files...]     claim a task and the files you'll edit
  agent note <id> "..."           record something mid-task
  agent done <id> ["summary"]     finish: release claims, write journal
  agent ship <id> ["message"]     commit THIS TASK's files + push, print the sign-off
  agent handoff <id> "..."        stop mid-task: what's left, what to watch out for
  agent drop <id>                 abandon a task, release claims
  agent reopen <id> "why"         a finding marked done that was never resolved — status
                                  correction, journalled (F-131). Not for new work: file that
  agent check                     verify changes respect claims (pre-commit hook)
  agent sync                      re-read tasks from docs/ROADMAP.md

Verifying — always launch the engine through this, never bare (F-044):

  agent godot --script tools/x_check.gd     headless Godot, under a lock
  agent godot --windowed --script x.gd      same, with a framebuffer — render checks that save
                                            PNGs need this; the window parks offscreen (F-077)
  agent baseline --script tools/x_check.gd  the same check at HEAD, in a throwaway worktree —
                                            "did this already fail?" without `git stash` (F-080)
  agent autoload <Name> <res://path.gd>     register an autoload atomically — no claim needed
  agent editor-running                      is the Godot editor open? the one check every guard
                                            uses (F-120) — exit 0 open, 1 closed. Never hand-roll
                                            a pgrep for this; both shapes people wrote miss a real
                                            editor launch
  agent finding "title" [--area] [--severity]  file a finding; body on stdin, number allocated safely
  agent resolve <F-NNN>                     move it to '## Resolved'; note on stdin. Use this
                                            rather than editing the file — the hand-rolled slice
                                            has eaten the section heading twice (F-134)

Directing three worker accounts (docs/ORCHESTRATION.md):

  agent order <id> --lane LC1 --files ...   write a self-contained work order
  agent order <id> --lane LC1 --review     review order: judge a commit, file findings, no edits
  agent dispatch <LANE> [id] [--dry-run]    run that order on its account, headless
  agent saturate <LANE> [ids...] [--watch] run its queued orders back to back — no idle window
                                           --watch sleeps out a short quota wall and resumes
                                           --detach survives this session being killed
  agent lanes [--doctor]                    lane health; --doctor checks CLI + login
  agent report                              who's doing what, what it cost, what's stuck
  agent collect [--hours N]                 what shipped, what stopped, what needs you
  agent reap                                free claims from lanes whose process died

Protocol: AGENTS.md    Board: .agent/BOARD.md    History: .agent/JOURNAL.md"""


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die("unknown command '%s'\n\n%s" % (cmd, USAGE))
    # Every invocation is proof this chat is alive, so the beat goes here rather than in whoami():
    # `board`, `reap` and the read-only commands never resolve a name, and a session that only reads
    # would have looked abandoned (F-186).
    _beat()
    # Propagate the command's exit code. `agent godot` wraps a check whose failure MUST be visible to
    # whoever ran it — a lane that reads exit 0 from a failing check will ship a broken change and
    # report it verified. Commands that return None (all the original ones) still exit 0.
    sys.exit(COMMANDS[cmd](sys.argv[2:]) or 0)


if __name__ == "__main__":
    main()
