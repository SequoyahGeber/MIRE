#!/usr/bin/env python3
"""
agent — multi-agent coordination for MIRE.

Shared state so Claude Code, Codex, and the human can hand work off cleanly.
State lives in .agent/state.json; humans and agents read .agent/BOARD.md.

Deliberately small and dependency-free. If it annoys you, edit it.
"""

import binascii
import contextlib
import fcntl
import glob
import io
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
AGENT_DIR = os.path.join(ROOT, ".agent")
STATE = os.path.join(AGENT_DIR, "state.json")
BOARD = os.path.join(AGENT_DIR, "BOARD.md")
JOURNAL = os.path.join(AGENT_DIR, "JOURNAL.md")
SESSION = os.path.join(AGENT_DIR, "session")
SESSIONS = os.path.join(AGENT_DIR, "sessions.json")
ROADMAP = os.path.join(ROOT, "docs", "ROADMAP.md")
# Orchestration (D-036): the director prepares orders here, lanes execute them, locks keep three
# concurrent lanes from colliding on the two things they genuinely share.
ORDERS = os.path.join(AGENT_DIR, "orders")
LOCKS = os.path.join(AGENT_DIR, "locks")
LANE_BIN = os.path.join(AGENT_DIR, "bin", "lane")
LANES_FILE = os.path.join(AGENT_DIR, "lanes.json")
PROJECT_GODOT = os.path.join(ROOT, "project.godot")

STALE_HOURS = 12

# Godot-authored files require an exact claim and a closed editor (D-031).
EDITOR_GUARDED_SUFFIXES = (".tscn", ".tres", ".import", ".godot")
EDITOR_GUARDED_PATHS = ("project.godot", "export_presets.cfg")
# Always safe for anyone to edit.
FREE_PREFIXES = ("docs/", ".agent/", "CLAUDE.md", "AGENTS.md", "README.md", ".gitignore")
# Engine-generated sidecars. Godot writes .uid files next to every script; they are not authored
# by anyone and claiming them would be noise.
GENERATED_SUFFIXES = (".uid",)

C = {
    "b": "\033[1m", "dim": "\033[2m", "r": "\033[31m", "g": "\033[32m",
    "y": "\033[33m", "c": "\033[36m", "x": "\033[0m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}


# ---------------------------------------------------------------- state io

def now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def age_hours(iso):
    try:
        then = datetime.fromisoformat(iso)
    except ValueError:
        return 0.0
    return (datetime.now(timezone.utc) - then).total_seconds() / 3600.0


def load():
    if not os.path.exists(STATE):
        return {"version": 1, "tasks": {}, "in_flight": {}, "claims": {}}
    with open(STATE) as f:
        return json.load(f)


RECENT_GRACE_HOURS = 6


def save(st):
    os.makedirs(AGENT_DIR, exist_ok=True)
    recent = st.get("recent")
    if recent:
        st["recent"] = {f: d for f, d in recent.items()
                        if age_hours(d.get("at", now())) < 24}
    with open(STATE, "w") as f:
        json.dump(st, f, indent=2, sort_keys=True)
        f.write("\n")
    render_board(st)


# ---------------------------------------------------------------- identity

# Nobody should have to name an agent. The old scheme — one name in .agent/session, overridden by
# MIRE_AGENT on every single command — put that chore on Sequoyah and failed silently when skipped
# (F-007): a second chat overwrote the file and its claims landed under the first chat's name.
#
# Identity is now derived from the chat itself. Every tool call from one chat carries the same
# session id in its environment, and a git hook inherits it too, so the name is stable across a whole
# session including commits, and two chats cannot collide because their tokens differ.
SESSION_ENV_KEYS = (
    "MIRE_SESSION",             # manual override, mostly for testing
    "CLAUDE_CODE_SESSION_ID",   # Claude Code, one per chat
    "CODEX_SESSION_ID",         # Codex, if it sets one
    "CODEX_THREAD_ID",
    "TERM_SESSION_ID",          # a human's terminal tab
)

# Short, unlike each other at a glance, and not words that appear in this codebase — a name has to be
# scannable in a board full of file paths.
AUTO_NAMES = (
    "ash", "bram", "cinder", "dusk", "ember", "flint", "gale", "hollow", "ivy", "kiln",
    "larch", "moss", "nettle", "onyx", "pike", "quill", "reed", "slate", "tine", "vane",
    "wick", "yarrow", "birch", "coil",
)

SESSION_KEEP_DAYS = 14


def _session_token():
    for key in SESSION_ENV_KEYS:
        value = os.environ.get(key, "").strip()
        if value:
            return "%s:%s" % (key, value)
    return None


def _load_sessions():
    try:
        with open(SESSIONS) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (IOError, ValueError):
        return {}


def _save_sessions(data):
    # Machine-local and gitignored: this maps chat ids to names, which means nothing on another
    # machine and would produce a diff on every command if it were tracked.
    tmp = SESSIONS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, SESSIONS)


def _prune_sessions(data):
    fresh = {}
    for token, rec in data.items():
        if isinstance(rec, dict) and age_hours(rec.get("at", "")) < SESSION_KEEP_DAYS * 24:
            fresh[token] = rec
    return fresh


def _auto_name(token, taken):
    """Deterministic from the token, so the same chat gets the same name every call — including from
    a git hook, which is a different process with the same environment. crc32, not hash(): Python
    randomizes string hashing per process, which would hand one chat a new name every command."""
    start = binascii.crc32(token.encode()) % len(AUTO_NAMES)
    for offset in range(len(AUTO_NAMES)):
        candidate = AUTO_NAMES[(start + offset) % len(AUTO_NAMES)]
        if candidate not in taken:
            return candidate
    return "%s%d" % (AUTO_NAMES[start], start)


def _register(token, name):
    data = _prune_sessions(_load_sessions())
    data[token] = {"name": name, "at": now()}
    _save_sessions(data)
    return name


def whoami(required=True, assign=True):
    """Resolve this chat's agent name, assigning one on first use.

    Order: an explicit MIRE_AGENT, then this chat's registered name, then the legacy single-name
    file (a human's terminal, or a shell with no session id at all), then a fresh auto-name."""
    env_name = os.environ.get("MIRE_AGENT", "").strip().lower()
    if env_name:
        return env_name

    token = _session_token()
    sessions = _load_sessions()
    if token and token in sessions:
        return sessions[token]["name"]

    legacy = ""
    if os.path.exists(SESSION):
        legacy = open(SESSION).read().strip()

    if token and assign:
        # A name already in use by another live chat is not reusable — that is the collision the
        # whole scheme exists to prevent.
        taken = {rec["name"] for rec in _prune_sessions(sessions).values()
                 if isinstance(rec, dict)}
        taken.add(legacy)
        return _register(token, _auto_name(token, taken))

    if legacy:
        return legacy
    if required:
        die("no session id in the environment and no name set.\n"
            "  Run 'agent start' (it will name you), or set MIRE_AGENT=<name>.")
    return None


def die(msg):
    print("%s✗ %s%s" % (C["r"], msg, C["x"]))
    sys.exit(1)


def ok(msg):
    print("%s✓%s %s" % (C["g"], C["x"], msg))


def task_sort_key(tid):
    if _is_finding(tid):
        # After every roadmap task, in filed order. Findings are work, but they are not the
        # milestone plan, and sorting them into it would reorder the plan every time one is filed.
        try:
            return (1000, int(tid.split("-")[1]))
        except (IndexError, ValueError):
            return (1000, 999)
    try:
        a, b = tid.split(".")
        return (int(a), int(b))
    except ValueError:
        return (999, 999)


# ---------------------------------------------------------------- findings as work (F-015)

# Findings are the work most likely to happen BETWEEN roadmap tasks, and until F-015 they had no
# claimable id at all — so fixing one always meant editing unclaimed files and being warned at for
# it. A warning that fires during correct work is how agents learn to ignore it. So an F-number is
# a task id everywhere a task id is accepted: claim, brief, note, done, handoff, drop, ship.
FINDINGS_MILESTONE = "Findings"


def _is_finding(tid):
    return tid.upper().startswith("F-")


def _norm_id(tid):
    return tid.upper() if _is_finding(tid) else tid


def _sync_findings(st):
    """Mirror docs/FINDINGS.md's open section into tasks. Same shape as cmd_sync's roadmap pass:
    adds and refreshes titles, and never downgrades a status — but a finding that has LEFT '## Open'
    while still marked todo gets marked done (F-049). FINDINGS.md is the source of truth for what is
    open; before this, a finding resolved without `agent done` (F-027 sat that way for a day) stayed
    on the board as claimable work forever, and once a director routes off the board that is a
    dispatch waiting to happen. Journal entries are append-only and unaffected by status."""
    added = 0
    open_ids = set()
    for fid, title in _open_findings():
        open_ids.add(fid)
        title = title or fid
        if fid in st["tasks"]:
            st["tasks"][fid]["title"] = title
        else:
            st["tasks"][fid] = {
                "title": title, "tier": "F", "est": "—",
                "milestone": FINDINGS_MILESTONE, "status": "todo",
            }
            added += 1
    for fid, t in st["tasks"].items():
        if (t.get("milestone") == FINDINGS_MILESTONE and t.get("status") == "todo"
                and fid not in open_ids):
            t["status"] = "done"
    return added


def _require_task(st, tid, verb="that"):
    """Resolve a task id, syncing findings on demand so an F-number never has to be pre-registered.
    Returns the canonical id; exits with a message that names the right file otherwise."""
    tid = _norm_id(tid)
    if tid in st["tasks"]:
        return tid
    if _is_finding(tid):
        if _sync_findings(st):
            save(st)
        if tid in st["tasks"]:
            return tid
        die("unknown finding %s — it is not under '## Open' in docs/FINDINGS.md.\n"
            "  A resolved finding is not claimable; file a new one if there is more to do." % tid)
    die("unknown task %s — run 'agent sync' or check docs/ROADMAP.md.\n"
        "  Fixing a finding? Use its F-number directly: agent %s F-013" % (tid, verb))


# ---------------------------------------------------------------- roadmap sync

def cmd_sync(args):
    """Parse docs/ROADMAP.md task tables into state. Safe to re-run — never
    overwrites status, only adds new tasks and refreshes titles."""
    if not os.path.exists(ROADMAP):
        die("docs/ROADMAP.md not found")

    st = load()
    milestone = "?"
    added = updated = 0

    for line in open(ROADMAP):
        line = line.strip()
        if line.startswith("## M"):
            milestone = line[3:].split("·")[0].strip()
            continue
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) < 4:
            continue
        tid = cells[0]
        if not tid or not tid[0].isdigit() or "." not in tid:
            continue
        title = cells[1].replace("**", "")
        tier = cells[2]
        est = cells[3]
        if tid in st["tasks"]:
            t = st["tasks"][tid]
            if t.get("title") != title or t.get("tier") != tier:
                t.update({"title": title, "tier": tier, "est": est, "milestone": milestone})
                updated += 1
        else:
            st["tasks"][tid] = {
                "title": title, "tier": tier, "est": est,
                "milestone": milestone, "status": "todo",
            }
            added += 1

    findings = _sync_findings(st)
    save(st)
    ok("roadmap synced — %d new, %d updated, %d total" % (added, updated, len(st["tasks"])))
    if findings:
        print("  %s+%d open finding(s) from docs/FINDINGS.md, claimable by F-number%s"
              % (C["dim"], findings, C["x"]))


# ---------------------------------------------------------------- session

def cmd_start(args):
    """`agent start` takes no argument now. A name is derived from the chat's own session id, so
    parallel agents get distinct names with nobody having to think about it."""
    token = _session_token()
    if args:
        # An explicit name still works — a human wanting to be 'sequoyah' on the board, or a script.
        name = args[0].strip().lower()
        if token:
            _register(token, name)
        else:
            with open(SESSION, "w") as f:
                f.write(name + "\n")
    else:
        if not token and not os.environ.get("MIRE_AGENT"):
            die("no session id in this environment, so a name cannot be derived.\n"
                "  Run:  agent start <your-name>")
        name = whoami()
    st = load()
    # The board a session starts from must reflect FINDINGS.md as it is NOW — new findings filed
    # since the last sync, and any resolved out-of-band, both surface here (F-049).
    _sync_findings(st)
    save(st)

    print("\n%s%s session started%s\n" % (C["b"], name, C["x"]))
    if name not in ("sequoyah", "human"):
        print("  %sYou may edit Godot files under exact claims, but only while Godot is closed (D-031).%s"
              % (C["dim"], C["x"]))
    if os.environ.get("MIRE_AGENT", "").strip().lower() not in ("", name):
        print("  %s⚠ MIRE_AGENT=%s is set and overrides this — you are acting as '%s'.%s"
              % (C["y"], os.environ["MIRE_AGENT"], os.environ["MIRE_AGENT"].strip().lower(), C["x"]))
    elif token:
        print("  %sName derived from this chat's session id — it is yours for the whole session,"
              " commits included. No MIRE_AGENT prefix needed.%s" % (C["dim"], C["x"]))
    _print_board(st, focus=name)
    _print_stale(st)
    _print_git()
    print("  %sGiven only a task id? That is enough:%s  agent brief <task-id>" % (C["dim"], C["x"]))
    print("  %sClaim before you edit:%s  agent claim <task-id> <files...>\n" % (C["dim"], C["x"]))


def _print_git():
    try:
        out = subprocess.run(["git", "status", "--porcelain"], cwd=ROOT,
                             capture_output=True, text=True).stdout.strip()
        log = subprocess.run(["git", "log", "--oneline", "-5"], cwd=ROOT,
                             capture_output=True, text=True).stdout.strip()
    except Exception:
        return
    print("%sRecent commits%s" % (C["b"], C["x"]))
    for l in log.splitlines():
        print("  %s" % l)
    if out:
        n = len(out.splitlines())
        print("\n  %s⚠ %d uncommitted file(s) — someone stopped mid-task%s" % (C["y"], n, C["x"]))
    print()


def _print_stale(st):
    stale = [(t, d) for t, d in st["in_flight"].items()
             if age_hours(d.get("started", now())) > STALE_HOURS]
    if not stale:
        return
    print("%s%sStale (>%dh, likely abandoned)%s" % (C["y"], C["b"], STALE_HOURS, C["x"]))
    for tid, d in sorted(stale, key=lambda x: task_sort_key(x[0])):
        print("  %s  %s  %.0fh — release with:  agent drop %s"
              % (tid, d["agent"], age_hours(d["started"]), tid))
    print()


# ---------------------------------------------------------------- brief

def _journal_entries():
    """JOURNAL.md parsed into entries, oldest first. Written by _journal(), so the
    header shape is ours: '### KIND · task · agent · timestamp'."""
    if not os.path.exists(JOURNAL):
        return []
    entries, cur = [], None
    for line in open(JOURNAL):
        if line.startswith("### "):
            parts = [p.strip() for p in line[4:].strip().split("·")]
            cur = None
            if len(parts) >= 4:
                cur = {"kind": parts[0], "task": parts[1], "agent": parts[2], "body": []}
                entries.append(cur)
            continue
        if cur is not None and line.strip():
            cur["body"].append(line.rstrip())
    return entries


def _open_findings():
    """(id, title) for every finding under '## Open'. The template example under
    'How to file one' sits above that heading, so it is skipped for free."""
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return []
    out, in_open = [], False
    for line in open(path):
        if line.startswith("## "):
            in_open = line.strip() == "## Open"
        elif in_open and line.startswith("### F-"):
            fid, _, title = line[4:].strip().partition("·")
            out.append((fid.strip(), title.strip()))
    return out


def _finding_body(fid):
    """The prose of one open finding, so `agent brief F-013` is self-contained — the whole point of
    brief is that the agent does not have to go reading to find out what it was asked to do."""
    path = os.path.join(ROOT, "docs", "FINDINGS.md")
    if not os.path.exists(path):
        return []
    out, in_open, in_this = [], False, False
    for line in open(path):
        if line.startswith("## "):
            if in_this:
                break
            in_open = line.strip() == "## Open"
        elif line.startswith("### "):
            if in_this:
                break
            in_this = in_open and line[4:].strip().upper().startswith(fid.upper())
        elif in_this:
            out.append(line.rstrip())
    while out and not out[0].strip():
        out.pop(0)
    while out and (not out[-1].strip() or out[-1].strip() == "---"):
        out.pop()
    return out


def _wrap(text, width=94, indent="      "):
    words, line, out = text.split(), "", []
    for w in words:
        if len(line) + len(w) + 1 > width:
            out.append(indent + line)
            line = w
        else:
            line = (line + " " + w).strip()
    if line:
        out.append(indent + line)
    return out


def cmd_brief(args):
    """Everything needed to start a task, in one call.

    This exists so that "start task 1.6" is a complete instruction. Before it, the
    context lived in hand-written prompts that a human pasted in, which made him the
    courier between agents and made every task cost a prompt-writing session first."""
    st = load()
    if not args:
        print("usage: agent brief <task-id>\n")
        _print_ready(st)
        return
    tid = _require_task(st, args[0], "brief")

    me = whoami(required=False) or "?"
    t = st["tasks"][tid]
    print("\n%s%s · %s%s" % (C["b"], tid, t["title"], C["x"]))
    print("  %s%s · tier %s · est %s · status %s%s"
          % (C["dim"], t.get("milestone", "?"), t.get("tier", "?"),
             t.get("est", "?"), t["status"], C["x"]))

    held = st["in_flight"].get(tid)
    if held and held["agent"] != me:
        print("\n  %s⚠ already in flight under '%s' since %s — pick another task%s"
              % (C["y"], held["agent"], held["started"][:16].replace("T", " "), C["x"]))
    if t["status"] == "done":
        print("\n  %s⚠ already done (%s by %s) — check the journal below before redoing it%s"
              % (C["y"], t.get("done_at", "?")[:10], t.get("done_by", "?"), C["x"]))

    # Read these, in this order. Bounded on purpose: this list is the alternative to
    # exploring, which is the most expensive thing an agent does here.
    print("\n%sRead first%s" % (C["b"], C["x"]))
    for path, why in (
        ("AGENTS.md", "the protocol — claim, record, close out"),
        ("docs/ARCHITECTURE.md §2.2", "the authority table. Your system declares a row of it"),
        ("docs/DELEGATION.md", "'Current state' — what shipped, and the APIs you build against"),
        ("docs/DECISIONS.md", "settled calls. Check before relitigating one"),
    ):
        print("  %-32s %s%s%s" % (path, C["dim"], why, C["x"]))

    if _is_finding(tid):
        body = _finding_body(tid)
        if body:
            print("\n%sThe finding, in full — this is the spec%s" % (C["b"], C["x"]))
            for line in body:
                print("  %s%s%s" % (C["dim"], line[:110], C["x"]))
            print("\n  %sClosing it means the fix AND moving the section to '## Resolved' in"
                  " docs/FINDINGS.md,%s" % (C["dim"], C["x"]))
            print("  %swith what you did and how you verified it. A fix nobody can find is not"
                  " closed.%s" % (C["dim"], C["x"]))

    findings = [(fid, title) for fid, title in _open_findings() if fid != tid]
    if findings:
        print("\n%sOther open findings — traps someone already paid for%s" % (C["b"], C["x"]))
        for fid, title in findings:
            print("  %-8s %s%s%s" % (fid, C["dim"], title[:78], C["x"]))

    entries = _journal_entries()
    mine_hist = [e for e in entries if e["task"] == tid]
    milestone = t.get("milestone", "")
    siblings = [e for e in entries
                if e["task"] != tid
                and st["tasks"].get(e["task"], {}).get("milestone") == milestone][-4:]

    if mine_hist:
        print("\n%sThis task has history — read it before starting over%s" % (C["y"], C["x"]))
        for e in mine_hist:
            print("  %s%s by %s%s" % (C["b"], e["kind"], e["agent"], C["x"]))
            for line in e["body"][1:6]:
                print("      %s%s%s" % (C["dim"], line[:100], C["x"]))

    if siblings:
        print("\n%sRecent work in %s — what it left you%s" % (C["b"], milestone, C["x"]))
        for e in siblings:
            print("  %s%s · %s · %s%s" % (C["b"], e["kind"], e["task"], e["agent"], C["x"]))
            notes = [l for l in e["body"] if l.startswith("- ")]
            for n in notes[:4]:
                for line in _wrap(n[2:]):
                    print("    %s%s%s" % (C["dim"], line[4:], C["x"]))
            if not notes and len(e["body"]) > 1:
                for line in _wrap(" ".join(e["body"][1:3]))[:2]:
                    print("    %s%s%s" % (C["dim"], line[4:], C["x"]))

    others = {f: c for f, c in st["claims"].items() if c["agent"] != me}
    if others:
        print("\n%sHeld by someone else right now — do not edit%s" % (C["b"], C["x"]))
        for f, c in sorted(others.items()):
            print("  %-52s %s%s (%s)%s" % (f, C["dim"], c["agent"], c["task"], C["x"]))

    print("""
%sHow this task ends%s — all of it yours, none of it Sequoyah's to relay:
  1. %sagent claim %s <files>%s      before the first edit
  2. %sagent note %s "..."%s        each trap or decision, as you hit it
  3. anything outside this task  ->  docs/FINDINGS.md (next F-number)
     a settled call others must not relitigate  ->  docs/DECISIONS.md
     an API or layout the next task builds on  ->  docs/DELEGATION.md 'Current state'
  4. %sagent done %s "..."%s then %sagent ship %s "msg"%s
%sAmbiguous spec? Decide it, write down why, keep going. Do not stop and wait.%s
""" % (C["b"], C["x"], C["c"], tid, C["x"], C["c"], tid, C["x"],
       C["c"], tid, C["x"], C["c"], tid, C["x"], C["dim"], C["x"]))


# ---------------------------------------------------------------- claiming

def cmd_claim(args):
    if not args:
        die("usage: agent claim <task-id> [files...]")
    me = whoami()
    files = [_rel(f) for f in args[1:]]
    st = load()
    tid = _require_task(st, args[0], "claim")

    if st["tasks"][tid]["status"] == "done":
        die("%s is already done" % tid)
    held = st["in_flight"].get(tid)
    if held and held["agent"] != me:
        die("%s is already claimed by %s (started %s)" % (tid, held["agent"], held["started"]))

    conflicts = [(f, st["claims"][f]) for f in files
                 if f in st["claims"] and st["claims"][f]["agent"] != me]
    if conflicts:
        for f, c in conflicts:
            print("%s✗ %s is claimed by %s for task %s%s" % (C["r"], f, c["agent"], c["task"], C["x"]))
        die("resolve the overlap before continuing — two agents in one file will conflict")

    if not held:
        st["in_flight"][tid] = {"agent": me, "started": now(), "files": [], "notes": []}
    entry = st["in_flight"][tid]
    for f in files:
        if f not in entry["files"]:
            entry["files"].append(f)
        st["claims"][f] = {"task": tid, "agent": me, "at": now()}
    st["tasks"][tid]["status"] = "in_flight"
    save(st)

    ok("%s claimed by %s" % (tid, me))
    print("  %s" % st["tasks"][tid]["title"])
    if files:
        for f in files:
            print("  %s· %s%s" % (C["dim"], f, C["x"]))
    else:
        print("  %sno files claimed yet — add them with:  agent claim %s <files...>%s"
              % (C["dim"], tid, C["x"]))


def _rel(p):
    p = os.path.abspath(p) if os.path.exists(p) else os.path.join(ROOT, p)
    return os.path.relpath(p, ROOT)


def cmd_note(args):
    if len(args) < 2:
        die('usage: agent note <task-id> "what you learned or did"')
    me = whoami()
    tid, text = _norm_id(args[0]), " ".join(args[1:])
    st = load()
    if tid not in st["in_flight"]:
        die("%s is not in flight" % tid)
    st["in_flight"][tid]["notes"].append({"at": now(), "by": me, "text": text})
    save(st)
    ok("noted on %s" % tid)


# ---------------------------------------------------------------- finishing

def _release(st, tid):
    """Release a task's claims, but remember them briefly.

    `agent done` runs before `git commit`, so without this the pre-commit check
    would see every just-finished file as unclaimed and warn about all of them —
    noise that trains you to ignore the warnings that matter."""
    entry = st["in_flight"].pop(tid, None)
    if entry:
        recent = st.setdefault("recent", {})
        for f in entry.get("files", []):
            if st["claims"].get(f, {}).get("task") == tid:
                del st["claims"][f]
            recent[f] = {"task": tid, "agent": entry["agent"], "at": now()}
    return entry


def _head():
    try:
        return subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT,
                              capture_output=True, text=True).stdout.strip()
    except Exception:
        return "?"


def _journal(kind, tid, title, agent, body, files):
    os.makedirs(AGENT_DIR, exist_ok=True)
    if not os.path.exists(JOURNAL):
        with open(JOURNAL, "w") as f:
            f.write("# Journal\n\nAppend-only. Newest at the bottom. "
                    "Written by `agent done` / `agent handoff`.\n")
    with open(JOURNAL, "a") as f:
        f.write("\n---\n\n### %s · %s · %s · %s\n\n" % (kind, tid, agent, now()))
        f.write("**%s**\n\n" % title)
        f.write("%s\n\n" % body)
        if files:
            f.write("Files: %s\n\n" % ", ".join("`%s`" % x for x in files))
        f.write("Commit at time of writing: `%s`\n" % _head())


def cmd_done(args):
    if not args:
        die('usage: agent done <task-id> ["one-line summary"]')
    me = whoami()
    summary = " ".join(args[1:]) or "Completed."
    st = load()
    tid = _require_task(st, args[0], "done")
    entry = _release(st, tid)
    st["tasks"][tid]["status"] = "done"
    st["tasks"][tid]["done_at"] = now()
    st["tasks"][tid]["done_by"] = me
    save(st)

    notes = ""
    if entry and entry.get("notes"):
        notes = "\n\nNotes along the way:\n" + "\n".join(
            "- %s" % n["text"] for n in entry["notes"])
    _journal("DONE", tid, st["tasks"][tid]["title"], me, summary + notes,
             entry.get("files", []) if entry else [])

    ok("%s done — claims released, journal updated" % tid)
    if _is_finding(tid) and tid in dict(_open_findings()):
        print("  %s⚠ %s is still under '## Open' in docs/FINDINGS.md — move it to '## Resolved'"
              % (C["y"], tid))
        print("    with what you did and how you verified it, or the next agent re-fixes it.%s"
              % C["x"])
    _print_ready(load())
    print("  %sCommit now so the next agent sees it.%s" % (C["dim"], C["x"]))


def cmd_handoff(args):
    if len(args) < 2:
        die('usage: agent handoff <task-id> "what is done, what is left, what to watch out for"')
    me = whoami()
    tid, body = _norm_id(args[0]), " ".join(args[1:])
    st = load()
    if tid not in st["in_flight"]:
        die("%s is not in flight" % tid)
    entry = _release(st, tid)
    st["tasks"][tid]["status"] = "todo"
    save(st)
    _journal("HANDOFF", tid, st["tasks"][tid]["title"], me, body, entry.get("files", []))
    ok("%s handed off — claims released, next agent can pick it up" % tid)
    print("  %sCommit your partial work so it isn't lost.%s" % (C["dim"], C["x"]))


def cmd_drop(args):
    if not args:
        die("usage: agent drop <task-id>")
    tid = _norm_id(args[0])
    st = load()
    entry = _release(st, tid)
    if not entry:
        die("%s is not in flight" % tid)
    st["tasks"][tid]["status"] = "todo"
    save(st)
    ok("%s dropped — claims released" % tid)


# ---------------------------------------------------------------- ship

def _git(*a):
    return subprocess.run(["git"] + list(a), cwd=ROOT, capture_output=True, text=True)


def _branch():
    return _git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() or "main"


GODOT_CANDIDATES = (
    os.environ.get("GODOT", ""),
    "/Applications/Godot.app/Contents/MacOS/Godot",
    "godot",
    "godot4",
)


def _find_godot():
    """The pinned engine, or None. Never fatal: Codex on another machine may not have it."""
    for c in GODOT_CANDIDATES:
        if not c:
            continue
        if os.path.sep in c:
            if os.path.isfile(c) and os.access(c, os.X_OK):
                return c
            continue
        try:
            if subprocess.run(["which", c], capture_output=True, text=True).returncode == 0:
                return c
        except FileNotFoundError:
            pass
    return None


def _generate_missing_uids(to_stage, changed):
    """Run one Godot import if any staged .gd has no .uid, and return a refreshed `changed` list.

    F-017. `ship` can only stage what is on disk, and Godot writes the sidecar at import time — so a
    task whose work never required an import shipped a script with no .uid, every time. Harmless
    while .tscn files reference scripts by `path=`, and not harmless the first time Godot rewrites
    those as `uid://`. This is the same command that rebuilds the global class cache (F-016), so it
    fixes both failures rather than leaving a per-milestone sweep to catch them.
    """
    orphans = [f for f in to_stage
               if f.endswith(".gd") and not os.path.exists(os.path.join(ROOT, f + ".uid"))]
    if not orphans:
        return changed

    try:
        editor_up = subprocess.run(["pgrep", "-fl", "Godot"],
                                   capture_output=True, text=True).returncode == 0
    except FileNotFoundError:
        editor_up = True  # Never fail open on the safety check.
    if editor_up:
        print("  %s⚠ %d script(s) have no .uid, and Godot is running — skipping import (D-031).%s"
              % (C["y"], len(orphans), C["x"]))
        print("  %sClose the editor and re-run ship, or the sidecars ship late (F-017).%s"
              % (C["dim"], C["x"]))
        return changed

    godot = _find_godot()
    if godot is None:
        print("  %s⚠ %d script(s) have no .uid and Godot was not found — sidecars will ship late.%s"
              % (C["y"], len(orphans), C["x"]))
        print("  %sSet GODOT=/path/to/Godot to let ship generate them (F-017).%s"
              % (C["dim"], C["x"]))
        return changed

    print("  %sgenerating .uid for %d new script(s) — one Godot import…%s"
          % (C["dim"], len(orphans), C["x"]))
    r = subprocess.run([godot, "--headless", "--path", ROOT, "--import"],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        print("  %s⚠ import failed (%d) — sidecars will ship late.%s" % (C["y"], r.returncode, C["x"]))
        return changed

    return [l[3:].strip().strip('"').split(" -> ")[-1]
            for l in _git("status", "--porcelain", "-uall").stdout.splitlines() if l.strip()]


def cmd_ship(args):
    """Commit and push exactly this task's files, then print the completion notice.

    Deliberately NOT `git add -A`. Parallel agents share one working directory, so a
    blanket add would sweep another agent's half-written files into this commit — the
    real hazard when several chats run at once (push races can't happen from one repo).
    Only the files this task claimed, plus the coordination state, are staged — and the
    commit itself is limited to those same paths, because one shared index means `add`
    alone does not decide what a commit contains (F-014)."""
    if not args:
        die('usage: agent ship <task-id> ["commit message"]')

    # F-034: `claim` takes a file list, so passing one to `ship` too is the natural guess — and it
    # used to be silently glued onto the commit subject, which is how 340d9a3 ended up titled
    # "Art: rebuild the tool set and add inventory icons tools/blender/build_tool_weapon_set.py …".
    # Reject anything that looks like a path rather than prose. A message word is essentially never
    # an existing path, so this catches the mistake without breaking an unquoted message.
    pathish = [a for a in args[1:]
               if os.path.exists(os.path.join(ROOT, a)) or (("/" in a) and not a.endswith(("/", ".")))]
    if pathish:
        die("ship takes a task id and a MESSAGE, not a file list — it commits what the task claimed.\n"
            "  Looks like a path: %s\n"
            '  Did you mean:  agent ship %s "your message here"'
            % (", ".join(pathish[:4]), args[0]))

    me = whoami()
    st = load()
    tid = _require_task(st, args[0], "ship")
    if tid in st["in_flight"]:
        die("%s is still in flight — run 'agent done %s' or 'agent handoff %s' first" % (tid, tid, tid))

    title = st["tasks"][tid]["title"]
    msg = " ".join(args[1:]) or ("%s %s" % (tid, title[:60]))

    # The files this task held, recorded by _release() when it closed out.
    mine = sorted(f for f, d in st.get("recent", {}).items() if d.get("task") == tid)
    changed = [l[3:].strip().strip('"').split(" -> ")[-1]
               for l in _git("status", "--porcelain", "-uall").stdout.splitlines() if l.strip()]

    # F-034: a claim on a directory is legal — `agent check` and the pre-commit hook both honour it —
    # but it names nothing in `changed`, which lists files. 2.1d claimed `assets/tools_weapons` and
    # `assets/icons`, shipped a third of its work, and still printed a clean sign-off. Expand every
    # claimed directory to the changed files underneath it.
    claimed_dirs = [p for p in mine if os.path.isdir(os.path.join(ROOT, p))]
    expanded = [f for f in changed
                if any(f.startswith(d.rstrip("/") + "/") for d in claimed_dirs)]

    to_stage = [f for f in mine if f in changed]
    to_stage += expanded
    to_stage += [f for f in changed if f.startswith(".agent/")]
    # Godot writes a .uid sidecar beside every script and regenerates it when the script
    # changes. Nobody authors one and nobody claims one, so it never appeared in any task's
    # file list — which is precisely how F-010 left a trail of untracked .uid files behind
    # shipped tasks. Ship each sidecar with the script it belongs to.
    to_stage += [f + ".uid" for f in list(to_stage) if f + ".uid" in changed]
    to_stage = list(dict.fromkeys(to_stage))
    if not to_stage:
        die("nothing to ship for %s — no changed files from this task" % tid)

    # F-017: the line above can only stage a sidecar that already exists. Godot writes .uid at IMPORT
    # time, so a task that never had a reason to import ships before the file exists at all — which
    # is why every new script left one behind. Import now, then look again.
    changed = _generate_missing_uids(to_stage, changed)
    to_stage += [f + ".uid" for f in list(to_stage) if f + ".uid" in changed]
    to_stage = list(dict.fromkeys(to_stage))

    others = [f for f in changed if f not in to_stage]

    # `add` first: a pathspec commit cannot name a file git has never seen.
    r = _git("add", "--", *to_stage)
    if r.returncode != 0:
        die("git add failed: %s" % r.stderr.strip())

    # Commit BY PATHSPEC, not the whole index (F-014). Several agents share one working
    # directory and therefore one index, so a bare `git commit` sweeps in whatever another
    # agent has staged and not yet committed — the exact hazard the careful `add` list above
    # exists to prevent. With a pathspec git builds a temporary index from HEAD plus these
    # paths, so the other agent's staging is neither committed nor disturbed, and the
    # pre-commit hook sees only this task's files.
    r = _git("commit", "-m", "%s\n\nTask %s shipped by %s." % (msg, tid, me), "--", *to_stage)
    if r.returncode != 0:
        # Scoped reset. A bare `git reset` here would unstage the other agent's work too —
        # reaching into state that is not ours to touch (F-014).
        _git("reset", "--", *to_stage)
        die("commit blocked:\n%s%s" % (r.stdout, r.stderr))
    ok("committed %d file(s) — %s" % (len(to_stage), _head()))

    if others:
        # F-034: the count and the truncation both matter. "Left alone" used to print at most eight
        # paths with no total, so a run that shipped a third of its work read exactly like one that
        # shipped all of it.
        print("  %sLeft alone — %d file(s), not this task's, may belong to another agent:%s"
              % (C["dim"], len(others), C["x"]))
        for f in others[:8]:
            print("      %s· %s%s" % (C["dim"], f, C["x"]))
        if len(others) > 8:
            print("      %s… and %d more — run 'git status' to see them all%s"
                  % (C["dim"], len(others) - 8, C["x"]))

    if not _git("remote").stdout.strip():
        print("\n%s⚠ No git remote configured — committed locally, nothing pushed.%s"
              % (C["y"], C["x"]))
        print("  %sSequoyah: gh repo create mire --private --source=. --remote=origin --push%s"
              % (C["dim"], C["x"]))
    else:
        br = _branch()
        r = _git("push")
        if r.returncode != 0:
            r = _git("push", "-u", "origin", br)
        if r.returncode == 0:
            ok("pushed to origin/%s" % br)
        else:
            print("%s✗ push failed:%s %s" % (C["r"], C["x"], (r.stderr or r.stdout).strip()[:300]))
            print("  %sWork is committed locally and safe. Tell Sequoyah the push failed.%s"
                  % (C["dim"], C["x"]))

    print("\n%s%s Task %s shipped — before you stop:%s" % (C["b"], "─" * 3, tid, C["x"]))
    print("""
  %sSequoyah is not a courier.%s Anything the NEXT agent needs must already be in the
  repo, not in your final message. Check each of these, and go do it if it is missing:

    · a problem you spotted outside this task      -> docs/FINDINGS.md, next F-number
    · a call you made that others must not redo    -> docs/DECISIONS.md, next D-number
    · an API, node layout or constant 1.x builds on -> docs/DELEGATION.md 'Current state'
    · how it went, what bit you                    -> already in the journal via done/note

  %sThen tell Sequoyah only what is genuinely his:%s
    · what you verified, with the command and its actual output — not "it works"
    · whether it RUNS or only compiles, in those words
    · what he must do in the Godot editor, if anything. Make required .tscn/.tres changes
      yourself under exact claims while Godot is closed; hand off only genuine visual tuning
    · whether it is safe to start the next task
""" % (C["b"], C["x"], C["b"], C["x"]))


# ---------------------------------------------------------------- check

def cmd_check(args):
    """Verify uncommitted changes respect claims and the closed-editor rule.
    Run by the pre-commit hook."""
    me = whoami(required=False) or "unknown"
    st = load()

    # Inside a git hook, judge the STAGED set — that is what is actually being
    # committed (F-001). Scanning the working tree instead made any two agents
    # working at once block each other's commits over files neither was
    # committing, which taught everyone to reach for --no-verify. Git exports
    # GIT_INDEX_FILE to its hooks and nowhere else, so it tells us which we are.
    # Run by hand, the working tree is still the useful scope.
    staged_only = bool(os.environ.get("GIT_INDEX_FILE"))
    changed = None
    if staged_only:
        try:
            r = subprocess.run(["git", "diff", "--cached", "--name-only"], cwd=ROOT,
                               capture_output=True, text=True)
            if r.returncode == 0:
                changed = [l.strip().strip('"') for l in r.stdout.splitlines() if l.strip()]
        except Exception:
            changed = None
    if changed is None:
        # Fall back to the working tree: manual runs, and the first-commit case
        # where there is no HEAD to diff against. Never fail open.
        try:
            # -uall: list untracked files individually. Without it git collapses a
            # wholly-untracked directory to "dir/" and we never see the files inside.
            raw = subprocess.run(["git", "status", "--porcelain", "-uall"], cwd=ROOT,
                                 capture_output=True, text=True).stdout
        except Exception:
            return
        changed = [l[3:].strip().strip('"') for l in raw.splitlines() if l.strip()]
        changed = [c.split(" -> ")[-1] for c in changed]

    errors, warnings = [], []
    human = me in ("sequoyah", "human", "unknown")
    editor_running = None

    def godot_is_running():
        nonlocal editor_running
        if editor_running is None:
            try:
                editor_running = subprocess.run(
                    ["pgrep", "-fl", "Godot"], capture_output=True, text=True
                ).returncode == 0
            except FileNotFoundError:
                editor_running = True  # Never fail open when the safety check is unavailable.
        return editor_running

    def in_grace(path):
        r = st.get("recent", {}).get(path)
        return bool(r) and r["agent"] == me and age_hours(r["at"]) < RECENT_GRACE_HOURS

    for f in changed:
        if any(f.startswith(p) for p in FREE_PREFIXES) or f.endswith(GENERATED_SUFFIXES):
            continue
        c = st["claims"].get(f)
        is_editor_guarded = f.endswith(EDITOR_GUARDED_SUFFIXES) or f in EDITOR_GUARDED_PATHS
        if is_editor_guarded and not human:
            # D-031: agents may edit Godot-authored files under an exact claim, but
            # never while the editor is running because it may overwrite them.
            if (c and c["agent"] == me) or in_grace(f):
                if godot_is_running():
                    errors.append("%s — Godot is running; close it before committing editor-guarded files (D-031)" % f)
                else:
                    warnings.append("%s — Godot file edited under an exact claim with the editor closed (D-031)" % f)
                continue
            errors.append("%s — Godot file requires an exact-file claim and a closed editor (D-031)" % f)
            continue
        if c and c["agent"] != me:
            # The human integrates everyone's work, so they may commit any file.
            # Agents may not touch a file another agent holds.
            if human:
                warnings.append("%s — claimed by %s (task %s); committing as integrator"
                                % (f, c["agent"], c["task"]))
            else:
                errors.append("%s — claimed by %s for task %s" % (f, c["agent"], c["task"]))
        elif not c and not human and not in_grace(f):
            # in_grace: just closed this task out; committing is the expected next step.
            warnings.append("%s — edited without a claim" % f)

    for w in warnings:
        print("%s⚠ %s%s" % (C["y"], w, C["x"]))
    for e in errors:
        print("%s✗ %s%s" % (C["r"], e, C["x"]))
    if errors:
        print("\n%sCommit blocked.%s Use --no-verify only if you are certain.\n" % (C["r"], C["x"]))
        sys.exit(1)
    if not warnings:
        ok("check passed (%d changed file(s), session: %s)" % (len(changed), me))


# ---------------------------------------------------------------- board

def _print_ready(st, limit=6):
    # Findings are deliberately excluded from the milestone scan: "Findings" sorts before "M0",
    # so counting it here would make the current milestone the findings list forever.
    # "blocked" counts as settled here, not as outstanding. A deliberately deferred task (D-030's
    # 1.12) would otherwise pin its milestone active forever while offering nothing pickable, and
    # since only that milestone's todo tasks are listed, the whole board would go silent — F-026.
    # A milestone whose only remaining work is deferred is finished for the one question this scan
    # answers, which is "what should I start now".
    done_ms = set()
    for t in st["tasks"].values():
        if t["status"] not in ("done", "blocked") and t["milestone"] != FINDINGS_MILESTONE:
            done_ms.add(t["milestone"])
    active = sorted(done_ms)[:1]
    ready = [(tid, t) for tid, t in st["tasks"].items()
             if t["status"] == "todo" and t["milestone"] in active]
    ready.sort(key=lambda x: task_sort_key(x[0]))
    if ready:
        print("\n%sReady to pick up%s" % (C["b"], C["x"]))
        for tid, t in ready[:limit]:
            print("  %s%-5s%s %-4s %s" % (C["c"], tid, C["x"], t["tier"], t["title"][:66]))
        if len(ready) > limit:
            print("  %s… %d more%s" % (C["dim"], len(ready) - limit, C["x"]))
        print()

    # Their own section, so an open finding is visibly pickable work rather than a footnote in a
    # doc — which is what left F-013 sitting open across three sessions.
    open_findings = [(tid, t) for tid, t in st["tasks"].items()
                     if t["milestone"] == FINDINGS_MILESTONE and t["status"] == "todo"]
    open_findings.sort(key=lambda x: task_sort_key(x[0]))
    if open_findings:
        print("%sOpen findings — claimable by F-number%s" % (C["b"], C["x"]))
        for tid, t in open_findings[:limit]:
            print("  %s%-5s%s %-4s %s" % (C["c"], tid, C["x"], t["tier"], t["title"][:66]))
        if len(open_findings) > limit:
            print("  %s… %d more%s" % (C["dim"], len(open_findings) - limit, C["x"]))
        print()


def _print_board(st, focus=None):
    if st["in_flight"]:
        print("%sIn flight%s" % (C["b"], C["x"]))
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            mine = " %s← you%s" % (C["g"], C["x"]) if d["agent"] == focus else ""
            print("  %s%-5s%s %-9s %.0fh  %s%s"
                  % (C["c"], tid, C["x"], d["agent"], age_hours(d["started"]),
                     st["tasks"].get(tid, {}).get("title", "?")[:50], mine))
            for f in d.get("files", []):
                print("      %s· %s%s" % (C["dim"], f, C["x"]))
            for n in d.get("notes", [])[-2:]:
                print("      %s› %s%s" % (C["dim"], n["text"][:70], C["x"]))
        print()
    else:
        print("%sIn flight%s  %snothing — clean slate%s\n" % (C["b"], C["x"], C["dim"], C["x"]))
    _print_ready(st)


def _roadmap_progress(st):
    """Done/total over ROADMAP tasks only. Findings are counted separately — folding them in would
    make the milestone number move every time someone files one, which is the opposite of useful."""
    items = [t for t in st["tasks"].values() if t["milestone"] != FINDINGS_MILESTONE]
    return sum(1 for t in items if t["status"] == "done"), len(items)


def cmd_board(args):
    st = load()
    # Same freshness rule as cmd_start (F-049): the board is read to pick work, so it must mirror
    # FINDINGS.md's open section at read time, not at last-sync time.
    _sync_findings(st)
    save(st)
    done, total = _roadmap_progress(st)
    print("\n%sMIRE%s  %d/%d tasks done\n" % (C["b"], C["x"], done, total))
    _print_board(st, focus=whoami(required=False))
    _print_stale(st)


def render_board(st):
    """Write the human/agent-readable BOARD.md."""
    done, total = _roadmap_progress(st)
    L = ["# Board",
         "",
         "<!-- Generated by `agent`. Do not hand-edit — run `agent board` instead. -->",
         "",
         "**%d / %d tasks complete.**" % (done, total),
         "", "## In flight", ""]

    if st["in_flight"]:
        L += ["| Task | Agent | Started | Files claimed |", "|---|---|---|---|"]
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            files = ", ".join("`%s`" % f for f in d.get("files", [])) or "—"
            L.append("| **%s** %s | %s | %s | %s |"
                     % (tid, st["tasks"].get(tid, {}).get("title", "?"), d["agent"],
                        d["started"][:16].replace("T", " "), files))
        L.append("")
        for tid, d in sorted(st["in_flight"].items(), key=lambda x: task_sort_key(x[0])):
            if d.get("notes"):
                L.append("**%s notes:**" % tid)
                L += ["- %s" % n["text"] for n in d["notes"]]
                L.append("")
    else:
        L += ["_Nothing in flight._", ""]

    by_ms = {}
    for tid, t in st["tasks"].items():
        by_ms.setdefault(t["milestone"], []).append((tid, t))

    L += ["## Milestones", "", "| Milestone | Progress | Remaining |", "|---|---|---|"]
    for ms in sorted(by_ms):
        items = by_ms[ms]
        d = sum(1 for _, t in items if t["status"] == "done")
        bar = "█" * round(10 * d / len(items)) + "░" * (10 - round(10 * d / len(items)))
        L.append("| %s | `%s` %d/%d | %s |" % (ms, bar, d, len(items), len(items) - d))
    L.append("")

    active = [ms for ms in sorted(by_ms)
              if ms != FINDINGS_MILESTONE
              and any(t["status"] != "done" for _, t in by_ms[ms])]
    if active:
        ms = active[0]
        L += ["## %s — current milestone" % ms, "",
              "| | Task | Tier | Est | Status |", "|---|---|---|---|---|"]
        for tid, t in sorted(by_ms[ms], key=lambda x: task_sort_key(x[0])):
            mark = {"done": "✅", "in_flight": "🔵", "todo": "⬜", "blocked": "🚧"}.get(t["status"], "⬜")
            L.append("| %s | **%s** %s | %s | %s | %s |"
                     % (mark, tid, t["title"], t["tier"], t["est"], t["status"]))
        L.append("")

    open_findings = sorted(
        ((tid, t) for tid, t in st["tasks"].items()
         if t["milestone"] == FINDINGS_MILESTONE and t["status"] != "done"),
        key=lambda x: task_sort_key(x[0]))
    if open_findings:
        L += ["## Open findings — claim by F-number", "",
              "| | Finding | Status |", "|---|---|---|"]
        for tid, t in open_findings:
            mark = {"in_flight": "🔵", "blocked": "🚧"}.get(t["status"], "⬜")
            L.append("| %s | **%s** %s | %s |" % (mark, tid, t["title"], t["status"]))
        L.append("")

    L += ["## Done", "",
          " ".join("`%s`" % tid for tid, t in
                   sorted(st["tasks"].items(), key=lambda x: task_sort_key(x[0]))
                   if t["status"] == "done") or "_Nothing yet._", ""]

    with open(BOARD, "w") as f:
        f.write("\n".join(L))


# ------------------------------------------------------- orchestration (D-036)
#
# Everything above this line is pull-based: an agent opens a chat, runs `start`, and picks something.
# That works, but it makes Sequoyah the scheduler — he opens every chat and is the one who notices
# when an account runs dry.
#
# Below is the push half. One director (Claude Max, Opus) routes tasks to three worker lanes, each
# pinned to its own paid account, and watches their quota. The director does not implement; it
# routes and verifies. See docs/ORCHESTRATION.md.

LANE_NAMES = ("LC1", "LC2", "LP")

# Tier → reasoning effort. T0 is mechanical, T1 is spec-following, T2 is the work where being wrong
# costs a rewrite. M1/M4 T2 tasks step up again in cmd_order.
TIER_EFFORT = {"T0": "low", "T1": "medium", "T2": "high"}


@contextlib.contextmanager
def file_lock(name, timeout=600):
    """Serialise the two resources three concurrent lanes actually share.

    `godot` — one headless Godot at a time. Lanes share a single 42 MB import cache, and two engines
    reimporting it at once is the most plausible explanation for F-038's intermittent failures.
    `git`  — one index at a time. Three lanes running `ship` together means index.lock contention.
    """
    os.makedirs(LOCKS, exist_ok=True)
    path = os.path.join(LOCKS, "%s.lock" % name)
    waited = False
    with open(path, "w") as fh:
        deadline = time.time() + timeout
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if not waited:
                    print("%s· waiting for the %s lock%s" % (C["dim"], name, C["x"]))
                    waited = True
                if time.time() > deadline:
                    die("timed out after %ds waiting for the %s lock. If nothing is running, "
                        "remove %s" % (timeout, name, os.path.relpath(path, ROOT)))
                time.sleep(0.4)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def with_lock(name, fn):
    """Wrap a command so it holds a lock for its whole run, without touching the command's body."""
    def wrapped(args):
        with file_lock(name):
            return fn(args)
    return wrapped


def _lane_state():
    try:
        with open(LANES_FILE) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def _plain(fn, args):
    """Capture a command's output with colour off — work orders are piped into another CLI as a
    prompt, and ANSI escapes in a prompt are just noise the model has to read past."""
    saved = dict(C)
    C.update({k: "" for k in C})
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            fn(args)
    finally:
        C.update(saved)
    return buf.getvalue()


STOPWORDS = {"the", "and", "for", "with", "from", "into", "that", "this", "not", "but", "its",
             "one", "two", "all", "any", "per", "run", "make", "add", "use", "when", "then",
             "than", "each", "only", "over", "under", "before", "after", "until", "does", "must"}


def _tokens(text):
    """Words worth matching on. Splits camelCase too, so `WorldEnvironment` in a task title can find
    environment_vfx_check.gd."""
    text = re.sub(r"([a-z])([A-Z])", r"\1 \2", text)
    return {w for w in re.findall(r"[a-z]{4,}", text.lower()) if w not in STOPWORDS}


def _suggest_check(tid, title):
    """Point the lane at the headless proof that already exists for its area.

    A task that ends with a check someone can re-run is a task the director can verify by reading
    one exit code instead of re-deriving the work. There are ~49 of these in tools/ already.

    Match on name parts, not substrings: 'cycle' must not select session_lifecycle_check."""
    words = _tokens(title)
    scored = []
    for path in sorted(glob.glob(os.path.join(ROOT, "tools", "*_check.gd"))):
        stem = os.path.basename(path)[:-3]
        parts = [p for p in stem.split("_") if p != "check"]
        hits = sum(1 for w in words
                   if any(p.startswith(w[:5]) or w.startswith(p[:5]) for p in parts))
        if hits >= 2:
            # One shared word is noise, not a match: "food items" picks item_icons_check, and
            # pointing a lane at the wrong proof is worse than admitting there isn't one — it will
            # run a green check and believe its work is verified.
            scored.append((-hits, "tools/%s.gd" % stem))
    scored.sort()
    return [p for _, p in scored[:3]]


SPECS = os.path.join(ROOT, "docs", "SPECS.md")


def _spec_body(tid):
    """This task's execution spec from docs/SPECS.md, if it has one.

    SPECS.md exists so a lane needs zero exploration, and an order that merely *points* at it makes
    the lane open and search a 34 KB file — which is exploration with extra steps. Inline the block."""
    if not os.path.exists(SPECS):
        return []
    out, capturing = [], False
    for line in open(SPECS):
        if line.startswith("## "):
            key = re.split(r"[ ·]", line[3:].strip())[0]
            if capturing:
                break
            capturing = (key == tid)
            if capturing:
                out.append(line.rstrip())
            continue
        if line.startswith("# ") and capturing:
            break
        if capturing:
            out.append(line.rstrip())
    while out and not out[-1].strip():
        out.pop()
    return out


def _spec_claims(spec):
    """The claim set the spec itself declares.

    SPECS.md blocks carry a `**Claim:** \\`a.gd\\`, \\`b.gd\\`` line, sometimes wrapped over two
    lines. That list is authoritative — it was written against the code — so it is a better default
    than whatever the director remembered to type. A mismatch here surfaces as a failed claim
    halfway through a dispatch, after the lane has already spent quota getting there."""
    text, capturing = [], False
    for line in spec:
        stripped = line.strip()
        if stripped.startswith("**Claim:**"):
            capturing = True
            text.append(stripped[len("**Claim:**"):])
            continue
        if capturing:
            # Keep consuming wrapped continuation lines, stop at the next field or a blank line.
            if not stripped or re.match(r"\*\*[A-Z]", stripped) or stripped.startswith(("-", "#")):
                break
            text.append(stripped)
    found = re.findall(r"`([^`]+)`", " ".join(text))
    return [f for f in found if "/" in f or f.endswith((".gd", ".godot", ".tres", ".tscn", ".cfg"))]


def _spec_verify(spec):
    """The checks the spec names, which beat guessing from the title.

    A spec's `Verify:` line names the checks that actually prove this task — including ones the task
    is meant to *write*. Keyword-matching against existing tools/ can only ever find checks that
    already exist, so for any task that adds one it points at the wrong file."""
    names = []
    for line in spec:
        stripped = line.strip()
        if stripped.startswith(("Verify:", "**Verify:**")):
            for tok in re.findall(r"`([^`]+)`", stripped):
                tok = tok.strip().replace("tools/", "").replace(".gd", "")
                if tok.endswith("_check") and tok not in names:
                    names.append(tok)
    return ["tools/%s.gd" % n for n in names]


def _order_path(tid):
    return os.path.join(ORDERS, "%s.md" % tid.replace("/", "_"))


def _open_orders():
    if not os.path.isdir(ORDERS):
        return {}
    out = {}
    for path in sorted(glob.glob(os.path.join(ORDERS, "*.md"))):
        tid = os.path.basename(path)[:-3]
        head = ""
        with open(path) as f:
            for line in f:
                if line.startswith("<!-- lane:"):
                    head = line.strip()
                    break
        def field(key, default="?"):
            m = re.search(r"%s:(\S+)" % key, head)
            return m.group(1) if m else default
        files = re.search(r"files:(.*?)-->", head)
        out[tid] = {
            "path": path,
            "lane": field("lane"),
            "model": field("model", ""),
            "effort": field("effort", ""),
            "files": [x for x in (files.group(1).split() if files else []) if x],
        }
    return out


ORDER_TEMPLATE = """<!-- lane:%(lane)s model:%(model)s effort:%(effort)s files:%(files)s -->
# Work order — %(tid)s  ·  lane %(lane)s  (%(account)s)

You are **%(lane)s**, one of three worker lanes on MIRE. Your agent name is `%(agent)s` and it is
already set in your environment, so every `agent` command you run files under it automatically.

Work autonomously and finish. **Do not stop to ask questions.** If the spec is ambiguous, decide it
the way `ARCHITECTURE.md` and `DECISIONS.md` point, record the call, and keep going — a
wrong-but-documented decision is cheap to reverse, and a stalled lane is not.

%(spec)s
## 1. Claim before your first edit

```bash
%(claim)s
```

If that fails, another lane holds a file you need. **Stop and run `.agent/bin/agent drop %(tid)s`** —
do not work around it. Two agents in one file is the failure this whole system exists to prevent.

## 2. Verify it yourself, headless — never ask a human to run it

```bash
%(verify)s
```

Always launch Godot through `agent godot`. It takes a lock so your run cannot collide with another
lane's; a bare `Godot --headless` can corrupt the shared import cache (F-038, F-044).

## 3. Close out — this part is not optional

Everything the next agent needs goes **in the repo**, not in a closing message. Nobody reads your
final message; Sequoyah does not relay between tasks.

| What you have | Where it goes |
|---|---|
| A problem outside this task | `docs/FINDINGS.md`, next `F-0NN` |
| A call others must not relitigate | `docs/DECISIONS.md`, next `D-0NN` |
| An API or layout the next task builds on | `docs/DELEGATION.md` *Current state* |

Then, in order:

```bash
.agent/bin/agent done %(tid)s "what works, and the command that proves it"
.agent/bin/agent ship %(tid)s "%(tid)s: short imperative summary"
```

If you run out of quota or hit a wall, stop cleanly instead of thrashing:

```bash
.agent/bin/agent handoff %(tid)s "what works, what doesn't, what you'd decided, what's next"
```

## 4. Hard rules

- **Never edit `.tscn`/`.tres`/`.import`/`project.godot` unless this order's claim set names it**, and
  never while Godot is open (`pgrep -fl Godot`). D-021, D-031.
- **Never explore speculatively.** Read the four docs below, then the files this task touches. If you
  need one more file, name your best guess and read that one — do not grep the repo.
- **Never bulk-generate content data.** `.tres` items/recipes/powerups are hand-authored. Build the
  framework, not the content.
- **Every system declares its network authority** (`ARCHITECTURE.md` §2.2). Host-authoritative by
  default. There is no "multiplayer later" here.
- **Typed GDScript everywhere.** `snake_case` files/functions, `PascalCase` classes, `net_` prefix on
  networked functions, cross-system comms through `event_bus`, never `randi()` in world generation.

---

%(brief)s
"""


REVIEW_TEMPLATE = """<!-- lane:%(lane)s model:%(model)s effort:%(effort)s review:%(tid)s files: -->
# Review order — %(tid)s  ·  lane %(lane)s  (%(account)s)

You are **%(lane)s**, reviewing work another lane implemented. Your agent name is `%(agent)s`.

**You are not here to implement.** Do not edit source. Read the change, judge it against its spec,
and report. The one exception is `docs/FINDINGS.md`, where your findings belong.

## What to review

```bash
git log --oneline -8
git show --stat %(sha)s
git diff %(sha)s~1..%(sha)s
```

## Judge it against these, in order

1. **The spec** — the `%(tid)s` block in `docs/SPECS.md` is the contract. Does the change do what it
   says, including its acceptance criteria? Anything the spec called a trap — did they fall in it?
2. **Network authority** — every system declares its `ARCHITECTURE.md` §2.2 row. Host-authoritative
   by default; client-authoritative only for a player's own movement. A client that mutates shared
   state is a bug, not a style note.
3. **The four standing rules** in `docs/SPECS.md` — especially rule 1 (no bare autoload identifiers
   in anything a `--script` harness can reach), which has cost real sessions (F-011, F-046).
4. **Its own check** — run it, don't trust the commit message:
   ```bash
   %(verify)s
   ```
   Grep the output for `ERROR:` and treat any as failure even when the exit code is 0 (F-021).
5. **Determinism** — no `randi()` in world generation; seeded `RandomNumberGenerator` per subsystem.
6. **Typed GDScript**, `net_` prefix on networked functions, cross-system comms via `event_bus`.

## How to report

For each real problem, append to `docs/FINDINGS.md` as the next `F-0NN`, in that file's format
(**Area** / **Severity** / **Found**), naming the file and line and the concrete failure. Severity
per its table: `high` only if it ships broken, desyncs, or blocks a milestone.

**Be specific or say nothing.** "The netcode feels fragile" is unactionable and rots there forever.
If you cannot name a file and a concrete failure, you have a hunch — keep it.

If the change is sound, say so plainly and file nothing. A clean review is a real result.

Close out with:

```bash
.agent/bin/agent done %(tid)s-review "verdict, and the check output you actually saw"
.agent/bin/agent ship %(tid)s-review "Review %(tid)s: <verdict>"
```

---

%(brief)s
"""


def cmd_order(args):
    """Compose a self-contained work order for one task and park it for a lane.

    The order is generated, not hand-written. Hand-written prompts are what made Sequoyah the
    courier; anything a lane needs that isn't in here is a bug in the docs, not a missing prompt."""
    if not args:
        die('usage: agent order <task-id> [--lane LC1] [--files a.gd b.gd] [--verify "cmd"]')
    st = load()
    tid = _require_task(st, args[0], "order")
    t = st["tasks"][tid]

    lane = "?"
    files, verify = [], None
    model = effort = None
    if "--lane" in args:
        lane = args[args.index("--lane") + 1].upper()
        if lane not in LANE_NAMES:
            die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))
    if "--verify" in args:
        verify = args[args.index("--verify") + 1]
    if "--model" in args:
        model = args[args.index("--model") + 1]
    if "--effort" in args:
        effort = args[args.index("--effort") + 1]
    review = "--review" in args
    sha = args[args.index("--sha") + 1] if "--sha" in args else "HEAD"
    if "--files" in args:
        rest = args[args.index("--files") + 1:]
        for a in rest:
            if a.startswith("--"):
                break
            files.append(_rel(a))

    if t["status"] == "done":
        die("%s is already done — check the journal before re-ordering it" % tid)

    # Effort matters more than the model (AI-WORKFLOW.md §2a): reserve the expensive settings for
    # work that is expensive to get wrong, and let everything else run cheap. Tier already encodes
    # exactly that judgement, so derive from it rather than making the director remember.
    if not effort:
        effort = TIER_EFFORT.get(t.get("tier", "T1"), "medium")
        if t.get("milestone") in ("M1", "M4") and t.get("tier") == "T2":
            effort = "xhigh"      # netcode and world gen — the two rewrites we cannot afford

    spec = _spec_body(tid)
    from_spec = False
    if not files:
        files = [_rel(f) for f in _spec_claims(spec)]
        from_spec = bool(files)

    # A spec that claims project.godot only wants to register an autoload. Holding the file for the
    # whole task serialises every autoload-producing task against every other one (F-051), so drop it
    # from the claim set and let the lane use the locked `agent autoload` instead.
    autoload_only = "project.godot" in files
    if autoload_only:
        files = [f for f in files if f != "project.godot"]

    # Never hand out two orders that fight. This is the single most important safety property once
    # three lanes run at once: the claim system catches a collision, but only after a lane has
    # already spent quota getting to its first edit.
    conflicts = [(f, st["claims"][f]) for f in files if f in st["claims"]]
    for f, c in conflicts:
        print("%s✗ %s is claimed by %s for %s%s" % (C["r"], f, c["agent"], c["task"], C["x"]))
    if conflicts:
        die("that claim set overlaps live work — order a different task")
    st_now = load()
    for other, meta in _open_orders().items():
        if other == tid or meta["lane"] == lane:
            # Same lane means sequential execution (`agent saturate`), so an overlapping claim set is
            # not a conflict — it is just the same lane touching the same file twice, in order.
            # Only cross-lane overlap can put two agents in one file at once.
            continue
        if st_now["tasks"].get(other.replace("-review", ""), {}).get("status") == "done":
            continue
        overlap = set(files) & set(meta["files"])
        if overlap:
            die("claim set overlaps the open order for %s (%s) on: %s"
                % (other, meta["lane"], ", ".join(sorted(overlap))))

    guarded = [f for f in files if f.endswith(EDITOR_GUARDED_SUFFIXES)
               or os.path.basename(f) in EDITOR_GUARDED_PATHS]
    if guarded and _godot_running():
        die("this order touches Godot-authored files (%s) and Godot is open. Close the editor first "
            "(D-021, D-031)." % ", ".join(guarded))

    # The spec knows; the title heuristic only guesses.
    checks = _spec_verify(spec) or _suggest_check(tid, t["title"])
    missing = [c for c in checks if not os.path.exists(os.path.join(ROOT, c))]
    if not verify:
        verify = ("\n".join(".agent/bin/agent godot --script %s" % c for c in checks)
                  if checks else
                  ".agent/bin/agent godot --quit-after 120   # no focused check exists yet — "
                  "write one in tools/ as part of this task")

    claim = ".agent/bin/agent claim %s%s" % (tid, (" " + " ".join(files)) if files else
                                             " <the files you will edit>")
    if autoload_only:
        claim += ("\n\n# Your spec lists project.godot. Do NOT claim it — registering an autoload is\n"
                  "# one locked, atomic append, and holding the file would block every other lane\n"
                  "# that needs one (F-051). When your script exists, run instead:\n"
                  ".agent/bin/agent autoload <Name> res://<path to your script>.gd")
    lanes = _lane_state()
    account = lanes.get(lane, {}).get("account", "unassigned")

    if spec:
        spec_block = ("## 0. Your spec — this is the work, and it assumes docs/SPECS.md's preamble\n\n"
                      "%s\n\n> Read `docs/SPECS.md`'s *four standing rules* and *Seams that already\n"
                      "> exist* before your first edit. They have already cost real sessions.\n"
                      % "\n".join(spec))
    else:
        spec_block = ("## 0. No spec block exists for %s in docs/SPECS.md\n\n"
                      "Write one as part of this task — SPECS.md says fixing a missing spec belongs to\n"
                      "the task that discovers it. Read its preamble and follow the shape of a\n"
                      "neighbouring block.\n" % tid)

    os.makedirs(ORDERS, exist_ok=True)
    if review:
        # A reviewer claims nothing: it reads a commit and writes findings. Claiming source would
        # block the lane that has to act on the review.
        body = REVIEW_TEMPLATE % {
            "lane": lane, "account": account, "agent": lane.lower(), "tid": tid, "sha": sha,
            "model": model or lanes.get(lane, {}).get("model", "default"), "effort": effort,
            "verify": verify, "brief": _plain(cmd_brief, [tid]).strip(),
        }
        path = os.path.join(ORDERS, "%s-review.md" % tid.replace("/", "_"))
        with open(path, "w") as f:
            f.write(body)
        ok("review order written for %s → %s  (%s, effort %s)"
           % (tid, lane, model or lanes.get(lane, {}).get("model", "lane default"), effort))
        print("  %s%s · reviewing %s%s" % (C["dim"], os.path.relpath(path, ROOT), sha, C["x"]))
        print("\n  next:  %sagent dispatch %s %s-review%s" % (C["c"], lane, tid, C["x"]))
        return

    body = ORDER_TEMPLATE % {
        "lane": lane, "account": account, "agent": lane.lower(), "tid": tid,
        "files": " ".join(files), "claim": claim, "verify": verify, "spec": spec_block,
        "model": model or lanes.get(lane, {}).get("model", "default"), "effort": effort,
        "brief": _plain(cmd_brief, [tid]).strip(),
    }
    path = _order_path(tid)
    with open(path, "w") as f:
        f.write(body)

    ok("order written for %s → %s  (%s, effort %s)"
       % (tid, lane, model or lanes.get(lane, {}).get("model", "lane default"), effort))
    print("  %s%s%s" % (C["dim"], t["title"][:88], C["x"]))
    print("  %s%s · %d bytes%s" % (C["dim"], os.path.relpath(path, ROOT), len(body), C["x"]))
    if files:
        if from_spec:
            print("  %sclaim set taken from docs/SPECS.md%s" % (C["dim"], C["x"]))
        for f in files:
            print("  %s· %s%s" % (C["dim"], f, C["x"]))
    else:
        print("  %s⚠ no claim set: SPECS.md declares none and none was given, so the lane claims as "
              "it goes and collisions surface mid-dispatch rather than now%s" % (C["y"], C["x"]))
    for c in checks:
        note = " %s(this task writes it)%s" % (C["y"], C["x"]) if c in missing else ""
        print("  %sverify: %s%s%s" % (C["dim"], c, C["x"], note))
    if lane != "?":
        print("\n  next:  %sagent dispatch %s%s" % (C["c"], lane, C["x"]))


def cmd_dispatch(args):
    """Hand a lane its order and run it headlessly."""
    if not args:
        die("usage: agent dispatch <LANE> [task-id] [--dry-run]")
    lane = args[0].upper()
    if lane not in LANE_NAMES:
        die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))

    tid = None
    for a in args[1:]:
        if not a.startswith("--"):
            tid = a
            break
    if not tid:
        waiting = [k for k, v in _open_orders().items() if v["lane"] == lane]
        if not waiting:
            die("no open order for %s — run:  agent order <task-id> --lane %s" % (lane, lane))
        tid = waiting[0]

    if not os.path.exists(_order_path(tid)):
        die("no work order for %s — run:  agent order %s --lane %s" % (tid, tid, lane))

    argv = [LANE_BIN, "run", lane, tid] + [a for a in args[1:] if a.startswith("--")]
    return subprocess.call(argv, cwd=ROOT)


def cmd_saturate(args):
    """Run a lane's queued orders back to back until they run out or it hits a wall.

    The point is idle time, not throughput. A subscription window's unused tokens are gone at reset,
    so a lane sitting idle for two hours because nobody was watching has burned two hours of quota
    that cannot be recovered. This keeps the queue feeding it without a human in the loop.

    It stops on a hard wall (the lane parks itself and the remaining orders stay queued for the next
    window) and on a task that fails for any other reason, because chaining more work onto a broken
    lane just multiplies the mess."""
    if not args:
        die("usage: agent saturate <LANE> [task-id ...]\n"
            "  with no ids, runs every open order assigned to that lane")
    lane = args[0].upper()
    if lane not in LANE_NAMES:
        die("unknown lane '%s' — known: %s" % (lane, ", ".join(LANE_NAMES)))

    watch = "--watch" in args
    wanted = [a for a in args[1:] if not a.startswith("--")]
    orders = _open_orders()
    if not wanted:
        wanted = [t for t, m in sorted(orders.items()) if m["lane"] == lane]
    if not wanted:
        die("no open orders for %s — write some with:  agent order <id> --lane %s" % (lane, lane))

    print("%s%s queue: %s%s" % (C["b"], lane, " → ".join(wanted), C["x"]))
    done_ok, stopped = [], None
    for tid in wanted:
        st = load()
        if st["tasks"].get(tid, {}).get("status") == "done":
            print("  %s· %s already done, skipping%s" % (C["dim"], tid, C["x"]))
            continue
        if not os.path.exists(_order_path(tid)):
            print("  %s· no order for %s, skipping%s" % (C["dim"], tid, C["x"]))
            continue
        code = _run_with_resume(lane, tid, watch)
        if code == 0:
            done_ok.append(tid)
            continue
        stopped = tid
        break

    print()
    if done_ok:
        ok("%s completed: %s" % (lane, ", ".join(done_ok)))
    if stopped:
        print("%s· stopped at %s — the rest stay queued for the next window%s"
              % (C["y"], stopped, C["x"]))
        print("  %sagent collect%s to see why, then %sagent saturate %s%s to resume"
              % (C["c"], C["x"], C["c"], lane, C["x"]))
    elif not done_ok:
        print("  %snothing ran%s" % (C["dim"], C["x"]))
    return 0


MAX_RESUMES = 4
MAX_WAIT_HOURS = 8


def _run_with_resume(lane, tid, watch):
    """Run one task, and with --watch, sleep out a short quota wall and pick it straight back up.

    The two windows do different jobs. The 5-hour session is the rate limiter — it fills fast and is
    what actually stops a lane. The weekly is the real budget, and it is the one that expires unspent.
    So sleeping through a 5-hour park is not patience, it is throwing away a window's worth of the
    weekly budget that cannot be recovered: to spend the weekly you have to be working during each
    session window.

    Only quota parks are resumed. A task that failed for any other reason is left alone, because
    retrying a broken task on a loop just burns the window it was waiting for."""
    for attempt in range(MAX_RESUMES + 1):
        code = subprocess.call([LANE_BIN, "run", lane, tid], cwd=ROOT)
        if code == 0 or not watch or attempt == MAX_RESUMES:
            return code

        state = _lane_state().get(lane, {})
        if state.get("status") != "exhausted":
            return code                       # a real failure, not a wall
        until = state.get("exhausted_until")
        try:
            resets = datetime.fromisoformat(until)
        except (TypeError, ValueError):
            return code
        if resets.tzinfo is None:
            resets = resets.replace(tzinfo=timezone.utc)
        wait = (resets - datetime.now(timezone.utc)).total_seconds()
        if wait <= 0 or wait > MAX_WAIT_HOURS * 3600:
            return code                       # already past, or too far out to sit on

        print("%s· %s parked until %s — sleeping %.1fh, then resuming %s%s"
              % (C["y"], lane, until, wait / 3600.0, tid, C["x"]))
        time.sleep(wait + 60)                 # a minute past the reset, so it is definitely open
        subprocess.call([LANE_BIN, "reset", lane], cwd=ROOT)
    return 1


def cmd_lanes(args):
    """Lane health. --doctor also checks each account's CLI and login."""
    if "--doctor" in args:
        return subprocess.call([LANE_BIN, "doctor"], cwd=ROOT)
    return subprocess.call([LANE_BIN, "status"], cwd=ROOT)


def _godot_running():
    """True only if the Godot *editor* is open.

    The protocol's `pgrep -fl Godot` is too blunt for a machine running three lanes: on this repo it
    matches nine processes when one real engine is running, because every shell whose command line
    mentions Godot counts — including the loop that runs the headless checks. Worse, it cannot tell
    the editor from a headless run, and only the editor matters: the editor rewrites .tscn/.tres on
    save and will silently discard an agent's edit. A `--headless --script` check never does.

    So: match the actual binary, then exclude headless invocations. See F-045."""
    try:
        out = subprocess.run(["ps", "-Ao", "pid,command"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    for line in out.splitlines():
        if "Godot.app/Contents/MacOS/Godot" not in line and "/godot" not in line:
            continue
        if "grep" in line or "ps -Ao" in line:
            continue
        if "--headless" in line:
            continue          # a check run, not the editor — harmless
        return True
    return False


GODOT_CANDIDATES = (
    "/Applications/Godot.app/Contents/MacOS/Godot",
    "/usr/local/bin/godot",
    "/opt/homebrew/bin/godot",
)


def cmd_godot(args):
    """Run Godot headless under a lock, so concurrent lanes cannot corrupt one import cache.

    Every headless verification in this project should go through here rather than calling Godot
    directly — see F-044. Usage mirrors the engine's: `agent godot --script tools/x_check.gd`."""
    binary = os.environ.get("GODOT_BIN") or next(
        (p for p in GODOT_CANDIDATES if os.path.exists(p)), None)
    if not binary:
        die("no Godot binary found. Set GODOT_BIN, or install Godot.app.")
    argv = [binary, "--headless", "--path", ROOT] + list(args)
    with file_lock("godot", timeout=1800):
        print("%s· %s%s" % (C["dim"], " ".join(argv[3:]), C["x"]))
        return subprocess.call(argv, cwd=ROOT)


def cmd_autoload(args):
    """Register one autoload in project.godot, atomically, without claiming the file for a whole task.

    D-021 is right that a task shipping an autoload must register it — a script nothing loads is not
    shipped. But holding `project.godot` for the task's whole duration serialises every autoload-
    producing task against every other one, and five upcoming specs (2.11, 2.12, 2.13, 3.3, 3.6) each
    claim it. That would collapse three lanes back to one for most of M2 and M3 (F-051).

    A registration is one appended line. So take a short lock, verify the editor is closed, append,
    release — seconds instead of an hour, and the claim is never needed. Idempotent, and append-only
    per D-019: existing lines are never reordered or rewritten."""
    if len(args) < 2:
        die('usage: agent autoload <Name> <res://path/to/script.gd>\n'
            '  e.g. agent autoload DayNight res://systems/environment/day_night.gd')
    name, path = args[0], args[1]
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
        die("'%s' is not a valid autoload name — PascalCase identifier, no spaces" % name)
    if not path.startswith("res://"):
        path = "res://" + path.lstrip("/")
    target = os.path.join(ROOT, path[len("res://"):])
    if not os.path.exists(target):
        die("%s does not exist — write the script before registering it" % path)

    with file_lock("project", timeout=300):
        if _godot_running():
            die("the Godot editor is open. It rewrites project.godot on save and will silently "
                "discard this edit (D-021). Close it and re-run.")
        with open(PROJECT_GODOT) as f:
            lines = f.read().splitlines()

        entry = '%s="*%s"' % (name, path)
        for line in lines:
            stripped = line.strip()
            if stripped == entry:
                ok("%s is already registered" % name)
                return 0
            if stripped.startswith("%s=" % name):
                die("%s is already registered as a different path:\n  %s\n"
                    "Append-only (D-019) — resolve this by hand." % (name, stripped))

        # Append at the END of [autoload]. Order is load order, and a new autoload must not be
        # inserted ahead of one that already exists and might be its dependency.
        try:
            start = next(i for i, l in enumerate(lines) if l.strip() == "[autoload]")
        except StopIteration:
            lines += ["", "[autoload]", "", entry]
        else:
            end = len(lines)
            for i in range(start + 1, len(lines)):
                if lines[i].strip().startswith("[") and lines[i].strip().endswith("]"):
                    end = i
                    break
            while end > start + 1 and not lines[end - 1].strip():
                end -= 1
            lines.insert(end, entry)

        tmp = PROJECT_GODOT + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, PROJECT_GODOT)

    ok("registered %s" % entry)
    print("  %sverify it loads:  agent godot --quit-after 5%s" % (C["dim"], C["x"]))
    return 0


def cmd_reap(args):
    """Release claims held by a lane whose process is gone.

    A lane killed hard — closed laptop, OOM, a hung CLI — leaves its claims behind, and every other
    lane that needs those files is blocked behind a corpse. `lane run` files a handoff on any exit
    it survives to see; this is the backstop for the exits it doesn't."""
    st = load()
    lanes = _lane_state()
    alive = {}
    for name, lane in lanes.items():
        pid = lane.get("pid")
        if pid:
            try:
                os.kill(pid, 0)
                alive[name.lower()] = pid
            except (OSError, TypeError):
                pass

    freed, tasks = [], set()
    for path, claim in list(st["claims"].items()):
        holder = claim["agent"]
        if holder in (n.lower() for n in LANE_NAMES) and holder not in alive:
            del st["claims"][path]
            freed.append((path, holder, claim["task"]))
            tasks.add(claim["task"])

    for tid in list(st["in_flight"]):
        entry = st["in_flight"][tid]
        if entry["agent"] in (n.lower() for n in LANE_NAMES) and entry["agent"] not in alive:
            del st["in_flight"][tid]
            if st["tasks"].get(tid, {}).get("status") == "in_flight":
                st["tasks"][tid]["status"] = "todo"
            tasks.add(tid)

    if not freed and not tasks:
        ok("nothing to reap — no lane is holding claims it shouldn't")
        if alive:
            print("  %slive: %s%s" % (C["dim"], ", ".join(sorted(alive)), C["x"]))
        return
    save(st)
    ok("reaped %d claim(s) across %d task(s)" % (len(freed), len(tasks)))
    for path, holder, tid in freed:
        print("  %s· %s (was %s, %s)%s" % (C["dim"], path, holder, tid, C["x"]))
    print("  %sthose tasks are back on the board — re-order them when a lane frees up%s"
          % (C["dim"], C["x"]))


def _git_since(hours):
    try:
        out = subprocess.run(
            ["git", "log", "--since=%d hours ago" % hours, "--pretty=%h\t%an\t%s"],
            cwd=ROOT, capture_output=True, text=True, timeout=20).stdout
        return [l.split("\t", 2) for l in out.strip().splitlines() if l]
    except (OSError, subprocess.SubprocessError):
        return []


def cmd_collect(args):
    """What came back from the lanes: what shipped, what stopped, what needs the director."""
    hours = int(args[args.index("--hours") + 1]) if "--hours" in args else 24
    st = load()
    lanes = _lane_state()
    lane_agents = {n.lower() for n in LANE_NAMES}

    print("\n%sCollected — last %dh%s" % (C["b"], hours, C["x"]))

    entries = [e for e in _journal_entries() if age_hours(e.get("at", "")) < hours]
    shipped = [e for e in entries if e["kind"] == "done"]
    stopped = [e for e in entries if e["kind"] == "handoff"]

    if shipped:
        print("\n%sFinished%s" % (C["g"], C["x"]))
        for e in shipped:
            who = e["agent"]
            tag = " %s(lane)%s" % (C["c"], C["x"]) if who in lane_agents else ""
            print("  %s✓%s %-7s %s%s" % (C["g"], C["x"], e["task"], who, tag))
            for line in e["body"][1:3]:
                if line.strip():
                    print("      %s%s%s" % (C["dim"], line.strip()[:96], C["x"]))

    if stopped:
        print("\n%sStopped mid-task — needs a decision%s" % (C["y"], C["x"]))
        for e in stopped:
            print("  %s◐%s %-7s %s" % (C["y"], C["x"], e["task"], e["agent"]))
            for line in e["body"][1:4]:
                if line.strip():
                    print("      %s%s%s" % (C["dim"], line.strip()[:96], C["x"]))

    broken = [(n, l) for n, l in lanes.items() if l.get("status") in ("error", "exhausted")]
    if broken:
        print("\n%sLanes needing attention%s" % (C["r"], C["x"]))
        for name, lane in sorted(broken):
            why = ("quota, resets %s" % lane.get("exhausted_until")
                   if lane["status"] == "exhausted" else "error")
            print("  %s%s%s %s — %s" % (C["r"], name, C["x"], lane["account"], why))
            if lane.get("last_error"):
                first = lane["last_error"].strip().splitlines()[-1][:96]
                print("      %s%s%s" % (C["dim"], first, C["x"]))

    commits = _git_since(hours)
    if commits:
        print("\n%sCommits%s" % (C["b"], C["x"]))
        for sha, who, subject in commits[:12]:
            print("  %s%s%s %-9s %s" % (C["dim"], sha, C["x"], who[:9], subject[:74]))

    if not (shipped or stopped or broken or commits):
        print("  %snothing came back in the last %dh%s" % (C["dim"], hours, C["x"]))
    print()


def cmd_report(args):
    """One screen: who is doing what, what it cost, what's waiting, what's stuck.

    This is the director's answer to 'keep me informed' — Sequoyah reads this instead of watching
    three terminals."""
    st = load()
    lanes = _lane_state()
    orders = _open_orders()

    total_in = sum(l.get("tokens_in", 0) for l in lanes.values())
    total_out = sum(l.get("tokens_out", 0) for l in lanes.values())
    total_cost = sum(l.get("cost_usd", 0.0) for l in lanes.values())
    # Findings are deliberately outside the milestone count, so filing one never moves the roadmap
    # number (AGENTS.md). Count the same way the board does or the two disagree on screen.
    roadmap = {k: v for k, v in st["tasks"].items() if not _is_finding(k)}
    done = sum(1 for t in roadmap.values() if t["status"] == "done")
    open_findings = sum(1 for k, v in st["tasks"].items()
                        if _is_finding(k) and v["status"] != "done")

    print("\n%sMIRE — orchestration report%s   %s%s%s"
          % (C["b"], C["x"], C["dim"], now()[:16].replace("T", " "), C["x"]))
    print("%s%d/%d tasks done · %d open findings · %s tokens this window · ~$%.2f api-equiv%s"
          % (C["dim"], done, len(roadmap), open_findings,
             f"{total_in + total_out:,}", total_cost, C["x"]))
    print("%ssubscription lanes — nothing is billed; api-equiv is a proxy for window consumed%s"
          % (C["dim"], C["x"]))

    print("\n%sLanes%s" % (C["b"], C["x"]))
    print("  %s%-5s %-18s %-9s %11s %9s %s%s"
          % (C["dim"], "lane", "account", "status", "tokens", "api-equiv", "runs/fail", C["x"]))
    for name in LANE_NAMES:
        lane = lanes.get(name)
        if not lane:
            print("  %-5s %s(not configured — run .agent/bin/setup-lanes)%s"
                  % (name, C["dim"], C["x"]))
            continue
        used = lane.get("tokens_in", 0) + lane.get("tokens_out", 0)
        colour = {"idle": C["g"], "running": C["c"],
                  "exhausted": C["y"], "error": C["r"]}.get(lane["status"], "")
        print("  %s%-5s%s %-18s %s%-9s%s %11s %9s %d/%d"
              % (C["b"], name, C["x"], lane["account"][:18], colour, lane["status"], C["x"],
                 f"{used:,}", "$%.2f" % lane.get("cost_usd", 0.0),
                 lane.get("runs", 0), lane.get("failures", 0)))
        if lane.get("task"):
            print("        %s▶ %s since %s%s"
                  % (C["c"], lane["task"], (lane.get("started") or "")[11:16], C["x"]))
        if lane.get("exhausted_until"):
            print("        %s◐ parked until %s%s" % (C["y"], lane["exhausted_until"], C["x"]))
        budget = lane.get("budget_tokens")
        if budget:
            print("        %s%d%% of window budget%s" % (C["dim"], 100 * used // budget, C["x"]))

    if st["in_flight"]:
        print("\n%sIn flight%s" % (C["b"], C["x"]))
        for tid, e in sorted(st["in_flight"].items()):
            hrs = age_hours(e["started"])
            warn = " %s(stale)%s" % (C["y"], C["x"]) if hrs > STALE_HOURS else ""
            print("  %-7s %-9s %.1fh%s  %s%s%s"
                  % (tid, e["agent"], hrs, warn, C["dim"],
                     st["tasks"].get(tid, {}).get("title", "")[:56], C["x"]))

    queued = {k: v for k, v in orders.items()
              if st["tasks"].get(k, {}).get("status") != "done" and k not in st["in_flight"]}
    if queued:
        print("\n%sOrders waiting%s" % (C["b"], C["x"]))
        for tid, meta in sorted(queued.items()):
            print("  %-7s → %-4s %s%s%s"
                  % (tid, meta["lane"], C["dim"],
                     st["tasks"].get(tid, {}).get("title", "")[:60], C["x"]))

    blocked = []
    for name in LANE_NAMES:
        lane = lanes.get(name)
        if lane and lane.get("status") in ("exhausted", "error"):
            blocked.append(name)
        elif lane and lane.get("consecutive_failures", 0) >= 3:
            blocked.append(name)
    print("\n%s%s%s" % (
        C["y"] if blocked else C["g"],
        ("⚠ %s unavailable — route around %s" % (", ".join(blocked),
                                                 "them" if len(blocked) > 1 else "it"))
        if blocked else "✓ all lanes available",
        C["x"]))
    print()


# ---------------------------------------------------------------- main

COMMANDS = {
    "start": cmd_start, "brief": cmd_brief, "claim": cmd_claim, "note": cmd_note,
    "done": cmd_done, "handoff": cmd_handoff, "drop": cmd_drop, "check": cmd_check,
    "board": cmd_board, "sync": cmd_sync,
    # Three lanes running `ship` at once means three processes in one git index. Serialising it
    # costs nothing and removes a whole class of confusing failures.
    "ship": with_lock("git", cmd_ship),
    # Orchestration (D-036)
    "order": cmd_order, "dispatch": cmd_dispatch, "lanes": cmd_lanes,
    "collect": cmd_collect, "report": cmd_report, "reap": cmd_reap, "godot": cmd_godot,
    "saturate": cmd_saturate,
    "autoload": cmd_autoload,
}

USAGE = """agent — multi-agent coordination for MIRE

  agent start                     begin a session (named from this chat automatically)
  agent brief <id>                everything you need to start that task
  agent board                     show what's happening
  agent claim <id> [files...]     claim a task and the files you'll edit
  agent note <id> "..."           record something mid-task
  agent done <id> ["summary"]     finish: release claims, write journal
  agent ship <id> ["message"]     commit THIS TASK's files + push, print the sign-off
  agent handoff <id> "..."        stop mid-task: what's left, what to watch out for
  agent drop <id>                 abandon a task, release claims
  agent check                     verify changes respect claims (pre-commit hook)
  agent sync                      re-read tasks from docs/ROADMAP.md

Verifying — always launch the engine through this, never bare (F-044):

  agent godot --script tools/x_check.gd     headless Godot, under a lock
  agent autoload <Name> <res://path.gd>     register an autoload atomically — no claim needed

Directing three worker accounts (docs/ORCHESTRATION.md):

  agent order <id> --lane LC1 --files ...   write a self-contained work order
  agent order <id> --lane LC1 --review     review order: judge a commit, file findings, no edits
  agent dispatch <LANE> [id] [--dry-run]    run that order on its account, headless
  agent saturate <LANE> [ids...] [--watch] run its queued orders back to back — no idle window
                                           --watch also sleeps out a short quota wall and resumes
  agent lanes [--doctor]                    lane health; --doctor checks CLI + login
  agent report                              who's doing what, what it cost, what's stuck
  agent collect [--hours N]                 what shipped, what stopped, what needs you
  agent reap                                free claims from lanes whose process died

Protocol: AGENTS.md    Board: .agent/BOARD.md    History: .agent/JOURNAL.md"""


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die("unknown command '%s'\n\n%s" % (cmd, USAGE))
    # Propagate the command's exit code. `agent godot` wraps a check whose failure MUST be visible to
    # whoever ran it — a lane that reads exit 0 from a failing check will ship a broken change and
    # report it verified. Commands that return None (all the original ones) still exit 0.
    sys.exit(COMMANDS[cmd](sys.argv[2:]) or 0)


if __name__ == "__main__":
    main()
