#!/usr/bin/env python3
"""Wake a parked lane's queue when its window is due back, without a human in the loop.

A lane parked past `agent saturate --watch`'s 8-hour sleep ceiling stops cleanly and leaves its
orders queued — correct, but nothing then restarts it, so a returned weekly window is spent idle
until somebody notices. That is the one kind of waste this project cannot recover: unused
subscription quota is gone at reset.

Double-fork + setsid, the same way `agent saturate --detach` survives its session. macOS has no
setsid(1), so this cannot be a shell one-liner.

    .agent/bin/lane-revive LC1 2026-08-18T07:05:00+00:00
"""
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
AGENT = os.path.join(ROOT, ".agent", "bin", "agent")
LANE = os.path.join(ROOT, ".agent", "bin", "lane")


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: lane-revive <LANE> <iso-utc-when>")
    lane = sys.argv[1].upper()
    when = datetime.fromisoformat(sys.argv[2])
    if when.tzinfo is None:
        when = when.replace(tzinfo=timezone.utc)

    log = os.path.join(ROOT, ".agent", "logs", "revive-%s.log" % lane.lower())
    os.makedirs(os.path.dirname(log), exist_ok=True)

    if os.fork() > 0:
        print("· %s will be revived at %s — tail -f %s"
              % (lane, when.isoformat(), os.path.relpath(log, ROOT)))
        sys.stdout.flush()          # os._exit skips the flush, and a pipe is block-buffered
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND)
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)

    while datetime.now(timezone.utc) < when:
        time.sleep(300)

    stamp = datetime.now(timezone.utc).isoformat()
    print("[%s] window due back — clearing the park and restarting the queue" % stamp, flush=True)
    subprocess.call([LANE, "reset", lane], cwd=ROOT)
    # If the window has NOT actually returned, the first dispatch is refused cheaply and the lane
    # re-parks itself with a real reset time — a probe, not a gamble.
    subprocess.call([AGENT, "saturate", lane, "--watch", "--detach"], cwd=ROOT)


if __name__ == "__main__":
    main()
