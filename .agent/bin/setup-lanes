#!/usr/bin/env python3
"""
setup-lanes — prepare an isolated auth home per worker account, then tell Sequoyah how to log in.

Run once per machine. It creates the directories and per-lane config, verifies the CLIs are present,
and prints the login commands. It deliberately stops there: **an agent must never handle account
credentials**, so the three `login` commands are yours to run, in your own terminal, with your own
hands. Everything else here is automatic and safe to re-run.

Both CLIs already ship inside the desktop apps you have installed, so there is nothing to npm
install unless you want independently-upgradable copies on PATH.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# `lane` has no .py extension, so import it the long way rather than duplicating its registry here.
import importlib.util

_spec = importlib.util.spec_from_loader(
    "lane", importlib.machinery.SourceFileLoader(
        "lane", os.path.join(os.path.dirname(os.path.abspath(__file__)), "lane")))
lanemod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(lanemod)

C = lanemod.C

# Written into each Codex lane home so the account's defaults are inspectable in a file rather than
# buried in argv. `lane run` still passes the flags that must not drift.
CODEX_CONFIG = """# MIRE lane config — generated by .agent/bin/setup-lanes
# This account is one lane of MIRE's orchestration harness. See docs/ORCHESTRATION.md.
model = "%(model)s"
model_reasoning_effort = "%(effort)s"
sandbox_mode = "%(sandbox)s"

# No desktop notifications from a headless lane — the director reads exit codes, not toasts.
"""


def main():
    print("%sMIRE lane setup%s\n" % (C["b"], C["x"]))
    lanes = lanemod.load_lanes()
    logins = []

    for name in sorted(lanes):
        lane = lanes[name]
        home = lanemod.lane_home(lane)
        binary = lanemod.lane_binary(lane)
        os.makedirs(home, mode=0o700, exist_ok=True)

        print("%s%-4s%s %s" % (C["b"], name, C["x"], lane["account"]))
        print("  %shome  %s %s" % (C["dim"], C["x"], home))

        if not binary:
            print("  %s✗ %s CLI not found%s" % (C["r"], lane["cli"], C["x"]))
            if lane["cli"] == "codex":
                print("    install:  npm i -g @openai/codex   (or install ChatGPT.app)")
            else:
                print("    install:  npm i -g @anthropic-ai/claude-code   (or install Claude.app)")
            print()
            continue
        print("  %sbin   %s %s" % (C["dim"], C["x"], binary))

        if lane["cli"] == "codex":
            cfg = os.path.join(home, "config.toml")
            if not os.path.exists(cfg):
                with open(cfg, "w") as f:
                    f.write(CODEX_CONFIG % {
                        "model": lane["model"], "effort": lane.get("effort", "medium"),
                        "sandbox": lane.get("sandbox", "danger-full-access")})
                print("  %s✓%s wrote config.toml" % (C["g"], C["x"]))
            logins.append((name, lane["account"], ".agent/bin/lane login %s" % name))
        else:
            logins.append((name, lane["account"], ".agent/bin/lane login %s" % name))

        if lanemod.is_logged_in(lane):
            print("  %s✓ already logged in%s" % (C["g"], C["x"]))
        else:
            print("  %s· login still needed%s" % (C["y"], C["x"]))
        print()

    pending = [l for l in logins if not lanemod.is_logged_in(lanes[l[0]])]
    if not pending:
        print("%s✓ every lane is configured and logged in.%s" % (C["g"], C["x"]))
        print("  Next:  .agent/bin/agent lanes")
        return 0

    print("%sRun these yourself — one per account. I will not handle your credentials.%s"
          % (C["b"], C["x"]))
    print("%sSign each one into a DIFFERENT account, or two lanes will share one quota pool and the%s"
          % (C["dim"], C["x"]))
    print("%swhole point of the harness is lost. Codex uses device auth by default for exactly this%s"
          % (C["dim"], C["x"]))
    print("%sreason: your browser is already signed into one ChatGPT account, and the browser flow%s"
          % (C["dim"], C["x"]))
    print("%swould silently reuse it for both lanes.%s\n" % (C["dim"], C["x"]))
    for name, account, cmd in pending:
        print("  %s# %s → %s%s" % (C["dim"], name, account, C["x"]))
        print("  %s\n" % cmd)
    print("Then verify with:  %s.agent/bin/agent lanes --doctor%s" % (C["c"], C["x"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
